export SMTP_AUTHENTICATION=login
export SMTP_ENABLE_STARTTLS_AUTO=true
export SMTP_OPEN_TIMEOUT=5
export SMTP_READ_TIMEOUT=10

# Database
export DB_HOST=localhost
export DB_PORT=5432
export DB_USERNAME=postgres
export DB_PASSWORD=postgres
export DB_NAME=tradingsniperpanel_com_development
export DB_NAME_TEST=tradingsniperpanel_com_test
export DATABASE_URL=postgresql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME

# Rails
export RAILS_MASTER_KEY=changeme
export APP_HOST=localhost:3000
export APP_HOST_PROTOCOL=http
export PORT=3000
export BIND_HOST=127.0.0.1

# Admin bootstrap
export MASTER_ADMIN_EMAIL=master@example.com
export MASTER_ADMIN_PASSWORD=changeme
