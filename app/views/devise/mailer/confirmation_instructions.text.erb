<% @preheader_text = t("devise.mailer.confirmation_instructions.preheader", app_name: app_name) %>
<%= render "shared/mailer/message",
  formats: [:text],
  tone: :info,
  category: t("mailers.shared.categories.account_security"),
  title: t("devise.mailer.confirmation_instructions.title"),
  greeting: t("devise.mailer.confirmation_instructions.greeting", email: @email),
  intro: t("devise.mailer.confirmation_instructions.instructions"),
  primary_action: {
    label: t("devise.mailer.confirmation_instructions.cta"),
    url: confirmation_url(@resource, confirmation_token: @token)
  } %>
