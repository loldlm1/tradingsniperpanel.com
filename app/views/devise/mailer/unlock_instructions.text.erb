<% @preheader_text = t("devise.mailer.unlock_instructions.preheader", app_name: app_name) %>
<%= render "shared/mailer/message",
  formats: [:text],
  tone: :warning,
  category: t("mailers.shared.categories.account_security"),
  title: t("devise.mailer.unlock_instructions.title"),
  greeting: t("devise.mailer.unlock_instructions.greeting", email: @resource.email),
  intro: t("devise.mailer.unlock_instructions.locked_notice"),
  paragraphs: [t("devise.mailer.unlock_instructions.instructions")],
  primary_action: {
    label: t("devise.mailer.unlock_instructions.cta"),
    url: unlock_url(@resource, unlock_token: @token)
  } %>
