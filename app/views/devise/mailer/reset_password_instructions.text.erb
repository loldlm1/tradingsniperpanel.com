<% @preheader_text = t("devise.mailer.reset_password_instructions.preheader", app_name: app_name) %>
<%= render "shared/mailer/message",
  formats: [:text],
  tone: :info,
  category: t("mailers.shared.categories.account_security"),
  title: t("devise.mailer.reset_password_instructions.title"),
  greeting: t("devise.mailer.reset_password_instructions.greeting", email: @resource.email),
  intro: t("devise.mailer.reset_password_instructions.instructions"),
  paragraphs: [
    t("devise.mailer.reset_password_instructions.ignore_notice"),
    t("devise.mailer.reset_password_instructions.change_notice")
  ],
  primary_action: {
    label: t("devise.mailer.reset_password_instructions.cta"),
    url: edit_password_url(@resource, reset_password_token: @token)
  } %>
