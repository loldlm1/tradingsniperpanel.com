<% @preheader_text = t("devise.mailer.email_changed.preheader", app_name: app_name) %>
<%= render "shared/mailer/message",
  formats: [:text],
  tone: :info,
  category: t("mailers.shared.categories.account_security"),
  title: t("devise.mailer.email_changed.title"),
  greeting: t("devise.mailer.email_changed.greeting", email: @email),
  intro: @resource.try(:unconfirmed_email?) ? t("devise.mailer.email_changed.unconfirmed_notice", email: @resource.unconfirmed_email) : t("devise.mailer.email_changed.confirmed_notice", email: @resource.email) %>
