<% resource_label = resource_class.model_name.human %>
<h2><%= t("devise.registrations.edit.title", resource: resource_label) %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div><%= t("devise.registrations.edit.pending_reconfirmation", email: resource.unconfirmed_email) %></div>
  <% end %>

  <div class="field">
    <%= f.label :password %> <i>(<%= t("devise.registrations.edit.password_hint") %>)</i><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
    <% if @minimum_password_length %>
      <br />
      <em><%= t("devise.password_minimum_hint", count: @minimum_password_length) %></em>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :current_password %> <i>(<%= t("devise.registrations.edit.current_password_hint") %>)</i><br />
    <%= f.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div class="actions">
    <%= f.submit t("devise.registrations.edit.update_cta") %>
  </div>
<% end %>

<h3><%= t("devise.registrations.edit.cancel_title") %></h3>

<div>
  <%= t("devise.registrations.edit.cancel_prompt") %>
  <%= button_to t("devise.registrations.edit.cancel_cta"),
                registration_path(resource_name),
                method: :delete,
                data: { turbo_confirm: t("devise.registrations.edit.cancel_confirm") } %>
</div>

<%= link_to t("devise.registrations.edit.back"), (request.referer || root_path) %>
