<% content_for :title, "#{t('devise.update_password_title')} | #{app_name}" %>
<% content_for :full_bleed, true %>

<main class="bg-white dark:bg-gray-900">
  <div class="relative flex">
    <div class="w-full md:w-1/2">
      <div class="min-h-[100dvh] h-full flex flex-col after:flex-1">
        <div class="flex-1">
          <div class="flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
            <%= link_to root_path, class: "block", "aria-label": app_name do %>
              <%= render "shared/marketing_logo", logo_class: "w-8 h-8 object-contain", logo_width: 32, logo_height: 32 %>
            <% end %>
          </div>
        </div>

        <div class="max-w-sm mx-auto w-full px-4 py-8">
          <h1 class="text-3xl text-gray-800 dark:text-gray-100 font-bold mb-2"><%= t("devise.update_password_title") %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-6"><%= t("devise.update_password_copy") %></p>

          <%= render "devise/shared/flash" %>

          <%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>
            <%= f.hidden_field :reset_password_token %>

            <div class="space-y-4">
              <div>
                <%= f.label :password, t("devise.new_password_label"), class: "block text-sm font-medium mb-1" %>
                <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-input w-full" %>
                <% if @minimum_password_length %>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t("devise.password_minimum_hint", count: @minimum_password_length) %></p>
                <% end %>
              </div>
              <div>
                <%= f.label :password_confirmation, t("devise.confirm_password_label"), class: "block text-sm font-medium mb-1" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input w-full" %>
              </div>
            </div>

            <div class="flex justify-end mt-6">
              <%= f.submit t("devise.change_password_cta"), class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white whitespace-nowrap" %>
            </div>
          <% end %>

          <div class="pt-5 mt-6 border-t border-gray-100 dark:border-gray-700/60">
            <div class="text-sm">
              <%= t("devise.have_account") %>
              <%= link_to t("nav.sign_in"), new_session_path(resource_name), class: "font-medium text-violet-500 hover:text-violet-600 dark:hover:text-violet-400" %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hidden md:block absolute top-0 bottom-0 right-0 md:w-1/2" aria-hidden="true">
      <%= image_tag "mosaic/images/auth-image.jpg", class: "object-cover object-center w-full h-full", width: 760, height: 1024, alt: t("devise.auth_image_alt") %>
    </div>
  </div>
</main>
