<% content_for :title, app_name %>
<% content_for :meta_description, t("landing.neon.hero.subtitle") %>

<!-- Hero -->
<section class="relative overflow-hidden">
  <div class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-gray-800 to-gray-900 opacity-60 h-[10rem] pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="absolute left-1/2 -translate-x-1/2 pointer-events-none -z-10" aria-hidden="true">
    <%= image_tag "neon/images/hero-illustration-x1316.svg", class: "max-w-none", width: 2143, height: 737, alt: t("landing.neon.media.hero_illustration_alt") %>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="pt-32 pb-12 md:pt-40 md:pb-20">
      <div class="max-w-xl mx-auto md:max-w-[640px] md:mx-0 text-center md:text-left">
        <h1 class="h1 font-uncut-sans mb-6" data-aos="zoom-out" data-aos-delay="100">
          <%= t("landing.neon.hero.title") %>
          <em class="font-italic"><%= t("landing.neon.hero.title_emphasis") %></em>
        </h1>
        <p class="text-xl text-gray-400 mb-10" data-aos="zoom-out" data-aos-delay="200"><%= t("landing.neon.hero.subtitle") %></p>
        <div class="max-w-xs mx-auto sm:max-w-none sm:flex sm:justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4" data-aos="zoom-out" data-aos-delay="300">
          <div>
            <%= link_to(user_signed_in? ? dashboard_path : new_user_registration_path, class: "btn text-white bg-linear-to-t from-blue-600 to-blue-400 hover:to-blue-500 w-full shadow-lg group") do %>
              <%= t("landing.neon.hero.cta") %>
              <span class="tracking-normal text-blue-200 group-hover:translate-x-0.5 transition-transform duration-150 ease-in-out ml-1">-&gt;</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Press logos -->
<section>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-6 border-b border-gray-800">
      <div class="max-w-sm md:max-w-5xl mx-auto grid gap-2 grid-cols-4 md:grid-cols-5">
        <% press_logos = [
          { src: "neon/images/binance_logo.svg", width: 124, height: 24, alt: t("landing.neon.press_logos.binance"), classes: "flex items-center justify-center py-2 col-span-2 md:col-auto", delay: 0 },
          { src: "neon/images/exness_logo.svg", width: 83, height: 30, alt: t("landing.neon.press_logos.exness"), classes: "flex items-center justify-center py-2 col-span-2 md:col-auto", delay: 100 },
          { src: "neon/images/mt5_logo.svg", width: 125, height: 39, alt: t("landing.neon.press_logos.mt5"), classes: "flex items-center justify-center py-2 col-span-2 md:col-auto", delay: 200 },
          { src: "neon/images/mtql5_logo.svg", width: 113, height: 30, alt: t("landing.neon.press_logos.mql5"), classes: "flex items-center justify-center py-2 col-span-2 md:col-auto", delay: 300 },
          { src: "neon/images/tradingview_logo.svg", width: 109, height: 33, alt: t("landing.neon.press_logos.tradingview"), classes: "flex items-center justify-center py-2 col-span-2 md:col-auto col-start-2", delay: 400 }
        ] %>
        <% press_logos.each do |logo| %>
          <div class="<%= logo[:classes] %>" data-aos="zoom-out" data-aos-delay="<%= logo[:delay] %>">
            <%= image_tag logo[:src], class: "max-w-full fill-gray-500", width: logo[:width], height: logo[:height], alt: logo[:alt] %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20">
      <div class="text-center pb-12 md:pb-20">
        <h2 class="h2 font-uncut-sans" data-aos="zoom-out"><%= t("landing.neon.features.title") %></h2>
      </div>

      <div class="pb-16" data-aos="zoom-out">
        <%= image_tag "neon/images/illustration_hero_style_premium.svg", width: 1104, height: 512, alt: t("landing.neon.media.features_image_alt") %>
      </div>

      <div class="max-w-sm mx-auto grid gap-8 md:grid-cols-3 lg:gap-16 items-start md:max-w-none">
        <div class="flex flex-col items-center" data-aos="zoom-out">
          <div class="mb-4">
            <svg width="56" height="56" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
              <defs>
                <radialGradient cx="50%" cy="89.845%" fx="50%" fy="89.845%" r="89.85%" id="icon1-b">
                  <stop stop-color="#3B82F6" stop-opacity=".64" offset="0%" />
                  <stop stop-color="#F472B6" stop-opacity=".876" offset="100%" />
                </radialGradient>
                <circle id="icon1-a" cx="28" cy="28" r="28" />
              </defs>
              <g fill="none" fill-rule="evenodd">
                <use fill="url(#icon1-b)" xlink:href="#icon1-a" />
                <g stroke="#FDF2F8" stroke-linecap="square" stroke-width="2">
                  <path d="M17 28h22" opacity=".64" />
                  <path d="M20 23v-3h3M33 20h3v3M36 33v3h-3M23 36h-3v-3" />
                </g>
              </g>
            </svg>
          </div>
          <h4 class="h4 text-gray-200 text-center mb-2"><%= t("landing.neon.features.items.execution.title") %></h4>
          <p class="text-lg text-gray-400 text-center"><%= t("landing.neon.features.items.execution.body") %></p>
        </div>

        <div class="flex flex-col items-center" data-aos="zoom-out" data-aos-delay="200">
          <div class="mb-4">
            <svg width="56" height="56" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
              <defs>
                <radialGradient cx="50%" cy="89.845%" fx="50%" fy="89.845%" r="89.85%" id="icon2-b">
                  <stop stop-color="#3B82F6" stop-opacity=".64" offset="0%" />
                  <stop stop-color="#F472B6" stop-opacity=".876" offset="100%" />
                </radialGradient>
                <circle id="icon2-a" cx="28" cy="28" r="28" />
              </defs>
              <g fill="none" fill-rule="evenodd">
                <use fill="url(#icon2-b)" xlink:href="#icon2-a" />
                <g stroke="#FDF2F8" stroke-linecap="square" stroke-width="2">
                  <path d="m22 24-4 4 4 4M34 24l4 4-4 4" />
                  <path d="m26 36 4-16" opacity=".64" />
                </g>
              </g>
            </svg>
          </div>
          <h4 class="h4 text-gray-200 text-center mb-2"><%= t("landing.neon.features.items.systems.title") %></h4>
          <p class="text-lg text-gray-400 text-center"><%= t("landing.neon.features.items.systems.body") %></p>
        </div>

        <div class="flex flex-col items-center" data-aos="zoom-out" data-aos-delay="400">
          <div class="mb-4">
            <svg width="56" height="56" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
              <defs>
                <radialGradient cx="50%" cy="89.845%" fx="50%" fy="89.845%" r="89.85%" id="icon3-b">
                  <stop stop-color="#3B82F6" stop-opacity=".64" offset="0%" />
                  <stop stop-color="#F472B6" stop-opacity=".876" offset="100%" />
                </radialGradient>
                <circle id="icon3-a" cx="28" cy="28" r="28" />
              </defs>
              <g fill="none" fill-rule="evenodd">
                <use fill="url(#icon3-b)" xlink:href="#icon3-a" />
                <g stroke="#FDF2F8" stroke-linecap="square" stroke-width="2">
                  <path d="m18 31 4 4 12-15" />
                  <path d="M39 25h-3M39 30h-7M39 35H28" opacity=".64" />
                </g>
              </g>
            </svg>
          </div>
          <h4 class="h4 text-gray-200 text-center mb-2"><%= t("landing.neon.features.items.indicators.title") %></h4>
          <p class="text-lg text-gray-400 text-center"><%= t("landing.neon.features.items.indicators.body") %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features #2 -->
<section class="relative">
  <div class="absolute top-0 left-0 right-0 bg-linear-to-b from-gray-800 to-gray-900 opacity-60 h-[10rem] pointer-events-none -z-10" aria-hidden="true"></div>

  <div class="absolute top-0 left-1/2 -z-10 ml-[390px]" aria-hidden="true">
    <%= image_tag "neon/images/features-illustration.svg", class: "max-w-none", width: 608, height: 305, alt: t("landing.neon.media.features_background_alt") %>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20">
      <div class="max-w-3xl mx-auto text-center pb-12 md:pb-20">
        <h2 class="h2 font-uncut-sans mb-4"><%= t("landing.neon.features2.title") %></h2>
        <div class="max-w-2xl mx-auto">
          <p class="text-xl text-gray-400"><%= t("landing.neon.features2.subtitle") %></p>
        </div>
      </div>

      <div class="max-w-xl mx-auto md:max-w-none flex flex-col md:flex-row md:items-center md:space-x-8 lg:space-x-16 xl:space-x-18 space-y-8 space-y-reverse md:space-y-0">
        <div class="md:w-7/12 lg:w-1/2 order-1 md:order-none" data-aos="zoom-out" data-aos-delay="200">
          <div class="text-center md:text-left">
            <h3 class="h3 font-uncut-sans text-4xl mb-4"><%= t("landing.neon.features2.content_title") %></h3>
            <p class="text-xl text-gray-400 mb-6"><%= t("landing.neon.features2.content_body") %></p>
            <ul class="inline-flex flex-col text-lg text-gray-400 space-y-3">
              <% t("landing.neon.features2.bullets").each do |bullet| %>
                <li class="flex items-center">
                  <svg class="w-3 h-3 fill-current text-emerald-500 mr-3 shrink-0" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                  </svg>
                  <span><%= bullet %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="md:w-5/12 lg:w-1/2" data-aos="zoom-out">
          <%= image_tag "neon/images/globo_tierra_trading.png", class: "mx-auto md:max-w-none", width: 540, height: 581, alt: t("landing.neon.media.features2_image_alt") %>
        </div>
      </div>
    </div>
  </div>
</section>

<% pricing = @landing_pricing || {} %>
<% tiers = pricing[:tiers] || [] %>
<% intervals = pricing[:intervals] || [] %>
<% interval_keys = intervals.map { |interval| interval[:key] } %>
<% requested_interval = [params[:price_key], params[:plan], params[:desired_plan]].compact.map(&:to_s).filter_map do |key|
                          interval_keys.sort_by { |interval| -interval.to_s.length }.find do |interval|
                            key == interval || key.end_with?("_#{interval}")
                          end
                        end.first %>
<% initial_period = requested_interval || interval_keys.first || "monthly" %>

<!-- Pricing -->
<section id="pricing" class="relative" x-data="{ period: '<%= initial_period %>' }">
  <div class="hidden lg:block absolute bottom-0 left-1/2 -translate-x-1/2 pointer-events-none -z-10" aria-hidden="true">
    <%= image_tag "neon/images/pricing-illustration.svg", class: "max-w-none", width: 618, height: 468, alt: t("landing.neon.media.pricing_illustration_alt") %>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20 border-t border-gray-800">
      <div class="max-w-3xl mx-auto text-center pb-12 md:pb-20">
        <h2 class="h2 font-uncut-sans mb-4"><%= t("landing.neon.pricing.title") %></h2>
        <div class="max-w-2xl mx-auto">
          <p class="text-xl text-gray-400"><%= t("landing.neon.pricing.subtitle") %></p>
        </div>

        <div class="mt-8 flex items-center justify-center">
          <div class="inline-flex bg-gray-800 rounded-full p-1 border border-gray-700">
            <% intervals.each do |interval| %>
              <button class="px-4 py-2 rounded-full text-sm font-medium transition flex items-center gap-2"
                      :class="period === '<%= interval[:key] %>' ? 'bg-gray-900 text-gray-100' : 'text-gray-400 hover:text-gray-100'"
                      @click="period = '<%= interval[:key] %>'">
                <span><%= interval[:label] %></span>
                <% if interval[:key] == "annual" && pricing[:discount_percent].present? %>
                  <span class="inline-flex items-center text-xs font-semibold py-0.5 px-2 text-emerald-600 bg-emerald-200 rounded-full"><%= t("dashboard.plans.toggle.save_up_to", percent: pricing[:discount_percent]) %></span>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      </div>

      <div class="max-w-sm mx-auto grid gap-8 lg:grid-cols-3 lg:gap-6 items-start lg:max-w-none pt-4">
        <% prices = pricing[:prices] || {} %>

        <% tiers.each_with_index do |tier, index| %>
          <% tier_key = tier[:key].to_s %>
          <% featured = tier[:featured] %>
          <% features = Array(tier[:features]) %>
          <% featured_class = featured ? "bg-gray-800" : "" %>
          <div class="relative flex flex-col h-full p-6 <%= featured_class %>" data-aos="zoom-out" <%= %(data-aos-delay="#{index * 100}") if index.positive? %>>
            <% if featured %>
              <div class="absolute top-0 right-0 mr-6 -mt-4">
                <div class="inline-flex items-center text-sm font-semibold py-1 px-3 text-emerald-600 bg-emerald-200 rounded-full">
                  <svg class="fill-emerald-500 mr-2" width="12" height="14" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5.315.068a.5.5 0 0 0-.745.347A7.31 7.31 0 0 1 3.182 3.6a7.924 7.924 0 0 1-.8.83A6.081 6.081 0 0 0 0 9.035a5.642 5.642 0 0 0 2.865 4.9.5.5 0 0 0 .746-.4 2.267 2.267 0 0 1 .912-1.67 4.067 4.067 0 0 0 1.316-1.4 4.662 4.662 0 0 1 1.819 3.1.5.5 0 0 0 .742.371c1.767-.999 2.86-2.87 2.865-4.9-.001-3.589-2.058-6.688-5.95-8.968Z" />
                  </svg>
                  <span><%= t("landing.neon.pricing.most_popular") %></span>
                </div>
              </div>
            <% end %>
            <div class="mb-6">
              <div class="text-lg font-semibold mb-1"><%= tier[:name] %></div>
              <div class="font-uncut-sans inline-flex items-baseline mb-2">
                <span class="text-3xl font-medium text-gray-400">$</span>
                <% intervals.each do |interval| %>
                  <% interval_key = interval[:key] %>
                  <% details = prices.dig(interval_key, tier_key) %>
                  <% display = if details.present?
                                 interval[:uses_effective_monthly] ? details[:effective_monthly_display] : details[:display]
                               end %>
                  <span class="text-4xl font-bold leading-7" x-show="period === '<%= interval_key %>'" x-cloak><%= display || t("dashboard.plans.placeholder") %></span>
                <% end %>
                <% intervals.each do |interval| %>
                  <span class="font-medium text-gray-400" x-show="period === '<%= interval[:key] %>'" x-cloak><%= interval[:per_label] %></span>
                <% end %>
              </div>
              <div class="text-gray-400 mb-6"><%= tier[:description] %></div>
              <% interval_paths = intervals.each_with_object({}) do |interval, memo| %>
                <% plan_key = prices.dig(interval[:key], tier_key, :plan_key) %>
                <% next if plan_key.blank? %>
                <% memo[interval[:key]] = user_signed_in? ? dashboard_plans_path(price_key: plan_key) : new_user_registration_path(price_key: plan_key) %>
              <% end %>
              <% default_path = interval_paths.values.compact.first || "#" %>
              <% interval_paths_json = interval_paths.to_json %>
              <%= link_to default_path, class: "btn-sm text-white bg-linear-to-t from-blue-600 to-blue-400 hover:to-blue-500 w-full shadow-lg group flex items-center justify-center gap-2", data: { loading_target: true }, :"x-bind:href" => "(#{interval_paths_json})[period] || '#{default_path}'" do %>
                <span data-loading-label>
                  <%= t("landing.neon.pricing.cta") %>
                  <span class="tracking-normal text-blue-200 group-hover:translate-x-0.5 transition-transform duration-150 ease-in-out ml-1">-&gt;</span>
                </span>
                <span class="items-center gap-2" data-loading-spinner hidden>
                  <span class="loading-spinner inline-block" style="width: 1rem; height: 1rem; border: 2px solid currentColor; border-top-color: transparent; border-radius: 9999px;"></span>
                  <span><%= t("loading.default") %></span>
                </span>
              <% end %>
              <% intervals.each do |interval| %>
                <% next if interval[:billed_label].blank? %>
                <div class="text-xs text-gray-500 mt-3" x-show="period === '<%= interval[:key] %>'" x-cloak><%= interval[:billed_label] %></div>
              <% end %>
            </div>
            <% if tier[:features_title].present? %>
              <div class="font-medium mb-4"><%= tier[:features_title] %></div>
            <% end %>
            <% if features.present? %>
              <ul class="text-gray-400 space-y-3 grow">
                <% features.each do |feature| %>
                  <li class="flex items-center">
                    <svg class="w-3 h-3 fill-current text-emerald-500 mr-3 shrink-0" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                    </svg>
                    <span><%= feature %></span>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="relative">
  <div class="absolute top-0 left-0 right-0 bg-linear-to-b from-gray-800 to-gray-900 opacity-60 h-[10rem] pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-gray-900 to-transparent h-[15rem] pointer-events-none z-10" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="pt-12 md:pt-20">
      <div class="max-w-3xl mx-auto text-center pb-12 md:pb-20">
        <h2 class="h2 font-uncut-sans"><%= t("landing.neon.testimonials.title") %></h2>
      </div>

      <% testimonials = Array(t("landing.neon.testimonials.items", default: [])) %>
      <div class="max-w-sm mx-auto sm:max-w-none grid gap-12 sm:grid-cols-2 md:grid-cols-3 sm:gap-x-6 sm:gap-y-8 items-start" data-aos-id-testimonials>
        <% testimonials.each_with_index do |item, idx| %>
          <% item = item.respond_to?(:with_indifferent_access) ? item.with_indifferent_access : item %>
          <article class="h-full flex flex-col bg-gray-800 p-6" data-aos="fade" data-aos-anchor="[data-aos-id-testimonials]" <%= %(data-aos-delay="#{idx * 100}") if idx.positive? %>>
            <header class="mb-4">
              <%= image_tag "neon/images/avatar-placeholder.svg", class: "rounded-full shrink-0", width: 48, height: 48, alt: t("landing.neon.testimonials.avatar_alt", index: idx + 1) %>
            </header>
            <div class="grow mb-3">
              <p class="text-gray-400"><%= item[:quote] %></p>
            </div>
            <footer class="text-sm text-gray-400">
              <span class="text-gray-300"><%= item[:name] %></span> -
              <%= link_to item[:role], new_user_registration_path, class: "font-medium text-blue-500 hover:text-blue-400 transition duration-150 ease-in-out" %>
            </footer>
          </article>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Resources -->
<section id="resources">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20">
      <div class="max-w-3xl mx-auto text-center pb-12 md:pb-20">
        <h2 class="h2 font-uncut-sans"><%= t("landing.neon.resources.title") %></h2>
      </div>

      <div x-data="{ category: '1' }">
        <div class="mb-16">
          <div class="flex flex-wrap justify-center -m-2.5">
            <div :class="{ 'rotate-2': category === '1' }">
              <button
                class="relative font-medium px-3 py-1.5 bg-gray-800 rounded-full inline-flex m-2.5 group before:content-[''] before:absolute before:-z-10 before:inset-0 before:-m-0.5 before:bg-linear-to-t before:from-gray-800 before:to-gray-800 before:rounded-full"
                :class="category === '1' ? 'shadow-lg shadow-blue-500/25 before:via-gray-300': 'before:via-gray-600'"
                @click="category = '1'"
              >
                <div class="flex items-center justify-center">
                  <svg class="w-3 h-3 shrink-0 fill-gray-400 mr-2" :class="{ 'fill-white': category === '1' }" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1.999 9.012a.999.999 0 0 1-.706-1.707l3.496-3.5a.998.998 0 0 1 1.413 0l2.29 2.293 2.79-2.793a.998.998 0 1 1 1.413 1.414l-3.496 3.5a.998.998 0 0 1-1.413 0l-2.29-2.293-2.79 2.793a.998.998 0 0 1-.707.293Z" fill-rule="nonzero" />
                  </svg>
                  <span class="transition duration-150 ease-in-out" :class="category === '1' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-300'"><%= t("landing.neon.resources.categories.manual") %></span>
                </div>
              </button>
            </div>
            <div :class="{ 'rotate-2': category === '2' }">
              <button
                class="relative font-medium px-3 py-1.5 bg-gray-800 rounded-full inline-flex m-2.5 group before:content-[''] before:absolute before:-z-10 before:inset-0 before:-m-0.5 before:bg-linear-to-t before:from-gray-800 before:to-gray-800 before:via-gray-600 before:rounded-full"
                :class="category === '2' ? 'shadow-lg shadow-blue-500/25 before:via-gray-300': 'before:via-gray-600'"
                @click="category = '2'"
              >
                <div class="flex items-center justify-center">
                  <svg class="w-3 h-3 shrink-0 fill-gray-400 mr-2" :class="{ 'fill-white': category === '2' }" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 0a6 6 0 1 0 0 12A6 6 0 0 0 6 0Zm0 9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" fill-rule="nonzero" />
                  </svg>
                  <span class="transition duration-150 ease-in-out" :class="category === '2' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-300'"><%= t("landing.neon.resources.categories.indicators") %></span>
                </div>
              </button>
            </div>
            <div :class="{ 'rotate-2': category === '3' }">
              <button
                class="relative font-medium px-3 py-1.5 bg-gray-800 rounded-full inline-flex m-2.5 group before:content-[''] before:absolute before:-z-10 before:inset-0 before:-m-0.5 before:bg-linear-to-t before:from-gray-800 before:to-gray-800 before:via-gray-600 before:rounded-full"
                :class="category === '3' ? 'shadow-lg shadow-blue-500/25 before:via-gray-300': 'before:via-gray-600'"
                @click="category = '3'"
              >
                <div class="flex items-center justify-center">
                  <svg class="w-3 h-3 shrink-0 fill-gray-400 mr-2" :class="{ 'fill-white': category === '3' }" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.334 8.06a.5.5 0 0 0-.421-.237 6.023 6.023 0 0 1-5.905-6c0-.41.042-.82.125-1.221a.5.5 0 0 0-.614-.586 6 6 0 1 0 6.832 8.529.5.5 0 0 0-.017-.485Z" fill-rule="nonzero" />
                  </svg>
                  <span class="transition duration-150 ease-in-out" :class="category === '3' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-300'"><%= t("landing.neon.resources.categories.templates") %></span>
                </div>
              </button>
            </div>
            <div :class="{ 'rotate-2': category === '4' }">
              <button
                class="relative font-medium px-3 py-1.5 bg-gray-800 rounded-full inline-flex m-2.5 group before:content-[''] before:absolute before:-z-10 before:inset-0 before:-m-0.5 before:bg-linear-to-t before:from-gray-800 before:to-gray-800 before:via-gray-600 before:rounded-full"
                :class="category === '4' ? 'shadow-lg shadow-blue-500/25 before:via-gray-300': 'before:via-gray-600'"
                @click="category = '4'"
              >
                <div class="flex items-center justify-center">
                  <svg class="w-3 h-3 shrink-0 fill-gray-400 mr-2" :class="{ 'fill-white': category === '4' }" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.953 4.29a.5.5 0 0 0-.454-.292H6.14L6.984.62A.5.5 0 0 0 6.12.173l-6 7a.5.5 0 0 0 .379.825h5.359l-.844 3.38a.5.5 0 0 0 .864.445l6-7a.5.5 0 0 0 .075-.534Z" fill-rule="nonzero" />
                  </svg>
                  <span class="transition duration-150 ease-in-out" :class="category === '4' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-300'"><%= t("landing.neon.resources.categories.support") %></span>
                </div>
              </button>
            </div>
          </div>
        </div>

        <% dashboard_target = user_signed_in? ? dashboard_path : new_user_session_path %>
        <% resource_cards = [
          { key: "channel", show: %w[1 3 4], href: nil },
          { key: "community", show: %w[2 3], href: nil },
          { key: "pro_templates", show: %w[2 3 4], href: dashboard_target },
          { key: "indicator_pack", show: %w[1 4], href: dashboard_target },
          { key: "quick_guide", show: %w[1 2 3], href: dashboard_target },
          { key: "video_tutorial", show: %w[1 2 4], href: dashboard_target }
        ] %>

        <div class="max-w-sm mx-auto sm:max-w-none grid gap-12 sm:grid-cols-2 md:grid-cols-4 sm:gap-x-6 sm:gap-y-8 items-start">
          <% resource_cards.each do |card| %>
            <% wrapper_classes = "block relative before:content-[''] before:bg-gray-800 before:absolute before:-z-10 before:inset-0 p-6 group" %>
            <% show_expression = "['#{card[:show].join("', '")}'].includes(category)" %>
            <% card_body = capture do %>
              <div class="relative h-12 w-12 rounded-full bg-linear-to-t from-gray-800 to-gray-700 flex items-center justify-center shadow-lg mb-3 before:content-[''] before:absolute before:-z-10 before:inset-0 before:-m-0.5 before:bg-linear-to-t before:from-gray-800 before:to-gray-800 before:via-gray-600 before:rounded-full">
                <% case card[:key] %>
                <% when "channel" %>
                  <svg class="fill-blue-500 group-hover:fill-gray-200 transition duration-150 ease-in-out" width="26" height="18" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21.956.378a.47.47 0 0 0-.32-.347 1.662 1.662 0 0 0-.866.061S1.494 6.968.393 7.73c-.236.164-.316.26-.355.371-.19.546.402.78.402.78l4.968 1.607c.084.015.17.01.252-.015 1.13-.708 11.366-7.126 11.961-7.342.092-.027.162 0 .144.069-.237.823-9.083 8.622-9.131 8.669a.181.181 0 0 0-.066.16l-.464 4.815s-.194 1.498 1.315 0a42.204 42.204 0 0 1 2.612-2.373c1.708 1.171 3.546 2.466 4.339 3.143.27.26.633.398 1.008.385a1.13 1.13 0 0 0 .964-.849s3.51-14.03 3.627-15.909c.012-.182.028-.302.03-.428a1.591 1.591 0 0 0-.043-.435Z" fill-rule="nonzero" />
                  </svg>
                <% when "community" %>
                  <svg class="fill-blue-500 group-hover:fill-gray-200 transition duration-150 ease-in-out" width="24" height="18" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20.317 1.492c-1.53-.69-3.17-1.2-4.885-1.49a.075.075 0 0 0-.079.036c-.21.369-.444.85-.608 1.23a18.565 18.565 0 0 0-5.487 0C9.095.88 8.852.406 8.641.037A.077.077 0 0 0 8.562 0c-1.714.29-3.354.8-4.885 1.491a.07.07 0 0 0-.032.027C.533 6.093-.32 10.555.099 14.961a.08.08 0 0 0 .031.055 20.03 20.03 0 0 0 5.993 2.98.078.078 0 0 0 .084-.026c.462-.62.874-1.275 1.226-1.963.021-.04.001-.088-.041-.104a13.202 13.202 0 0 1-1.872-.878.075.075 0 0 1-.008-.125c.126-.093.252-.19.372-.287a.075.075 0 0 1 .078-.01c3.927 1.764 8.18 1.764 12.061 0a.075.075 0 0 1 .078.009c.12.097.246.195.373.288a.075.075 0 0 1-.006.125c-.598.344-1.22.635-1.873.877a.075.075 0 0 0-.041.105c.36.687.772 1.341 1.225 1.962a.077.077 0 0 0 .084.028 19.964 19.964 0 0 0 6.002-2.981.076.076 0 0 0 .032-.054c.5-5.094-.839-9.52-3.549-13.442a.06.06 0 0 0-.031-.028ZM8.02 12.278c-1.183 0-2.157-1.068-2.157-2.38 0-1.312.956-2.38 2.157-2.38 1.21 0 2.176 1.077 2.157 2.38 0 1.312-.956 2.38-2.157 2.38Zm7.975 0c-1.183 0-2.157-1.068-2.157-2.38 0-1.312.955-2.38 2.157-2.38 1.21 0 2.176 1.077 2.157 2.38 0 1.312-.946 2.38-2.157 2.38Z" fill-rule="nonzero" />
                  </svg>
                <% when "pro_templates" %>
                  <svg class="fill-blue-500 group-hover:fill-gray-200 transition duration-150 ease-in-out" width="24" height="24" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1.999 9.012a.999.999 0 0 1-.706-1.707l3.496-3.5a.998.998 0 0 1 1.413 0l2.29 2.293 2.79-2.793a.998.998 0 1 1 1.413 1.414l-3.496 3.5a.998.998 0 0 1-1.413 0l-2.29-2.293-2.79 2.793a.998.998 0 0 1-.707.293Z" fill-rule="nonzero" />
                  </svg>
                <% when "indicator_pack" %>
                  <svg class="fill-blue-500 group-hover:fill-gray-200 transition duration-150 ease-in-out" width="24" height="24" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 0a6 6 0 1 0 0 12A6 6 0 0 0 6 0Zm0 9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" fill-rule="nonzero" />
                  </svg>
                <% when "quick_guide" %>
                  <svg class="fill-blue-500 group-hover:fill-gray-200 transition duration-150 ease-in-out" width="23" height="23" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.924 19h6.927l5.128 1.386 3.399-12.548L16 6.654V4.582l5.859 1.586a1 1 0 0 1 .704 1.226l-3.913 14.48a1 1 0 0 1-1.226.705l-12.55-3.393.05-.186Z" fill-rule="nonzero" fill-opacity=".64" />
                    <rect width="14" height="17" rx="1" />
                  </svg>
                <% when "video_tutorial" %>
                  <svg class="fill-blue-500 group-hover:fill-gray-200 transition duration-150 ease-in-out" width="22" height="18" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21.083 0H.917C.41 0 0 .448 0 1v16c0 .552.41 1 .917 1h20.166c.507 0 .917-.448.917-1V1c0-.552-.41-1-.917-1ZM9 13V5l6 4-6 4Z" fill-rule="nonzero" />
                  </svg>
                <% end %>
              </div>
              <div class="font-uncut-sans text-xl text-gray-100 font-semibold"><%= t("landing.neon.resources.boxes.#{card[:key]}") %></div>
            <% end %>

            <% if card[:href].present? %>
              <%= link_to card[:href], class: wrapper_classes, "x-show": show_expression do %>
                <%= card_body %>
              <% end %>
            <% else %>
              <%= content_tag :div, card_body, class: wrapper_classes, "x-show": show_expression %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="relative bg-linear-to-tr from-blue-600 to-purple-500 rounded-sm py-10 px-8 md:py-16 md:px-12 overflow-hidden" data-aos="zoom-out">
      <div class="hidden lg:block absolute right-0 top-1/2 -translate-y-1/2 mt-8 -z-10" aria-hidden="true">
        <%= image_tag "neon/images/cta-illustration.svg", class: "max-w-none", width: 582, height: 662, alt: t("landing.neon.media.cta_illustration_alt") %>
      </div>

      <div class="flex flex-col lg:flex-row justify-between items-center">
        <div class="mb-6 lg:mr-16 lg:mb-0 text-center lg:text-left">
          <h3 class="text-4xl font-bold font-uncut-sans mb-2"><%= t("landing.neon.cta.title") %></h3>
          <p class="text-blue-200"><%= t("landing.neon.cta.body") %></p>
        </div>

        <div class="shrink-0">
          <%= link_to(user_signed_in? ? dashboard_path : new_user_registration_path, class: "btn-sm text-white bg-linear-to-t from-blue-600 to-blue-400 hover:to-blue-500 w-full group shadow-lg flex items-center justify-center gap-2") do %>
            <%= t("landing.neon.cta.button") %>
            <span class="tracking-normal text-blue-200 group-hover:translate-x-0.5 transition-transform duration-150 ease-in-out ml-1">-&gt;</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
