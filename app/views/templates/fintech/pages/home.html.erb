          <div class="md:max-w-3xl mb-12 md:mb-20" data-aos="fade-up">
            <h2 class="h2 text-white mb-4"><%= t("landing.fintech.section5.title") %></h2>
            <p class="text-lg text-blue-200 mb-8"><%= t("landing.fintech.section5.body") %></p>
          </div>

          <div class="flex justify-center mb-6" data-aos="fade-up" data-aos-delay="100">
            <div class="relative">
              <%= image_tag "fintech/images/logos-illustration.svg", class: "absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 pointer-events-none -z-10 max-w-none mix-blend-lighten", width: 594, height: 639, aria: { hidden: true } %>
              <%= image_tag "fintech/images/trading_icons.png", width: 720, height: 283, alt: t("landing.fintech.section5.image_alt") %>
            </div>
          </div>

          <div class="max-w-sm mx-auto grid gap-12 md:grid-cols-3 md:-mx-9 md:gap-0 items-start md:max-w-none text-left" data-aos="fade-up" data-aos-delay="200">
            <% landing_fintech_steps = t("landing.fintech.section5.steps") %>
            <% landing_fintech_steps.each_with_index do |step, index| %>
              <div class="relative md:px-9 after:hidden md:after:block after:absolute after:right-0 after:top-1/2 after:-translate-y-1/2 after:w-px after:h-16 after:bg-blue-400 last:after:hidden">
                <div class="mb-3">
                  <div class="flex items-center justify-center font-bold text-teal-600 bg-teal-200 h-11 w-11 rounded-full"><%= index + 1 %></div>
                </div>
                <h4 class="text-white text-xl font-bold mb-1"><%= step[:title] %></h4>
                <p class="text-blue-200"><%= step[:body] %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mt-12 md:mt-20" data-aos-id-6>
  <div class="relative max-w-7xl mx-auto">
    <div class="absolute inset-0 rounded-tl-[100px] mb-24 md:mb-0 bg-linear-to-b from-slate-100 pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="relative max-w-xl mx-auto md:max-w-none text-center md:text-left flex flex-col md:flex-row items-center justify-end">
          <div class="w-[512px] max-w-full shrink-0 md:order-1">
            <h2 class="h2 mb-4" data-aos="fade-up" data-aos-anchor="[data-aos-id-6]" data-aos-delay="100"><%= t("landing.fintech.section6.title") %></h2>
            <p class="text-lg text-slate-500 mb-6" data-aos="fade-up" data-aos-anchor="[data-aos-id-6]" data-aos-delay="200"><%= t("landing.fintech.section6.body") %></p>
            <ul class="inline-flex flex-col text-slate-500 space-y-2.5" data-aos="fade-up" data-aos-anchor="[data-aos-id-6]" data-aos-delay="300">
              <% landing_fintech_principles = t("landing.fintech.section6.principles") %>
              <% landing_fintech_principles.each do |item| %>
                <li class="flex items-center">
                  <svg class="shrink-0 mr-3" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                    <circle class="fill-blue-100" cx="10" cy="10" r="10" />
                    <path class="fill-blue-500" d="M15.335 7.933 14.87 7c-4.025 1.167-6.067 3.733-6.067 3.733l-1.867-1.4-.933.934L8.802 14c2.158-4.025 6.533-6.067 6.533-6.067Z" />
                  </svg>
                  <span><%= item %></span>
                </li>
              <% end %>
            </ul>
          </div>

          <div class="w-full max-w-sm md:max-w-none md:mr-8 mt-12 md:mt-0" data-aos="fade-up" data-aos-anchor="[data-aos-id-6]">
            <div class="relative max-w-sm mx-auto">
              <div class="absolute inset-0 mb-10 -mt-14 -mx-14 bg-slate-100 -z-10" aria-hidden="true"></div>

              <div class="testimonial-carousel swiper-container max-w-sm mx-auto sm:max-w-none">
                <div class="swiper-wrapper">
                  <% landing_fintech_testimonials = t("landing.fintech.section6.testimonials") %>
                  <% landing_fintech_testimonials.each do |testimonial| %>
                    <div class="swiper-slide flex flex-col h-auto shadow-2xl text-left">
                      <div class="relative after:absolute after:inset-0 after:bg-linear-to-t after:from-slate-700">
                        <%= image_tag testimonial[:image], class: "md:max-w-none", width: 384, height: 180, alt: testimonial[:image_alt] %>
                      </div>
                      <div class="grow flex flex-col relative bg-linear-to-t from-slate-800 to-slate-700 p-6 pt-14">
                        <%= image_tag "fintech/images/logo_transparente.png", class: "absolute bottom-full translate-y-1/2", width: testimonial[:logo_width], height: testimonial[:logo_height], alt: testimonial[:logo_alt] %>
                        <p class="grow font-medium text-slate-200 mb-4"><%= testimonial[:quote] %></p>
                        <div class="font-medium text-sm text-slate-500">
                          <span class="text-slate-200"><%= testimonial[:author] %></span> - <span class="text-slate-400"><%= testimonial[:role] %></span>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="mt-4">
                <div class="testimonial-carousel-pagination text-center"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="relative max-w-7xl mx-auto">
    <div class="absolute inset-0 rounded-tr-[100px] mb-24 md:mb-0 border-2 border-slate-100 pointer-events-none -z-10" aria-hidden="true"></div>
    <div class="absolute inset-0 rounded-tr-[100px] mb-24 md:mb-0 bg-linear-to-t from-white pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="relative max-w-xl mx-auto md:max-w-none text-center md:text-left">
          <div class="md:max-w-3xl mb-12 md:mb-20" data-aos="fade-up">
            <h2 class="h2 mb-4"><%= t("landing.fintech.section7.title") %></h2>
            <p class="text-lg text-slate-500 mb-8"><%= t("landing.fintech.section7.body") %></p>
          </div>

          <div class="max-w-sm md:max-w-2xl xl:max-w-none mx-auto grid gap-8 md:grid-cols-2 xl:grid-cols-4 xl:gap-6 items-start" data-aos="fade-up" data-aos-delay="100">
            <% landing_fintech_plans = t("landing.fintech.section7.plans") %>
            <% landing_fintech_plans.each do |plan| %>
              <div class="relative flex flex-col h-full rounded-br-[100px] py-5 px-6 <%= plan[:container_class] %>">
                <% if plan[:badge].present? %>
                  <div class="absolute top-0 right-0 -translate-y-1/2 mr-6 inline-flex text-sm text-white bg-teal-500 font-[550] rounded-full px-3 py-px">
                    <%= plan[:badge] %>
                  </div>
                <% end %>
                <div class="mb-4">
                  <div class="text-lg font-bold text-center mb-3"><%= plan[:name] %></div>
                  <%= image_tag plan[:image], class: "w-full rounded-lg", width: 210, height: 124, alt: plan[:image_alt] %>
                </div>
                <div class="mb-5">
                  <div class="text-2xl text-slate-800 font-bold text-center mb-4"><%= plan[:price] %></div>
                  <%= link_to t("landing.fintech.section7.subscribe_cta"), primary_cta_path, class: plan[:cta_class] %>
                </div>
                <div class="text-slate-800 font-medium mb-4"><%= plan[:features_title] %></div>
                <ul class="text-slate-500 text-left space-y-2">
                  <% plan[:features].each do |feature| %>
                    <li class="flex items-start">
                      <svg class="w-3 h-3 fill-current text-teal-500 mr-3 mt-1.5 shrink-0" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                      </svg>
                      <span><%= feature %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="pb-12 md:pb-20" data-aos="fade-up">
      <div class="pb-12">
        <h2 class="h2"><%= t("landing.fintech.faq.title") %></h2>
      </div>

      <div class="md:flex md:space-x-12 space-y-8 md:space-y-0">
        <% landing_fintech_faqs = t("landing.fintech.faq.items") %>
        <div class="w-full md:w-1/2 space-y-8">
          <% landing_fintech_faqs.first(3).each do |faq| %>
            <div class="space-y-2">
              <h4 class="text-xl font-bold"><%= faq[:question] %></h4>
              <p class="text-slate-500"><%= faq[:answer] %></p>
            </div>
          <% end %>
        </div>

        <div class="w-full md:w-1/2 space-y-8">
          <% landing_fintech_faqs.drop(3).each do |faq| %>
            <div class="space-y-2">
              <h4 class="text-xl font-bold"><%= faq[:question] %></h4>
              <p class="text-slate-500"><%= faq[:answer] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="relative">
  <div class="absolute inset-0 bg-slate-800 -z-10" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6" data-aos="fade-up">
    <div class="py-12 md:py-20">
      <div class="sm:flex sm:flex-col lg:flex-row justify-between items-center">
        <div class="mb-6 lg:mr-16 lg:mb-0 text-center lg:text-left">
          <p class="text-xl text-blue-500 font-[550] mb-3"><%= t("landing.fintech.cta.subtitle") %></p>
          <h2 class="h2 text-slate-100"><%= t("landing.fintech.cta.title") %></h2>
        </div>

        <div class="shrink-0">
          <div class="max-w-xs mx-auto sm:max-w-none sm:flex sm:justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4 mb-12 md:mb-0">
            <div>
              <%= link_to primary_cta_path, class: "btn-sm w-full inline-flex items-center text-blue-50 bg-blue-500 hover:bg-blue-600 group shadow-xs" do %>
                <%= t("landing.fintech.cta.primary") %>
                <span class="tracking-normal text-sky-400 group-hover:translate-x-0.5 transition-transform duration-150 ease-in-out ml-2">
                  <svg class="fill-current" width="12" height="10" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 6.002h7.586L6.293 8.295a1 1 0 1 0 1.414 1.414l4-4a1 1 0 0 0 0-1.416l-4-4a1 1 0 0 0-1.414 1.416l2.293 2.293H1a1 1 0 1 0 0 2Z" />
                  </svg>
                </span>
              <% end %>
            </div>
            <div>
              <%= link_to t("landing.fintech.cta.support"), support_cta_url, class: "btn-sm w-full inline-flex items-center text-white bg-slate-700 hover:bg-slate-800 shadow-xs relative before:absolute before:inset-0 before:bg-blue-400/60 before:-z-10 before:rounded-full" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
