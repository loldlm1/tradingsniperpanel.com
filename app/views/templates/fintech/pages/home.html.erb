            <%= image_tag "fintech/images/hero_oficial.png", class: "md:max-w-none", width: 548, height: 545, alt: t("landing.fintech.media.hero_image_alt"), data: { aos: "fade-up" } %>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

