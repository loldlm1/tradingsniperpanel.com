<% presenter = @course_presenter %>
<% course = presenter.course %>
<% module_cards = presenter.module_cards %>
<% module_pages = (module_cards.size.to_f / 4).ceil %>
<% content_for :title, t("dashboard.courses.show_page_title", course: presenter.title) %>

<!-- Page header -->
<div class="sm:flex sm:justify-between sm:items-center mb-6">
  <div class="mb-4 sm:mb-0">
    <div class="mb-4">
      <%= link_to dashboard_courses_path, class: "text-sm font-medium text-violet-500 hover:text-violet-600 dark:hover:text-violet-400" do %>
        <span aria-hidden="true">&larr;</span>
        <span class="ml-1"><%= t("dashboard.courses.back_to_courses") %></span>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-xs uppercase text-gray-500 dark:text-gray-400 tracking-wide">
      <span><%= t("dashboard.courses.breadcrumbs.course") %></span>
      <span class="text-gray-300 dark:text-gray-600">/</span>
      <span><%= presenter.category_label %></span>
    </div>
    <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold mt-2">
      <%= presenter.title %>
    </h1>
  </div>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <%= render "dashboard/shared/filter_chip",
      label: presenter.status_label,
      interactive: false,
      extra_class: "text-xs #{presenter.status_badge_class}"
    %>
    <%= render "dashboard/shared/filter_chip",
      label: presenter.access_badge_label,
      interactive: false,
      extra_class: "text-xs #{presenter.access_badge_class}"
    %>
  </div>
</div>

<!-- Cards -->
<div class="grid grid-cols-12 gap-6">

  <!-- Card 1 -->
  <article class="col-span-full xl:col-span-8 bg-white dark:bg-gray-800 shadow-xs rounded-xl p-6 transition-shadow duration-200 hover:shadow-md">
    <!-- Section 1: Course Summary -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex-1 min-w-0">
        <div class="text-xs uppercase text-gray-500 dark:text-gray-400 tracking-wide"><%= t("dashboard.courses.summary.overview_label") %></div>
        <h2 class="text-xl md:text-2xl text-gray-800 dark:text-gray-100 font-semibold">
          <%= presenter.title %>
        </h2>
        <% if presenter.summary_text.present? %>
          <div class="text-sm font-semibold text-gray-700 dark:text-gray-200 mt-3"><%= t("dashboard.courses.summary.summary_title") %></div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= presenter.summary_text %></p>
        <% end %>
        <% if presenter.outcomes_text.present? %>
          <div class="text-sm font-semibold text-gray-700 dark:text-gray-200 mt-4"><%= t("dashboard.courses.summary.outcomes_title") %></div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= presenter.outcomes_text %></p>
        <% end %>
      </div>
      <div class="flex flex-col items-start lg:items-end gap-3 text-xs shrink-0">
        <% if course.cover_image.attached? %>
          <div class="w-40 h-24 rounded-lg overflow-hidden border border-gray-100 dark:border-gray-700/60 bg-gray-100 dark:bg-gray-900/20 shadow-sm">
            <%= image_tag course.cover_image, class: "object-cover w-full h-full", width: 160, height: 96, alt: presenter.title %>
          </div>
        <% end %>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700/60 text-gray-600 dark:text-gray-300 font-medium px-2.5 py-1"><%= t("dashboard.courses.summary.level_label", level: presenter.category_label) %></span>
          <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700/60 text-gray-600 dark:text-gray-300 font-medium px-2.5 py-1"><%= t("dashboard.courses.summary.language_label", language: I18n.locale.to_s.upcase) %></span>
          <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700/60 text-gray-600 dark:text-gray-300 font-medium px-2.5 py-1"><%= t("dashboard.courses.summary.status_label", status: presenter.status_label) %></span>
        </div>
      </div>
    </div>

    <div class="mt-6 border border-gray-100 dark:border-gray-700/60 rounded-lg p-4">
      <div class="text-sm font-semibold text-gray-700 dark:text-gray-200"><%= t("dashboard.courses.details_title") %></div>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.details.modules_label") %></span>
          <span class="font-medium text-gray-800 dark:text-gray-100"><%= presenter.modules_count %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.details.lessons_label") %></span>
          <span class="font-medium text-gray-800 dark:text-gray-100"><%= presenter.lessons_count %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.details.duration_label") %></span>
          <span class="font-medium text-gray-800 dark:text-gray-100"><%= format_duration(presenter.total_duration_seconds) %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.details.access_source_label") %></span>
          <span class="font-medium text-gray-800 dark:text-gray-100"><%= presenter.access_source_label %></span>
        </div>
      </div>
      <div class="mt-3 text-sm <%= presenter.accessible? ? "text-emerald-700 dark:text-emerald-300" : "text-gray-500 dark:text-gray-400" %>">
        <%= presenter.course_access_label %>
      </div>
      <% if presenter.resume_lesson.present? %>
        <div class="mt-2 text-sm text-gray-500 dark:text-gray-400">
          <%= t("dashboard.courses.resume_hint", lesson: presenter.resume_lesson.title_for(I18n.locale)) %>
        </div>
      <% end %>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <% if presenter.resume_url.present? %>
          <%= link_to t("dashboard.courses.resume_cta"), presenter.resume_url, class: "btn-sm bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        <% elsif presenter.unlock_url.present? %>
          <%= link_to t("dashboard.courses.unlock_cta"), presenter.unlock_url, class: "btn-sm bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        <% end %>
      </div>
    </div>
  </article>

  <!-- Card 2 -->
  <div class="flex flex-col col-span-full sm:col-span-6 xl:col-span-4 bg-white dark:bg-gray-800 shadow-xs rounded-xl transition-shadow duration-200 hover:shadow-md">
    <!-- Section 2: Course Progress -->
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.courses.progress.module_title") %></h2>
    </header>
    <div class="grow p-4">
      <div class="flex flex-col h-full">
        <div class="grow">
          <% if module_cards.any? %>
            <ul class="space-y-2 text-sm text-gray-800 dark:text-gray-100">
              <% module_cards.each do |card| %>
                <% percent = card.progress_percent.to_i %>
                <li class="relative px-3 py-1.5">
                  <div class="absolute inset-0 bg-violet-100 dark:bg-violet-500/20 rounded-r" aria-hidden="true" style="width: <%= percent %>%;"></div>
                  <div class="relative flex justify-between space-x-2">
                    <div><%= t("dashboard.courses.module_label", number: card.index) %> - <%= card.title %></div>
                    <div class="font-medium"><%= percent %>%</div>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.modules_empty") %></div>
          <% end %>
        </div>
        <div class="pt-4 mt-4 border-t border-gray-100 dark:border-gray-700/60">
          <div class="flex items-center justify-between text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide">
            <span><%= t("dashboard.courses.progress.overall_label") %></span>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= presenter.course_progress_percent_label %>%</span>
          </div>
          <div class="mt-2 w-full h-2 bg-gray-100 dark:bg-gray-700/60 rounded-full" role="progressbar" aria-label="<%= t("dashboard.courses.progress.aria_label") %>" aria-valuenow="<%= presenter.course_progress_percent_label %>" aria-valuemin="0" aria-valuemax="100">
            <div class="h-2 rounded-full bg-violet-500" style="width: <%= presenter.course_progress_percent_label %>%;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if module_cards.any? %>
    <div
      class="col-span-full"
      data-pagination-container
      data-page-size="4"
      data-current-page="1"
      data-active-class="bg-violet-500 text-white"
      data-inactive-class="border border-gray-200 dark:border-gray-700/60 text-gray-600 dark:text-gray-300"
      data-disabled-class="opacity-50 pointer-events-none"
    >
      <div class="grid grid-cols-12 gap-6">
        <% module_cards.each do |card| %>
          <!-- Card <%= card.index + 2 %> -->
          <article class="col-span-full xl:col-span-6 bg-white dark:bg-gray-800 shadow-xs rounded-xl p-6 transition-shadow duration-200 hover:shadow-md" data-pagination-item>
            <!-- Section <%= card.index + 2 %>: <%= t("dashboard.courses.module_label", number: card.index) %> -->
            <div class="flex flex-col gap-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="text-xs uppercase text-gray-500 dark:text-gray-400 tracking-wide"><%= t("dashboard.courses.module_label", number: card.index) %></div>
                  <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100"><%= card.title %></h3>
                  <% if card.summary.present? %>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= card.summary %></p>
                  <% end %>
                </div>
                <div class="shrink-0">
                  <%= render "dashboard/shared/filter_chip",
                    label: t("dashboard.courses.meta.lessons_count", count: card.lessons_count),
                    interactive: false,
                    extra_class: "text-xs"
                  %>
                </div>
              </div>
              <div>
                <div class="flex items-center justify-between">
                  <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.courses.module_progress_label") %></div>
                  <div class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= card.progress_percent %>%</div>
                </div>
                <div class="mt-2 w-full h-2 bg-gray-100 dark:bg-gray-700/60 rounded-full" role="progressbar" aria-label="<%= t("dashboard.courses.module_progress_label") %>" aria-valuenow="<%= card.progress_percent %>" aria-valuemin="0" aria-valuemax="100">
                  <div class="h-2 rounded-full bg-violet-500" style="width: <%= card.progress_percent %>%;"></div>
                </div>
              </div>
              <% lesson_pages = (card.lessons.size.to_f / 3).ceil %>
              <div
                data-pagination-container
                data-page-size="3"
                data-current-page="1"
                data-active-class="bg-violet-500 text-white"
                data-inactive-class="border border-gray-200 dark:border-gray-700/60 text-gray-600 dark:text-gray-300"
                data-disabled-class="opacity-50 pointer-events-none"
              >
                <ul class="mt-2 space-y-2">
                  <% card.lessons.each do |lesson| %>
                    <li class="flex items-center justify-between text-sm gap-3" data-pagination-item>
                      <div class="flex items-center gap-3 min-w-0 flex-1">
                        <% status_label =
                          if lesson.completed
                            t("dashboard.courses.lesson_status.completed")
                          elsif lesson.started
                            t("dashboard.courses.lesson_status.in_progress")
                          else
                            t("dashboard.courses.lesson_status.not_started")
                          end
                        %>
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border border-gray-200 dark:border-gray-700/60" title="<%= status_label %>">
                          <span class="sr-only"><%= status_label %></span>
                          <% if lesson.completed %>
                            <svg class="w-3 h-3 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                              <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 0 1.42l-7.2 7.2a1 1 0 0 1-1.408.013L3.3 9.233a1 1 0 1 1 1.4-1.43l3.386 3.316 6.5-6.5a1 1 0 0 1 1.418-.03Z" clip-rule="evenodd" />
                            </svg>
                          <% elsif lesson.started %>
                            <span class="w-2 h-2 rounded-full bg-amber-500" aria-hidden="true"></span>
                          <% else %>
                            <span class="w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600" aria-hidden="true"></span>
                          <% end %>
                        </span>
                        <span class="text-gray-700 dark:text-gray-300 min-w-0 truncate flex-1"><%= lesson.index %>. <%= lesson.title %></span>
                      </div>
                      <div class="flex items-center gap-3 shrink-0">
                        <% if lesson.accessible && lesson.url.present? %>
                          <%= link_to t("dashboard.courses.lesson_cta"), lesson.url, class: "inline-flex items-center justify-center text-xs font-medium px-3 py-1.5 rounded-full bg-gray-100 dark:bg-gray-700/60 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600/60" %>
                        <% else %>
                          <button class="inline-flex items-center justify-center text-xs font-medium px-3 py-1.5 rounded-full bg-gray-100 dark:bg-gray-700/60 text-gray-400 dark:text-gray-500 cursor-not-allowed" type="button" disabled>
                            <%= t("dashboard.courses.lesson_locked_cta") %>
                          </button>
                        <% end %>
                        <span class="text-gray-500 dark:text-gray-400 whitespace-nowrap"><%= lesson.duration_label %></span>
                      </div>
                    </li>
                  <% end %>
                </ul>
                <% if lesson_pages > 1 %>
                  <div class="mt-3">
                    <nav class="flex items-center justify-between" aria-label="<%= t("dashboard.courses.lesson_pagination_label") %>" data-pagination-nav>
                      <button class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 dark:border-gray-700/60 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/40" type="button" data-pagination-prev>
                        <span class="sr-only"><%= t("dashboard.pagination.prev") %></span>
                        <svg class="fill-current" width="16" height="16" viewBox="0 0 16 16">
                          <path d="M9.4 13.4l1.4-1.4-4-4 4-4-1.4-1.4L4 8z" />
                        </svg>
                      </button>
                      <div class="flex items-center gap-2 text-sm font-medium">
                        <% (1..lesson_pages).each do |page| %>
                          <button
                            class="w-9 h-9 rounded-lg cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/40 <%= page == 1 ? "bg-violet-500 text-white" : "border border-gray-200 dark:border-gray-700/60 text-gray-600 dark:text-gray-300" %>"
                            type="button"
                            data-pagination-page="<%= page %>"
                          ><%= page %></button>
                        <% end %>
                      </div>
                      <button class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 dark:border-gray-700/60 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/40" type="button" data-pagination-next>
                        <span class="sr-only"><%= t("dashboard.pagination.next") %></span>
                        <svg class="fill-current" width="16" height="16" viewBox="0 0 16 16">
                          <path d="M6.6 13.4L5.2 12l4-4-4-4 1.4-1.4L12 8z" />
                        </svg>
                      </button>
                    </nav>
                  </div>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
      <% if module_pages > 1 %>
        <div class="mt-6">
          <nav class="flex items-center justify-between" aria-label="<%= t("dashboard.courses.module_pagination_label") %>" data-pagination-nav>
            <button class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 dark:border-gray-700/60 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/40" type="button" data-pagination-prev>
              <span class="sr-only"><%= t("dashboard.pagination.prev") %></span>
              <svg class="fill-current" width="16" height="16" viewBox="0 0 16 16">
                <path d="M9.4 13.4l1.4-1.4-4-4 4-4-1.4-1.4L4 8z" />
              </svg>
            </button>
            <div class="flex items-center gap-2 text-sm font-medium">
              <% (1..module_pages).each do |page| %>
                <button
                  class="w-9 h-9 rounded-lg cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/40 <%= page == 1 ? "bg-violet-500 text-white" : "border border-gray-200 dark:border-gray-700/60 text-gray-600 dark:text-gray-300" %>"
                  type="button"
                  data-pagination-page="<%= page %>"
                ><%= page %></button>
              <% end %>
            </div>
            <button class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 dark:border-gray-700/60 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/40" type="button" data-pagination-next>
              <span class="sr-only"><%= t("dashboard.pagination.next") %></span>
              <svg class="fill-current" width="16" height="16" viewBox="0 0 16 16">
                <path d="M6.6 13.4L5.2 12l4-4-4-4 1.4-1.4L12 8z" />
              </svg>
            </button>
          </nav>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if module_cards.empty? %>
    <article class="col-span-full bg-white dark:bg-gray-800 shadow-xs rounded-xl p-6 transition-shadow duration-200 hover:shadow-md">
      <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.modules_empty") %></div>
    </article>
  <% end %>
</div>
