<% entry = @course_entry %>
<% course = @course %>
<% accessible = entry&.accessible || course.subscription_tiers.blank? %>
<% cta_plan = entry&.cta_plan %>
<% progress_percent = entry&.progress_percent %>
<% lessons = course.course_lessons %>

<% content_for :title, t("dashboard.courses.show_page_title", course: course.title_for(I18n.locale)) %>

<div class="mb-6 flex items-start justify-between flex-wrap gap-4">
  <div>
    <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.courses.categories.#{course.category}", default: course.category.to_s.humanize) %></div>
    <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= course.title_for(I18n.locale) %></h1>
    <% summary = course.summary_for(I18n.locale).presence || course.description_for(I18n.locale) %>
    <% if summary.present? %>
      <p class="text-gray-600 dark:text-gray-300 max-w-3xl"><%= summary %></p>
    <% end %>
  </div>
  <div class="flex items-center gap-2">
    <% badge_label = if course.subscription_tiers.blank?
                      t("dashboard.courses.badges.free")
                    elsif accessible
                      t("dashboard.courses.badges.unlocked")
                    else
                      t("dashboard.courses.badges.locked")
                    end %>
    <% badge_class = if course.subscription_tiers.blank?
                      "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-100"
                    elsif accessible
                      "bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-100"
                    else
                      "bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-200"
                    end %>
    <%= render "dashboard/shared/badge",
               label: badge_label,
               padding_class: "px-2 py-1",
               class_name: badge_class %>
    <% if !accessible && cta_plan.present? %>
      <%= link_to t("dashboard.courses.unlock_cta"), dashboard_plans_path(price_key: cta_plan.key), class: "btn bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.courses.modules_title") %></div>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.modules_copy") %></p>
        </div>
        <% if progress_percent.present? %>
          <div class="text-xs text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.progress_label", percent: progress_percent) %></div>
        <% end %>
      </div>

      <% if !accessible %>
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-4"><%= t("dashboard.courses.locked_teaser") %></div>
      <% end %>

      <div class="space-y-4">
        <% @course_modules.each_with_index do |course_module, module_index| %>
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.courses.module_label", number: module_index + 1) %></div>
                <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= course_module.title_for(I18n.locale) %></div>
                <% module_summary = course_module.summary_for(I18n.locale) %>
                <% if module_summary.present? %>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= module_summary %></p>
                <% end %>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.meta.lessons", count: course_module.course_lessons.size) %></div>
            </div>

            <ul class="mt-3 space-y-2">
              <% course_module.course_lessons.ordered.each_with_index do |lesson, lesson_index| %>
                <li class="flex items-center justify-between gap-3 text-sm">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100 text-[11px] font-semibold"><%= lesson_index + 1 %></span>
                    <% if accessible %>
                      <%= link_to lesson.title_for(I18n.locale), dashboard_course_lesson_path(course, lesson, locale: I18n.locale), class: "text-gray-800 dark:text-gray-100 hover:text-violet-600 dark:hover:text-violet-300" %>
                    <% else %>
                      <span class="text-gray-500 dark:text-gray-400"><%= lesson.title_for(I18n.locale) %></span>
                    <% end %>
                  </div>
                  <div class="text-xs text-gray-500 dark:text-gray-400"><%= format_duration(lesson.duration_seconds) %></div>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if @course_modules.empty? %>
          <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.modules_empty") %></div>
        <% end %>
      </div>
    </div>
  </div>

  <aside class="space-y-6">
    <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5 space-y-4">
      <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.courses.details_title") %></div>
      <div class="flex flex-wrap gap-2">
        <%= render "dashboard/shared/filter_chip", label: t("dashboard.courses.meta.modules", count: @course_modules.size) %>
        <%= render "dashboard/shared/filter_chip", label: t("dashboard.courses.meta.lessons", count: lessons.size) %>
        <%= render "dashboard/shared/filter_chip",
                   label: t("dashboard.courses.meta.duration", duration: format_duration(lessons.sum { |lesson| lesson.duration_seconds.to_i })) %>
      </div>
      <% if accessible %>
        <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.access_granted") %></div>
      <% else %>
        <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.access_locked") %></div>
      <% end %>
      <% if !accessible && cta_plan.present? %>
        <%= link_to t("dashboard.courses.unlock_cta"), dashboard_plans_path(price_key: cta_plan.key), class: "btn bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white w-full" %>
      <% end %>
    </div>
  </aside>
</div>
