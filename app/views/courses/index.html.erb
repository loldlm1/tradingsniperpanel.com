<% content_for :title, "#{app_short_name} - #{t('dashboard.courses.index.title')}" %>
<% presenter = @index_presenter %>
<% cards = presenter.cards %>
<% pagy = presenter.pagy %>
<% filters = presenter.filters %>
<% active_tag = @filter_tag.to_s.downcase %>
<% active_class = "border-transparent bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-800" %>
<% chip_label = lambda do |label, count|
     safe_join([label, content_tag(:span, count, class: "ml-1 text-gray-400 dark:text-gray-500")])
   end %>

<div
  data-filterable
  data-page-size="<%= pagy.limit %>"
  data-current-page="<%= pagy.page %>"
  data-active-query="<%= j @filter_query.to_s %>"
  data-active-tag="<%= j active_tag %>"
>
  <!-- Page header -->
  <div class="sm:flex sm:justify-between sm:items-center mb-5">
    <!-- Left: Title -->
    <div class="mb-4 sm:mb-0">
      <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.courses.index.title") %></h1>
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.index.subtitle") %></p>
    </div>

    <!-- Right: Actions -->
    <div class="grid grid-flow-col sm:auto-cols-max justify-start sm:justify-end gap-2">
      <!-- Search form -->
      <form class="relative" data-filter-form>
        <label for="course-search" class="sr-only"><%= t("dashboard.courses.index.search_label") %></label>
        <input
          id="course-search"
          class="form-input pl-9 bg-white dark:bg-gray-800"
          type="search"
          placeholder="<%= t("dashboard.courses.index.search_placeholder") %>"
          data-filter-input
          value="<%= @filter_query %>"
        />
        <button class="absolute inset-0 right-auto group" type="submit" aria-label="<%= t("dashboard.courses.index.search_label") %>">
          <svg class="shrink-0 fill-current text-gray-400 dark:text-gray-500 group-hover:text-gray-500 dark:group-hover:text-gray-400 ml-3 mr-2" width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 14c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7zM7 2C4.243 2 2 4.243 2 7s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5z" />
            <path d="M15.707 14.293L13.314 11.9a8.019 8.019 0 01-1.414 1.414l2.393 2.393a.997.997 0 001.414 0 .999.999 0 000-1.414z" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <% if cards.any? %>
    <!-- More actions -->
    <div class="sm:flex sm:justify-between sm:items-center mb-5">
      <!-- Left side -->
      <div class="mb-4 sm:mb-0">
        <ul class="flex flex-wrap -m-1">
          <li class="m-1">
            <%= render "dashboard/shared/filter_chip",
                       label: chip_label.call(t("dashboard.courses.filters.all"), presenter.total_count),
                       href: dashboard_courses_path(locale: I18n.locale),
                       class_name: active_tag.blank? ? active_class : "",
                       data: { filter_all: true, filter_active_class: active_class } %>
          </li>
          <% filters.each do |filter| %>
            <% normalized = filter.value.to_s.downcase %>
            <li class="m-1">
              <%= render "dashboard/shared/filter_chip",
                         label: chip_label.call(filter.label, filter.count),
                         href: dashboard_courses_path(locale: I18n.locale, tag: filter.value),
                         class_name: normalized == active_tag ? active_class : "",
                         data: { filter_tag: normalized, filter_active_class: active_class } %>
            </li>
          <% end %>
        </ul>
      </div>

      <!-- Right side -->
      <div class="grid grid-flow-col sm:auto-cols-max justify-start sm:justify-end gap-2">
        <!-- Dropdown -->
        <div
          class="relative"
          x-data="{
              open: false,
              selected: 0,
              options: [
                  { label: '<%= j t("dashboard.courses.sort.recent") %>', value: 'recent' },
                  { label: '<%= j t("dashboard.courses.sort.oldest") %>', value: 'oldest' }
              ],
              init() {
                  const saved = localStorage.getItem('courses-sort');
                  const index = this.options.findIndex(option => option.value === saved);
                  if (index >= 0) {
                      this.selected = index;
                  }
                  this.setSort(this.options[this.selected].value);
              },
              setSort(value) {
                  localStorage.setItem('courses-sort', value);
                  this.$dispatch('course-sort', { order: value });
              }
          }"
        >
          <button
            class="btn justify-between min-w-44 bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-600 hover:text-gray-800 dark:text-gray-300 dark:hover:text-gray-100"
            aria-label="<%= t("dashboard.courses.sort.label") %>"
            aria-haspopup="true"
            @click.prevent="open = !open"
            :aria-expanded="open"
          >
            <span class="flex items-center">
              <svg class="fill-current text-gray-400 dark:text-gray-500 shrink-0 mr-2" width="16" height="16" viewBox="0 0 16 16">
                <path d="M5 4a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2H5Z" />
                <path d="M4 0a4 4 0 0 0-4 4v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V4a4 4 0 0 0-4-4H4ZM2 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4Z" />
              </svg>
              <span x-text="options[selected].label"></span>
            </span>
            <svg class="shrink-0 ml-1 fill-current text-gray-400 dark:text-gray-500" width="11" height="7" viewBox="0 0 11 7">
              <path d="M5.4 6.8L0 1.4 1.4 0l4 4 4-4 1.4 1.4z" />
            </svg>
          </button>
          <div
            class="z-10 absolute top-full right-0 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700/60 py-1.5 rounded-lg shadow-lg overflow-hidden mt-1"
            @click.outside="open = false"
            @keydown.escape.window="open = false"
            x-show="open"
            x-transition:enter="transition ease-out duration-100 transform"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-out duration-100"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            x-cloak
          >
            <div class="font-medium text-sm text-gray-600 dark:text-gray-300">
              <button
                tabindex="0"
                class="flex items-center w-full hover:bg-gray-50 dark:hover:bg-gray-700/20 py-1 px-3 cursor-pointer"
                :class="selected === 0 && 'text-violet-500'"
                @click="selected = 0;open = false;setSort(options[0].value)"
                @focus="open = true"
                @focusout="open = false"
              >
                <svg class="shrink-0 mr-2 fill-current text-violet-500" :class="selected !== 0 && 'invisible'" width="12" height="9" viewBox="0 0 12 9">
                  <path d="M10.28.28L3.989 6.575 1.695 4.28A1 1 0 00.28 5.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28.28z" />
                </svg>
                <span><%= t("dashboard.courses.sort.recent") %></span>
              </button>
              <button
                tabindex="0"
                class="flex items-center w-full hover:bg-gray-50 dark:hover:bg-gray-700/20 py-1 px-3 cursor-pointer"
                :class="selected === 1 && 'text-violet-500'"
                @click="selected = 1;open = false;setSort(options[1].value)"
                @focus="open = true"
                @focusout="open = false"
              >
                <svg class="shrink-0 mr-2 fill-current text-violet-500" :class="selected !== 1 && 'invisible'" width="12" height="9" viewBox="0 0 12 9">
                  <path d="M10.28.28L3.989 6.575 1.695 4.28A1 1 0 00.28 5.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28.28z" />
                </svg>
                <span><%= t("dashboard.courses.sort.oldest") %></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div
      class="grid xl:grid-cols-2 gap-6 mb-8"
      x-data="{
          sort: 'recent',
          init() {
              const saved = localStorage.getItem('courses-sort');
              const order = saved === 'oldest' ? 'oldest' : 'recent';
              this.sortItems(order);
          },
          sortItems(order) {
              this.sort = order;
              const items = Array.from(this.$el.children);
              const parseTime = (item) => {
                  const value = item.dataset.publishedAt;
                  const time = value ? Date.parse(value) : 0;
                  return Number.isNaN(time) ? 0 : time;
              };
              const parsePosition = (item) => {
                  const value = parseInt(item.dataset.position || '9999', 10);
                  return Number.isNaN(value) ? 9999 : value;
              };
              const parseSlug = (item) => item.dataset.slug || '';
              items.sort((a, b) => {
                  const timeA = parseTime(a);
                  const timeB = parseTime(b);
                  if (timeA !== timeB) {
                      return order === 'oldest' ? timeA - timeB : timeB - timeA;
                  }
                  const posA = parsePosition(a);
                  const posB = parsePosition(b);
                  if (posA !== posB) {
                      return posA - posB;
                  }
                  return parseSlug(a).localeCompare(parseSlug(b));
              });
              items.forEach((item) => this.$el.appendChild(item));
          }
      }"
      @course-sort.window="sortItems($event.detail.order)"
    >
      <% cards.each do |card| %>
        <%= render "courses/index_card", card: card %>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if pagy.pages > 1 %>
      <div data-filter-pagination>
        <%= pagy_mosaic_nav(pagy) %>
      </div>
    <% end %>
  <% else %>
    <!-- Content -->
    <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
      <div class="mx-auto w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-700/60 flex items-center justify-center text-gray-600 dark:text-gray-200">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M5 4.5A2.5 2.5 0 0 1 7.5 2h9A2.5 2.5 0 0 1 19 4.5V18a3 3 0 0 0-3-3H7.5A2.5 2.5 0 0 1 5 12.5V4.5Zm11 0a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5H16a3 3 0 0 1 3 3V4.5Z" />
          <path d="M8 6h7v1H8V6Zm0 3h9v1H8V9Zm0 3h8v1H8v-1Z" />
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mt-4"><%= t("dashboard.courses.index.empty_title") %></h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.courses.index.empty_copy") %></p>
      <div class="mt-4">
        <%= link_to t("dashboard.courses.index.empty_cta"), dashboard_support_path, class: "btn-sm bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
      </div>
    </div>
  <% end %>
</div>
