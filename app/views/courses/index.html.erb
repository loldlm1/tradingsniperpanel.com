<% content_for :title, "#{app_short_name} - #{t('dashboard.courses.index.title')}" %>

<div class="sm:flex sm:justify-between sm:items-start mb-6">
  <div class="mb-4 sm:mb-0">
    <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.courses.index.title") %></h1>
    <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.index.subtitle") %></p>
  </div>
</div>

<% if @course_entries.present? %>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <% @course_entries.each do |entry| %>
      <% course = entry.course %>
      <% modules_count = course.course_modules.size %>
      <% lessons = course.course_lessons %>
      <% lessons_count = lessons.size %>
      <% duration_seconds = lessons.sum { |lesson| lesson.duration_seconds.to_i } %>
      <% badge_label = if course.subscription_tiers.blank?
                        t("dashboard.courses.badges.free")
                      elsif entry.accessible
                        t("dashboard.courses.badges.unlocked")
                      else
                        t("dashboard.courses.badges.locked")
                      end %>
      <% badge_class = if course.subscription_tiers.blank?
                        "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-100"
                      elsif entry.accessible
                        "bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-100"
                      else
                        "bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-200"
                      end %>
      <div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl border border-gray-200 dark:border-gray-700 p-5 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100"><%= course.title_for(I18n.locale) %></h2>
              <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.courses.categories.#{course.category}", default: course.category.to_s.humanize) %></div>
            </div>
            <span class="px-2 py-1 rounded-full text-xs font-semibold <%= badge_class %>"><%= badge_label %></span>
          </div>
          <% summary = course.summary_for(I18n.locale).presence || course.description_for(I18n.locale) %>
          <% if summary.present? %>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed"><%= truncate(summary, length: 140) %></p>
          <% end %>
          <div class="flex flex-wrap items-center gap-2 text-xs text-gray-600 dark:text-gray-300">
            <span class="inline-flex items-center px-2 py-1 rounded-full bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700"><%= t("dashboard.courses.meta.modules", count: modules_count) %></span>
            <span class="inline-flex items-center px-2 py-1 rounded-full bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700"><%= t("dashboard.courses.meta.lessons", count: lessons_count) %></span>
            <span class="inline-flex items-center px-2 py-1 rounded-full bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700"><%= t("dashboard.courses.meta.duration", duration: format_duration(duration_seconds)) %></span>
          </div>
          <% if entry.progress_percent.present? && entry.progress_percent.positive? %>
            <div class="text-xs text-gray-500 dark:text-gray-400"><%= t("dashboard.courses.progress_label", percent: entry.progress_percent) %></div>
          <% end %>
        </div>
        <div class="mt-4 flex items-center justify-between">
          <%= link_to t("dashboard.courses.view_cta"), dashboard_course_path(course, locale: I18n.locale), class: "text-violet-600 hover:text-violet-800 dark:text-violet-300 dark:hover:text-violet-100 text-sm font-semibold" %>
          <% unless entry.accessible %>
            <% cta_plan = entry.cta_plan %>
            <% if cta_plan.present? %>
              <%= link_to t("dashboard.courses.unlock_cta"), dashboard_plans_path(price_key: cta_plan.key), class: "btn-xs bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
    <div class="mx-auto w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-700/60 flex items-center justify-center text-gray-600 dark:text-gray-200">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M5 4.5A2.5 2.5 0 0 1 7.5 2h9A2.5 2.5 0 0 1 19 4.5V18a3 3 0 0 0-3-3H7.5A2.5 2.5 0 0 1 5 12.5V4.5Zm11 0a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5H16a3 3 0 0 1 3 3V4.5Z" />
        <path d="M8 6h7v1H8V6Zm0 3h9v1H8V9Zm0 3h8v1H8v-1Z" />
      </svg>
    </div>
    <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mt-4"><%= t("dashboard.courses.index.empty_title") %></h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.courses.index.empty_copy") %></p>
    <div class="mt-4">
      <%= link_to t("dashboard.courses.index.empty_cta"), dashboard_support_path, class: "btn-sm bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
    </div>
  </div>
<% end %>
