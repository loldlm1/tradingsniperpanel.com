<% card = local_assigns.fetch(:card) %>
<% expert_advisor = card.expert_advisor %>
<% item_classes = ["flex flex-col bg-white dark:bg-gray-800 shadow-xs rounded-xl overflow-hidden"] %>
<% item_classes << "hidden" unless card.visible_by_default %>
<% tag_list = card.tag_list.join("|") %>
<% addons_progress = t("dashboard.expert_advisors.addons.progress", owned: card.addons_owned_count, total: card.addons_total_count) %>
<% download_label = t("dashboard.expert_advisors.download_bundle") %>
<% download_class = "btn w-full justify-center bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
<% download_disabled_class = "btn w-full justify-center bg-gray-900 text-gray-100 dark:bg-gray-100 dark:text-gray-800 opacity-60 cursor-not-allowed" %>
<% addon_purchase_class = "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
<% addon_owned_class = "inline-flex items-center justify-center text-xs font-medium px-3 py-1.5 rounded-full bg-gray-100 dark:bg-gray-700/60 text-gray-400 dark:text-gray-500" %>
<% tag_chip_class = "border-gray-200 dark:border-gray-700/60 bg-gray-100 dark:bg-gray-700/60 text-gray-600 dark:text-gray-300" %>
<% tag_chip_extra_class = "text-xs px-2.5 py-1" %>
<% status_chip_class = "#{card.status_class} border-gray-200 dark:border-gray-700/60" %>
<% status_chip_extra_class = "text-xs px-2 py-0.5 leading-4 whitespace-nowrap" %>
<% copy_label = t("dashboard.expert_advisors.copy_code") %>
<% copied_label = t("dashboard.expert_advisors.copied") %>
<% copy_button_class = "inline-flex items-center justify-center text-xs font-medium px-3 py-1.5 rounded-full border border-gray-200 dark:border-gray-700/60 text-gray-600 dark:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600 min-w-[88px]" %>
<% copy_button_disabled_class = "inline-flex items-center justify-center text-xs font-medium px-3 py-1.5 rounded-full border border-gray-200 dark:border-gray-700/60 text-gray-400 dark:text-gray-500 cursor-not-allowed min-w-[88px]" %>

<!-- Item <%= card.index + 1 %> -->
<article
  class="<%= item_classes.join(" ") %>"
  data-filter-item="true"
  data-filter-text="<%= j card.search_text.to_s %>"
  data-filter-tags="<%= j tag_list %>"
  data-filter-index="<%= card.index %>"
>
  <!-- Section: Header -->
  <div class="p-5 border-b border-gray-100 dark:border-gray-700/60">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide text-violet-500 mb-2"><%= card.type_label %></div>
        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100"><%= expert_advisor.name %></h3>
        <% if expert_advisor.description.present? %>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= expert_advisor.description %></p>
        <% end %>
        <!-- Section: Meta -->
        <% if card.meta_tags.any? %>
          <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
            <% card.meta_tags.each do |tag| %>
              <%= render "dashboard/shared/filter_chip",
                         label: tag,
                         class_name: tag_chip_class,
                         extra_class: tag_chip_extra_class,
                         interactive: false %>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="flex flex-col items-end gap-2 shrink-0">
        <%= render "dashboard/shared/filter_chip",
                   label: card.status_label,
                   class_name: status_chip_class,
                   extra_class: status_chip_extra_class,
                   interactive: false %>
      </div>
    </div>
  </div>

  <!-- Section: Body -->
  <div class="p-5 border-b border-gray-100 dark:border-gray-700/60">
    <div class="grid gap-6 md:grid-cols-2">
      <!-- Section: Guia -->
      <div>
        <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.expert_advisors.index.guide_title") %></div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= card.guide_copy %></p>
        <div class="mt-4 flex flex-col gap-2">
          <div class="grid grid-cols-2 gap-2">
            <%= link_to card.guide_cta_label, card.guide_url, class: "btn w-full justify-center bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
            <%= link_to t("dashboard.expert_advisors.show_cta"), card.details_url, class: "btn w-full justify-center bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600" %>
          </div>
          <% if card.download_enabled %>
            <%= link_to download_label, card.download_url, class: download_class %>
          <% else %>
            <button class="<%= download_disabled_class %>" type="button" disabled><%= download_label %></button>
          <% end %>
        </div>
      </div>

      <!-- Section: Progreso de Adons -->
      <div>
        <div class="flex items-center justify-between">
          <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.expert_advisors.addons.title") %></div>
          <div class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= addons_progress %></div>
        </div>
        <div class="mt-2 w-full h-2 bg-gray-100 dark:bg-gray-700/60 rounded-full">
          <div class="h-2 rounded-full bg-violet-500" style="width: <%= card.addons_progress_percent %>%;"></div>
        </div>
        <ul class="mt-4 space-y-2">
          <% card.addon_items.each do |addon| %>
            <li class="flex items-center justify-between gap-3">
              <span class="text-sm text-gray-700 dark:text-gray-400"><%= addon.title %></span>
              <% if addon.owned %>
                <button class="<%= addon_owned_class %>" type="button" disabled><%= t("dashboard.expert_advisors.addons.owned_cta") %></button>
              <% elsif addon.purchase_url.present? %>
                <%= link_to t("dashboard.expert_advisors.addons.purchase_cta"), addon.purchase_url, class: addon_purchase_class %>
              <% else %>
                <button class="<%= addon_owned_class %>" type="button" disabled><%= t("dashboard.expert_advisors.addons.purchase_cta") %></button>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <!-- Section: Licencia -->
  <div class="p-5">
    <div class="flex flex-col gap-2">
      <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.expert_advisors.license.title") %></div>
      <div class="flex items-center gap-3">
        <div class="flex-1 min-w-0">
          <div class="flex items-center rounded-lg border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 font-mono text-sm text-gray-800 dark:text-gray-100">
            <span class="truncate" data-license-value title="<%= card.license_display %>"><%= card.license_display %></span>
          </div>
        </div>
        <% if card.license_copy_enabled %>
          <button
            class="<%= copy_button_class %>"
            type="button"
            data-copy-text="<%= j card.license_copy_text %>"
            data-default-text="<%= copy_label %>"
            data-copied-text="<%= copied_label %>"
            data-reset-after-ms="3000"
            onclick="copyToClipboard(this)"
            aria-live="polite"
          ><%= copy_label %></button>
        <% else %>
          <button
            class="<%= copy_button_disabled_class %>"
            type="button"
            disabled
          ><%= copy_label %></button>
        <% end %>
      </div>
      <div class="text-xs text-gray-500 dark:text-gray-400"><%= card.license_hint %></div>
    </div>
  </div>
</article>
