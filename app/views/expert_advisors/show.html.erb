<% content_for :title, t("dashboard.expert_advisors.show_page_title", name: @expert_advisor.name, app: app_short_name) %>
<% presenter = @show_presenter %>

<!-- Page header -->
<div class="sm:flex sm:justify-between sm:items-center mb-5">
  <!-- Left: Title -->
  <div class="mb-4 sm:mb-0">
    <div class="mb-6">
      <%= link_to dashboard_expert_advisors_path(locale: I18n.locale), class: "inline-flex items-center gap-2 text-sm font-semibold text-brand-400 hover:text-brand-300" do %>
        <span><%= t("dashboard.expert_advisors.show.back") %></span>
      <% end %>
    </div>
  </div>
</div>

<!-- Cards -->
<div class="grid grid-cols-12 gap-6">
  <!-- Main column -->
  <div class="col-span-full xl:col-span-8 flex flex-col gap-6">
    <!-- Item 1 -->
    <article class="bg-white dark:bg-gray-800 shadow-xs rounded-xl p-6">
      <div class="flex flex-col gap-4">
        <!-- Header: Left side -->
        <div>
          <div class="text-xs uppercase text-gray-500 dark:text-gray-400 tracking-wide"><%= t("dashboard.expert_advisors.show.system_info") %></div>
          <div class="mt-1 flex w-full flex-wrap items-center justify-between gap-3">
            <h2 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= presenter.expert_advisor.name %></h2>
            <!-- Header: Right side -->
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="inline-flex items-center rounded-full font-medium px-2.5 py-1 <%= presenter.status_badge_class %>">
                <%= presenter.system_status_label %>
              </span>
              <%= render "dashboard/shared/filter_chip",
                label: t("dashboard.expert_advisors.show.type_label", type: presenter.type_label),
                interactive: false,
                extra_class: "text-xs" %>
            </div>
          </div>
          <div class="text-sm font-semibold text-gray-700 dark:text-gray-200 mt-3"><%= t("dashboard.expert_advisors.show.description_label") %></div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
            <%= presenter.description || t("dashboard.expert_advisors.show.description_missing") %>
          </p>
        </div>
      </div>

      <!-- Section: System details -->
      <div class="mt-6 border border-gray-100 dark:border-gray-700/60 rounded-lg p-4">
        <div class="text-sm font-semibold text-gray-700 dark:text-gray-200"><%= t("dashboard.expert_advisors.show.details_title") %></div>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <% presenter.system_details.each do |detail| %>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500 dark:text-gray-400"><%= detail[:label] %></span>
              <span class="font-medium text-gray-800 dark:text-gray-100"><%= detail[:value] %></span>
            </div>
          <% end %>
        </div>
      </div>
    </article>

    <!-- Item 3 -->
    <!-- Line chart (Portfolio Returns) -->
    <div class="flex flex-col bg-white dark:bg-gray-800 shadow-xs rounded-xl">
      <!-- Header: Title -->
      <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-center">
        <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.expert_advisors.show.pnl_title") %></h2>
      </header>
      <% pnl = presenter.pnl_summary %>
      <div class="px-5 py-3">
        <div class="flex flex-wrap justify-between items-end gap-y-2 gap-x-4">
          <div class="flex items-center">
            <div class="text-3xl font-bold text-gray-800 dark:text-gray-100 mr-2"><%= pnl[:total] %></div>
            <div class="text-sm text-gray-500 dark:text-gray-400">
              <span class="font-medium text-gray-800 dark:text-gray-100"><%= pnl[:average] %></span>
              <%= t("dashboard.expert_advisors.show.pnl_average_label") %>
            </div>
          </div>
          <div id="fintech-card-01-legend" class="grow mb-1">
            <ul class="flex flex-wrap gap-x-4 sm:justify-end"></ul>
          </div>
        </div>
      </div>
      <!-- Chart built with Chart.js 3 -->
      <!-- Check out src/js/fintech-charts.js for config -->
      <div class="grow">
        <% if pnl[:chart].present? %>
          <canvas
            id="fintech-card-01"
            width="800"
            height="300"
            data-dashboard-chart="true"
            data-chart="<%= json_escape(pnl[:chart].to_json) %>"
            data-chart-style="main-line"
            data-chart-format="currency"
          ></canvas>
        <% else %>
          <div class="h-[300px] flex items-center justify-center text-sm text-gray-500 dark:text-gray-400">
            <%= t("dashboard.expert_advisors.show.pnl_empty") %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Item 5 -->
    <%= render "expert_advisors/show_addons", presenter: presenter %>
  </div>

  <!-- Sidebar column -->
  <div class="col-span-full xl:col-span-4 flex flex-col gap-6">
    <!-- Item 2 -->
    <article class="bg-white dark:bg-gray-800 shadow-xs rounded-xl p-4">
      <!-- Header: Title -->
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.expert_advisors.show.guide_title") %></h2>
      </div>
      <!-- Section: Guide -->
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
        <%= presenter.guide_copy %>
      </p>
      <!-- Section: Actions -->
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        <% if presenter.accessible? %>
          <%= link_to t("dashboard.expert_advisors.guide_cta"), presenter.guide_url, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        <% else %>
          <%= link_to t("dashboard.expert_advisors.unlock_cta"), presenter.unlock_url, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        <% end %>

        <% if presenter.download_enabled? %>
          <%= link_to t("dashboard.expert_advisors.download_bundle"), presenter.download_url, class: "btn bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600" %>
        <% else %>
          <button class="btn bg-white dark:bg-gray-800 text-gray-400 dark:text-gray-500 border border-gray-200 dark:border-gray-700/60" type="button" disabled>
            <%= t("dashboard.expert_advisors.download_bundle") %>
          </button>
        <% end %>
      </div>
    </article>

    <!-- Item 4 -->
    <!-- Visible solo cuando el sistema esta activo -->
    <%= render "expert_advisors/show_license_card", presenter: presenter %>

    <!-- Pie chart (Portfolio Value) -->
    <% balance = presenter.balance_summary %>
    <div class="flex flex-col col-span-full sm:col-span-6 xl:col-span-4 bg-white dark:bg-gray-800 shadow-xs rounded-xl">
      <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-center">
        <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.expert_advisors.show.balance_title") %></h2>
      </header>
      <div class="px-5 py-3">
        <div class="text-sm italic mb-2"><%= t("dashboard.expert_advisors.show.balance_copy") %></div>
        <div class="text-3xl font-bold text-gray-800 dark:text-gray-100"><%= balance[:total] %></div>
      </div>
      <!-- Chart built with Chart.js 3 -->
      <!-- Check out src/js/fintech-charts.js for config -->
      <div class="grow flex flex-col justify-center">
        <% if balance[:chart].present? %>
          <div>
            <!-- Change the height attribute to adjust the chart height -->
            <canvas
              id="fintech-card-09"
              width="389"
              height="220"
              data-dashboard-chart="true"
              data-chart="<%= json_escape(balance[:chart].to_json) %>"
              data-chart-style="pie"
              data-chart-format="currency"
            ></canvas>
          </div>
        <% else %>
          <div class="h-[220px] flex items-center justify-center text-sm text-gray-500 dark:text-gray-400">
            <%= t("dashboard.expert_advisors.show.balance_empty") %>
          </div>
        <% end %>
        <div id="fintech-card-09-legend" class="px-5 py-4">
          <ul class="flex flex-wrap justify-center -m-1"></ul>
        </div>
      </div>
    </div>
  </div>

</div>
