<% content_for :title, "#{app_short_name} - #{t('dashboard.expert_advisors.index.title')}" %>
<% presenter = @index_presenter %>
<% cards = presenter.cards %>
<% pagy = presenter.pagy %>
<% tag_filters = presenter.tag_filters %>
<% active_tag = @filter_tag.to_s.downcase %>
<% count_template = t("dashboard.expert_advisors.index.count_template") %>
<% active_class = "border-transparent bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-800" %>

<div
  data-filterable
  data-page-size="<%= pagy.items %>"
  data-current-page="<%= pagy.page %>"
  data-active-query="<%= j @filter_query.to_s %>"
  data-active-tag="<%= j active_tag %>"
>
  <!-- Page header -->
  <div class="sm:flex sm:justify-between sm:items-center mb-5">
    <!-- Left: Title -->
    <div class="mb-4 sm:mb-0">
      <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.expert_advisors.index.title") %></h1>
    </div>

    <!-- Right: Actions -->
    <div class="grid grid-flow-col sm:auto-cols-max justify-start sm:justify-end gap-2">
      <!-- Search form -->
      <form class="relative" data-filter-form>
        <label for="action-search" class="sr-only"><%= t("dashboard.expert_advisors.index.search_label") %></label>
        <input
          id="action-search"
          class="form-input pl-9 bg-white dark:bg-gray-800"
          type="search"
          placeholder="<%= t("dashboard.expert_advisors.index.search_placeholder") %>"
          data-filter-input
          value="<%= @filter_query %>"
        />
        <button class="absolute inset-0 right-auto group" type="submit" aria-label="<%= t("dashboard.expert_advisors.index.search_label") %>">
          <svg class="shrink-0 fill-current text-gray-400 dark:text-gray-500 group-hover:text-gray-500 dark:group-hover:text-gray-400 ml-3 mr-2" width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 14c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7zM7 2C4.243 2 2 4.243 2 7s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5z" />
            <path d="M15.707 14.293L13.314 11.9a8.019 8.019 0 01-1.414 1.414l2.393 2.393a.997.997 0 001.414 0 .999.999 0 000-1.414z" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Filters -->
  <div class="mb-5">
    <ul class="flex flex-wrap -m-1">
        <li class="m-1">
          <%= render "dashboard/shared/filter_chip",
                     label: t("dashboard.expert_advisors.filters.all"),
                     href: dashboard_expert_advisors_path(locale: I18n.locale),
                     class_name: active_tag.blank? ? active_class : "",
                     data: { filter_all: true, filter_active_class: active_class } %>
        </li>
      <% tag_filters.each do |tag| %>
        <% normalized_tag = tag.to_s.downcase %>
        <li class="m-1">
          <%= render "dashboard/shared/filter_chip",
                     label: tag,
                     href: dashboard_expert_advisors_path(locale: I18n.locale, tag: tag),
                     class_name: normalized_tag == active_tag ? active_class : "",
                     data: { filter_tag: normalized_tag, filter_active_class: active_class } %>
        </li>
      <% end %>
    </ul>
  </div>

  <div
    class="text-sm text-gray-500 dark:text-gray-400 italic mb-4"
    data-filter-count
    data-count-template="<%= count_template %>"
  ><%= count_template % { count: presenter.total_count } %></div>

  <!-- Content -->
  <div class="grid xl:grid-cols-2 gap-6 mb-8">
    <% cards.each do |card| %>
      <%= render "expert_advisors/index_card", card: card %>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if pagy.pages > 1 %>
    <div data-filter-pagination>
      <%= pagy_mosaic_nav(pagy) %>
    </div>
  <% end %>
</div>
