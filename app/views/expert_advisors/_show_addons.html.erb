<% addons = presenter.addons_summary %>
<article class="col-span-full bg-white dark:bg-gray-800 shadow-xs rounded-xl p-6">
  <!-- Header: Title -->
  <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.expert_advisors.show.addons_title") %></h2>
  <!-- Section: Progreso de Adons -->
  <div class="mt-4">
    <div class="flex items-center justify-between">
      <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.expert_advisors.addons.title") %></div>
      <div class="text-xs font-medium text-gray-500 dark:text-gray-400">
        <%= t("dashboard.expert_advisors.addons.progress", owned: addons[:owned_count], total: addons[:total_count]) %>
      </div>
    </div>
    <div class="mt-2 w-full h-2 bg-gray-100 dark:bg-gray-700/60 rounded-full">
      <div class="h-2 rounded-full bg-teal-500" style="width: <%= addons[:progress_percent] %>%;"></div>
    </div>
    <!-- Section: List -->
    <% if addons[:items].present? %>
      <ul class="mt-4 space-y-2">
        <% addons[:items].each do |item| %>
          <li class="flex items-center justify-between gap-3">
            <span class="text-sm text-gray-700 dark:text-gray-400"><%= item.title %></span>
            <% if item.owned %>
              <button class="inline-flex items-center justify-center text-xs font-medium px-3 py-1.5 rounded-full bg-gray-100 dark:bg-gray-700/60 text-gray-400 dark:text-gray-500" type="button" disabled>
                <%= t("dashboard.expert_advisors.addons.owned_cta") %>
              </button>
            <% elsif item.purchase_url.present? %>
              <%= link_to t("dashboard.expert_advisors.addons.purchase_cta"), item.purchase_url, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
            <% else %>
              <button class="btn bg-gray-900 text-gray-100 opacity-60 cursor-not-allowed dark:bg-gray-100 dark:text-gray-800" type="button" disabled>
                <%= t("dashboard.expert_advisors.addons.purchase_cta") %>
              </button>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.expert_advisors.show.addons_empty") %></p>
    <% end %>
  </div>
</article>
