<% storage_key = ["discount-modal", banner[:percent], banner[:code].to_s.parameterize(separator: "-")].join("-") %>

<section
  aria-label="<%= t("landing.neon.discount_modal.aria_label") %>"
  x-data="{
    modalOpen: false,
    storageKey: '<%= storage_key %>',
    init() {
      let alreadySeen = false
      try {
        alreadySeen = window.sessionStorage.getItem(this.storageKey) === '1'
      } catch (error) {
        alreadySeen = false
      }
      if (alreadySeen) return

      this.modalOpen = true
      try {
        window.sessionStorage.setItem(this.storageKey, '1')
      } catch (error) {
        // no-op: keep modal behavior even when storage is restricted
      }
    },
    close() {
      this.modalOpen = false
    }
  }"
>
  <div
    class="fixed inset-0 bg-gray-900/70 z-50 transition-opacity"
    x-show="modalOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-out duration-100"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    aria-hidden="true"
    @click="close"
    x-cloak
  ></div>

  <div
    id="discount-marketing-modal"
    class="fixed inset-0 z-50 overflow-hidden flex items-start justify-center pt-24 sm:pt-28 px-4 sm:px-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="discount-modal-title"
    x-show="modalOpen"
    x-transition:enter="transition ease-in-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in-out duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-4"
    x-cloak
  >
    <div
      class="relative overflow-auto max-w-xl w-full rounded-2xl border border-blue-500/30 bg-gray-900/95 shadow-2xl shadow-blue-500/10 backdrop-blur"
      @click.outside="close"
      @keydown.escape.window="close"
    >
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-blue-400 via-emerald-300 to-fuchsia-400"></div>

      <div class="px-6 py-6 sm:px-7 sm:py-7">
        <div class="flex items-start justify-between gap-4">
          <span class="inline-flex items-center rounded-full border border-emerald-400/40 bg-emerald-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-200">
            <%= t("landing.neon.discount_modal.badge") %>
          </span>

          <button
            type="button"
            class="text-gray-400 transition hover:text-gray-200"
            @click="close"
          >
            <span class="sr-only"><%= t("landing.neon.discount_modal.close") %></span>
            <svg class="h-5 w-5 fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7.95 6.536l4.242-4.243a1 1 0 111.415 1.414L9.364 7.95l4.243 4.242a1 1 0 11-1.415 1.415L7.95 9.364l-4.243 4.243a1 1 0 01-1.414-1.415L6.536 7.95 2.293 3.707a1 1 0 011.414-1.414L7.95 6.536z" />
            </svg>
          </button>
        </div>

        <h2 id="discount-modal-title" class="mt-4 text-2xl font-uncut-sans text-gray-100 sm:text-3xl">
          <%= t("landing.neon.discount_modal.title", percent: banner[:percent]) %>
        </h2>

        <p class="mt-3 text-sm text-gray-300 sm:text-base">
          <%= t("landing.neon.discount_modal.body") %>
        </p>

        <div class="mt-5 rounded-xl border border-gray-700 bg-gray-800/80 px-4 py-3">
          <p class="text-xs uppercase tracking-wide text-gray-400"><%= t("landing.neon.discount_modal.code_label") %></p>
          <p class="mt-1 text-xl font-semibold text-emerald-300"><%= banner[:code] %></p>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#pricing"
            class="btn text-white bg-linear-to-t from-blue-600 to-blue-400 hover:to-blue-500 shadow-lg justify-center"
            @click="close"
          ><%= t("landing.neon.discount_modal.cta") %></a>
          <button
            type="button"
            class="btn border-gray-700 text-gray-200 hover:border-gray-600 hover:text-white justify-center"
            @click="close"
          ><%= t("landing.neon.discount_modal.dismiss") %></button>
        </div>
      </div>
    </div>
  </div>
</section>
