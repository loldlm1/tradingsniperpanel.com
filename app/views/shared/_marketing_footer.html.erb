<footer>
  <% contact_links = support_contact_links %>
  <% show_contact = contact_links.any? %>
  <% show_merchant = brand_legal_name.present? || brand_full_address.present? %>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid sm:grid-cols-12 gap-8 py-8 md:py-12">
      <div class="sm:col-span-12 lg:col-span-4 lg:max-w-xs">
        <div class="mb-2">
          <%= link_to root_path, class: "inline-flex", "aria-label": app_name do %>
            <%= render "shared/marketing_logo", logo_class: "w-12 h-12 object-contain" %>
          <% end %>
        </div>
        <div class="text-sm text-gray-600">
          <%= link_to t("footer.terms"), terms_path, class: "text-gray-400 hover:text-blue-500 transition duration-150 ease-in-out" %>
          &middot;
          <%= link_to t("footer.privacy"), privacy_path, class: "text-gray-400 hover:text-blue-500 transition duration-150 ease-in-out" %>
          &middot;
          <%= link_to t("footer.refunds"), refunds_and_cancellations_path, class: "text-gray-400 hover:text-blue-500 transition duration-150 ease-in-out" %>
        </div>
      </div>

      <% if show_contact %>
        <div class="sm:col-span-12 lg:col-span-4">
          <div class="text-xs uppercase tracking-widest text-gray-500 mb-3"><%= t("footer.contact.title") %></div>
          <div class="text-sm text-gray-400 space-y-2">
            <% contact_links.each do |link| %>
              <div>
                <%= link_to link[:label], link[:url], class: "hover:text-blue-500 transition duration-150 ease-in-out", target: "_blank", rel: "noopener" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if show_merchant %>
        <div class="sm:col-span-12 lg:col-span-4">
          <div class="text-xs uppercase tracking-widest text-gray-500 mb-3"><%= t("footer.merchant.title") %></div>
          <div class="text-sm text-gray-400 space-y-2">
            <% if brand_display_name.present? %>
              <div><%= brand_display_name %></div>
            <% end %>
            <% if brand_full_address.present? %>
              <div><%= brand_full_address %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</footer>
