<section aria-label="<%= t("landing.neon.discount_banner.aria_label") %>" class="relative z-20 border-b border-emerald-500/30 bg-gradient-to-r from-emerald-900/40 via-gray-900 to-blue-900/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
    <div class="flex flex-col gap-2 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <p class="text-sm text-emerald-100">
        <span class="font-semibold"><%= t("landing.neon.discount_banner.title", percent: banner[:percent]) %></span>
        <span class="text-emerald-200"><%= t("landing.neon.discount_banner.body", code: banner[:code]) %></span>
      </p>
      <%= link_to t("landing.neon.discount_banner.cta"), "#pricing", class: "inline-flex items-center justify-center rounded-full border border-emerald-400/60 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-100 transition hover:bg-emerald-400/10" %>
    </div>
  </div>
</section>
