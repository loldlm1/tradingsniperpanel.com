<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: separate;">
  <tr>
    <td align="center" bgcolor="<%= background_color %>" style="border-radius: 999px;">
      <a href="<%= url %>" style="display: inline-block; padding: 14px 22px; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; font-weight: 700; line-height: 1.2; color: <%= text_color %>; text-decoration: none; border-radius: 999px;">
        <%= label %>
      </a>
    </td>
  </tr>
</table>
