<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse;">
  <% detail_rows.each_with_index do |row, index| %>
    <tr>
      <td style="padding: <%= index.zero? ? '0' : '12px' %> 0 0; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 12px; line-height: 1.5; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #5b6572; vertical-align: top;">
        <%= row.fetch(:label) %>
      </td>
    </tr>
    <tr>
      <td style="padding: 4px 0 0; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; line-height: 1.7; color: #0f172a; vertical-align: top;">
        <%= row.fetch(:value) %>
      </td>
    </tr>
  <% end %>
</table>
