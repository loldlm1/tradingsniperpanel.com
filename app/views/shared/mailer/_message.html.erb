<%
tone = local_assigns.fetch(:tone, :info)
category = local_assigns[:category]
title = local_assigns.fetch(:title)
greeting = local_assigns[:greeting]
intro = local_assigns[:intro]
closing = local_assigns[:closing]
list_title = local_assigns[:list_title]
detail_rows = Array(local_assigns[:detail_rows]).compact
list_items = Array(local_assigns[:list_items]).compact_blank
paragraphs = Array(local_assigns[:paragraphs]).compact_blank
primary_action = local_assigns[:primary_action].presence
secondary_action = local_assigns[:secondary_action].presence

palette = case tone.to_s
when "success"
  {
    badge_background: "#ecfdf3",
    badge_color: "#047857",
    panel_background: "#f7fbf9",
    panel_border: "#cceede",
    button_background: "#0f766e",
    button_text: "#ffffff"
  }
when "warning"
  {
    badge_background: "#fff7ed",
    badge_color: "#c2410c",
    panel_background: "#fffaf5",
    panel_border: "#fed7aa",
    button_background: "#b45309",
    button_text: "#ffffff"
  }
else
  {
    badge_background: "#e8eefc",
    badge_color: "#22438f",
    panel_background: "#f8fafc",
    panel_border: "#dbe5f0",
    button_background: "#0f172a",
    button_text: "#ffffff"
  }
end
%>

<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse;">
  <% if category.present? %>
    <tr>
      <td style="padding-bottom: 16px;">
        <span style="display: inline-block; padding: 7px 12px; border-radius: 999px; background-color: <%= palette[:badge_background] %>; color: <%= palette[:badge_color] %>; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          <%= category %>
        </span>
      </td>
    </tr>
  <% end %>

  <tr>
    <td style="padding-bottom: 18px; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; line-height: 1.15; font-weight: 700; color: #0f172a;">
      <%= title %>
    </td>
  </tr>

  <% if greeting.present? %>
    <tr>
      <td style="padding-bottom: 12px; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7; color: #243041;">
        <%= greeting %>
      </td>
    </tr>
  <% end %>

  <% if intro.present? %>
    <tr>
      <td style="padding-bottom: 12px; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7; color: #243041;">
        <%= intro %>
      </td>
    </tr>
  <% end %>

  <% paragraphs.each do |paragraph| %>
    <tr>
      <td style="padding-bottom: 12px; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7; color: #4a5565;">
        <%= paragraph %>
      </td>
    </tr>
  <% end %>

  <% if detail_rows.any? || list_title.present? || list_items.any? %>
    <tr>
      <td style="padding: 8px 0 18px;">
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: separate; background-color: <%= palette[:panel_background] %>; border: 1px solid <%= palette[:panel_border] %>; border-radius: 18px;">
          <tr>
            <td style="padding: 18px 18px 16px;">
              <% if detail_rows.any? %>
                <%= render "shared/mailer/detail_rows", detail_rows: detail_rows %>
              <% end %>

              <% if list_title.present? || list_items.any? %>
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse; margin-top: <%= detail_rows.any? ? '18px' : '0' %>;">
                  <% if list_title.present? %>
                    <tr>
                      <td style="padding-bottom: 8px; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 12px; line-height: 1.5; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #5b6572;">
                        <%= list_title %>
                      </td>
                    </tr>
                  <% end %>

                  <% list_items.each do |item| %>
                    <tr>
                      <td style="padding-top: 6px; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; line-height: 1.7; color: #0f172a;">
                        • <%= item %>
                      </td>
                    </tr>
                  <% end %>
                </table>
              <% end %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  <% end %>

  <% if primary_action.present? %>
    <tr>
      <td style="padding-bottom: <%= secondary_action.present? ? '14px' : '18px' %>;">
        <%= render "shared/mailer/button",
          label: primary_action.fetch(:label),
          url: primary_action.fetch(:url),
          background_color: palette[:button_background],
          text_color: palette[:button_text] %>
      </td>
    </tr>
  <% end %>

  <% if secondary_action.present? %>
    <tr>
      <td style="padding-bottom: 18px; font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; line-height: 1.7; color: #4a5565;">
        <a href="<%= secondary_action.fetch(:url) %>" style="color: #22438f; text-decoration: underline;"><%= secondary_action.fetch(:label) %></a>
      </td>
    </tr>
  <% end %>

  <% if closing.present? %>
    <tr>
      <td style="font-family: 'Trebuchet MS', 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; line-height: 1.7; color: #4a5565;">
        <%= closing %>
      </td>
    </tr>
  <% end %>
</table>
