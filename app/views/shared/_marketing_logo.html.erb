<% logo_class = local_assigns.fetch(:logo_class, "w-12 h-12 object-contain") %>
<% logo_width = local_assigns.fetch(:logo_width, nil) %>
<% logo_height = local_assigns.fetch(:logo_height, nil) %>
<% template = Marketing::LandingTemplate.current %>
<% template_partial = "templates/#{template}/shared/marketing_logo" %>

<% if lookup_context.exists?(template_partial, [], true) %>
  <%= render template_partial, logo_class: logo_class, logo_width: logo_width, logo_height: logo_height %>
<% else %>
  <%= image_tag landing_logo_path, class: logo_class, alt: landing_logo_alt, width: logo_width, height: logo_height %>
<% end %>
