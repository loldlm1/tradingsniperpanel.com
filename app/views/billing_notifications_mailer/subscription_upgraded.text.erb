<% @preheader_text = t("billing_mailer.subscription_upgraded.preheader", app_name: app_name) %>
<%= render "shared/mailer/message",
  formats: [:text],
  tone: :success,
  category: t("mailers.shared.categories.billing"),
  title: t("billing_mailer.subscription_upgraded.title"),
  greeting: t("billing_mailer.greeting", name: recipient_name),
  intro: t("billing_mailer.subscription_upgraded.intro", app_name: app_name),
  detail_rows: subscription_detail_rows,
  primary_action: {
    label: t("billing_mailer.subscription_upgraded.billing_cta"),
    url: @billing_url
  },
  secondary_action: @invoice_url.present? ? {
    label: t("billing_mailer.invoice_cta"),
    url: @invoice_url
  } : nil %>
