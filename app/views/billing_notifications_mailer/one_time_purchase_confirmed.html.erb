<p><%= t("billing_mailer.greeting", name: (@user.name.presence || @user.email)) %></p>

<p><%= t("billing_mailer.one_time_purchase_confirmed.intro", app_name: app_name) %></p>

<% if @plan_names.any? %>
  <p><%= t("billing_mailer.one_time_purchase_confirmed.products_label") %></p>
  <ul>
    <% @plan_names.each do |plan_name| %>
      <li><%= plan_name %></li>
    <% end %>
  </ul>
<% end %>

<p><%= t("billing_mailer.amount_line", amount: @amount) %></p>
<p><%= t("billing_mailer.charge_line", charge_id: @charge_id) %></p>

<p><%= link_to t("billing_mailer.one_time_purchase_confirmed.marketplace_cta"), @marketplace_url %></p>

<% if @receipt_url.present? %>
  <p><%= link_to t("billing_mailer.receipt_cta"), @receipt_url %></p>
<% end %>

<p><%= t("billing_mailer.support_line", support_email: @support_email) %></p>
