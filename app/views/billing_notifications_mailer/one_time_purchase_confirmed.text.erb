<% @preheader_text = t("billing_mailer.one_time_purchase_confirmed.preheader", app_name: app_name) %>
<%= render "shared/mailer/message",
  formats: [:text],
  tone: :success,
  category: t("mailers.shared.categories.purchase"),
  title: t("billing_mailer.one_time_purchase_confirmed.title"),
  greeting: t("billing_mailer.greeting", name: recipient_name),
  intro: t("billing_mailer.one_time_purchase_confirmed.intro", app_name: app_name),
  detail_rows: purchase_detail_rows,
  list_title: (@plan_names.any? ? t("billing_mailer.one_time_purchase_confirmed.products_label") : nil),
  list_items: @plan_names,
  primary_action: {
    label: t("billing_mailer.one_time_purchase_confirmed.marketplace_cta"),
    url: @marketplace_url
  },
  secondary_action: @receipt_url.present? ? {
    label: t("billing_mailer.receipt_cta"),
    url: @receipt_url
  } : nil %>
