<% product = @entry.product %>
<% summary = product.summary_for(I18n.locale).presence || product.description_for(I18n.locale) %>
<% description = product.description_for(I18n.locale).presence || summary %>
<% addonable = @entry.addonable %>
<% addon_base = addonable.is_a?(ExpertAdvisor) ? addonable&.name : addonable&.title_for(I18n.locale) %>
<% addon_base ||= t("dashboard.marketplace.errors.addon_base_default") if @entry.addon? %>
<% eligible_to_buy = !@entry.addon? || @entry.eligible != false %>

<% content_for :title, "#{app_short_name} - #{product.title_for(I18n.locale)}" %>

<div class="sm:flex sm:justify-between sm:items-start mb-6">
  <div class="mb-4 sm:mb-0">
    <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.index.title") %></div>
    <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= product.title_for(I18n.locale) %></h1>
    <% if summary.present? %>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= summary %></p>
    <% end %>
    <% if @entry.tags.any? %>
      <div class="flex flex-wrap gap-2 mt-3 text-xs text-gray-600 dark:text-gray-300">
        <% @entry.tags.each do |tag| %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700/60"><%= tag %></span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div>
    <%= render "dashboard/shared/secondary_button",
               label: t("dashboard.marketplace.detail.back"),
               href: dashboard_marketplace_path(locale: I18n.locale) %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <figure class="mb-6">
        <% if product.image.attached? %>
          <%= image_tag product.image, class: "w-full rounded-xs", alt: product.title_for(I18n.locale) %>
        <% else %>
          <%= image_tag "mosaic/images/applications-image-09.jpg", class: "w-full rounded-xs", alt: t("dashboard.marketplace.card.placeholder_alt") %>
        <% end %>
      </figure>

      <div class="space-y-4">
        <div>
          <h2 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold mb-2"><%= t("dashboard.marketplace.detail.overview_title") %></h2>
          <% if description.present? %>
            <div class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed"><%= simple_format(description) %></div>
          <% end %>
        </div>

        <div>
          <h2 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold mb-2"><%= t("dashboard.marketplace.detail.includes_title") %></h2>
          <% if @entry.addon? %>
            <div>
              <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.detail.addon_for_label") %></div>
              <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                <li class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100 text-[11px] font-semibold">1</span>
                  <span><%= addon_base %></span>
                </li>
              </ul>
            </div>
          <% else %>
            <% if @entry.marketplace_assets.any? %>
              <div class="grid gap-6 md:grid-cols-3">
              <div>
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.detail.included_eas") %></div>
                <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                  <% @entry.expert_advisors.each do |expert_advisor| %>
                    <li class="flex items-center gap-2">
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100 text-[11px] font-semibold"><%= expert_advisor.tier_rank.to_i + 1 %></span>
                      <span><%= expert_advisor.name %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
              <div>
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.detail.included_courses") %></div>
                <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                  <% @entry.courses.each do |course| %>
                    <li class="flex items-center gap-2">
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100 text-[11px] font-semibold"><%= course.position.to_i + 1 %></span>
                      <span><%= course.title_for(I18n.locale) %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
              <div>
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.detail.included_assets") %></div>
                <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                  <% @entry.marketplace_assets.each do |asset| %>
                    <li class="flex items-center gap-2">
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100 text-[11px] font-semibold"><%= asset.sort_order.to_i + 1 %></span>
                      <%= link_to asset.title_for(I18n.locale), dashboard_marketplace_asset_path(asset, locale: I18n.locale), class: "hover:text-violet-600 dark:hover:text-violet-300" %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
            <% else %>
              <div class="grid gap-6 md:grid-cols-2">
                <div>
                  <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.detail.included_eas") %></div>
                  <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                    <% @entry.expert_advisors.each do |expert_advisor| %>
                      <li class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100 text-[11px] font-semibold"><%= expert_advisor.tier_rank.to_i + 1 %></span>
                        <span><%= expert_advisor.name %></span>
                      </li>
                    <% end %>
                  </ul>
                </div>
                <div>
                  <div class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.detail.included_courses") %></div>
                  <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                    <% @entry.courses.each do |course| %>
                      <li class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100 text-[11px] font-semibold"><%= course.position.to_i + 1 %></span>
                        <span><%= course.title_for(I18n.locale) %></span>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <div class="flex items-center justify-between gap-3">
        <div class="text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= @entry.price_display %></div>
        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-100"><%= t("dashboard.marketplace.detail.lifetime_badge") %></span>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.detail.price_label") %></p>
      <div class="mt-4">
        <% if @entry.purchased %>
          <button class="btn-sm w-full bg-gray-900 text-white opacity-60 cursor-not-allowed dark:bg-gray-100 dark:text-gray-800" disabled><%= t("dashboard.marketplace.cta.purchased") %></button>
          <% if @entry.purchase&.purchased_at %>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.detail.purchased_on", date: l(@entry.purchase.purchased_at.to_date)) %></p>
          <% end %>
        <% elsif !eligible_to_buy %>
          <button class="btn-sm w-full bg-gray-900 text-white opacity-60 cursor-not-allowed dark:bg-gray-100 dark:text-gray-800" disabled><%= t("dashboard.marketplace.cta.requires_base") %></button>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.detail.requires_base", base: addon_base) %></p>
        <% else %>
          <%= button_to t("dashboard.marketplace.cta.buy_now"), dashboard_checkout_path(price_key: @entry.plan&.key), method: :post, class: "btn-sm w-full bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        <% end %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl border border-gray-200 dark:border-gray-700 p-5 space-y-4">
      <% if @entry.addon? %>
        <div>
          <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.marketplace.detail.required_base_title") %></h3>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.detail.requires_base", base: addon_base) %></p>
        </div>
      <% else %>
        <div>
          <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.marketplace.detail.already_have_title") %></h3>
          <% if @entry.owned_expert_advisors.any? || @entry.owned_courses.any? || @entry.owned_assets.any? %>
            <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300 list-disc list-inside">
              <% @entry.owned_expert_advisors.each do |expert_advisor| %>
                <li><%= expert_advisor.name %></li>
              <% end %>
              <% @entry.owned_courses.each do |course| %>
                <li><%= course.title_for(I18n.locale) %></li>
              <% end %>
              <% @entry.owned_assets.each do |asset| %>
                <li><%= asset.title_for(I18n.locale) %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.detail.already_have_empty") %></p>
          <% end %>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.marketplace.detail.you_will_get_title") %></h3>
          <% if @entry.remaining_expert_advisors.any? || @entry.remaining_courses.any? || @entry.remaining_assets.any? %>
            <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300 list-disc list-inside">
              <% @entry.remaining_expert_advisors.each do |expert_advisor| %>
                <li><%= expert_advisor.name %></li>
              <% end %>
              <% @entry.remaining_courses.each do |course| %>
                <li><%= course.title_for(I18n.locale) %></li>
              <% end %>
              <% @entry.remaining_assets.each do |asset| %>
                <li><%= asset.title_for(I18n.locale) %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.detail.you_will_get_empty") %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
