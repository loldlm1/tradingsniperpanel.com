<% product = entry.product %>
<% summary = product.summary_for(I18n.locale).presence || product.description_for(I18n.locale) %>

<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl overflow-hidden">
  <div class="flex flex-col h-full">
    <% if product.image.attached? %>
      <%= image_tag product.image, class: "w-full h-40 object-cover", alt: product.title_for(I18n.locale) %>
    <% else %>
      <%= image_tag "mosaic/images/applications-image-01.jpg", class: "w-full h-40 object-cover", alt: t("dashboard.marketplace.card.placeholder_alt") %>
    <% end %>
    <div class="grow flex flex-col p-5">
      <div class="grow">
        <header class="mb-3">
          <h3 class="text-lg text-gray-800 dark:text-gray-100 font-semibold">
            <%= link_to product.title_for(I18n.locale), dashboard_marketplace_product_path(product, locale: I18n.locale), class: "hover:text-violet-600 dark:hover:text-violet-300" %>
          </h3>
        </header>
        <% if summary.present? %>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4"><%= truncate(summary, length: 120) %></p>
        <% end %>
        <div class="flex flex-wrap justify-between items-center mb-4">
          <% if entry.price_display.present? %>
            <div class="inline-flex text-sm font-medium bg-emerald-500/20 text-emerald-700 rounded-full text-center px-2 py-0.5"><%= entry.price_display %></div>
          <% end %>
          <% if entry.purchased %>
            <div class="inline-flex text-xs font-semibold bg-blue-100 text-blue-700 dark:bg-blue-500/20 dark:text-blue-100 rounded-full px-2 py-0.5"><%= t("dashboard.marketplace.card.purchased_badge") %></div>
          <% end %>
        </div>
        <ul class="text-sm space-y-2 mb-5 dark:text-gray-300">
          <li class="flex items-center">
            <svg class="fill-current text-gray-400 dark:text-gray-500 shrink-0 mr-3" width="16" height="16" viewBox="0 0 16 16">
              <path d="M7 11.674A1 1 0 0 1 7.739 10H8a1 1 0 0 1 1 1v1.699L14.034 8 9 3.302v1.699a1 1 0 0 1-1 1H2V8.27a1 1 0 1 1-2 0V6a2 2 0 0 1 2-2h5V2.153C7 .84 8.563.16 9.523 1.055l6.268 5.849a1.5 1.5 0 0 1 0 2.193l-6.267 5.849C8.565 15.84 7 15.16 7 13.849v-2.175Zm-1.278.878a.498.498 0 0 1 0 .896L4.2 14.2l-.752 1.521a.5.5 0 0 1-.896 0l-.752-1.52-1.521-.753a.498.498 0 0 1 0-.896l1.521-.752.752-1.52c.167-.342.728-.342.896 0L4.2 11.8l1.521.752ZM3.75 3a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Z" />
            </svg>
            <div><%= t("dashboard.marketplace.card.includes_eas", count: entry.expert_advisors.size) %></div>
          </li>
          <li class="flex items-center">
            <svg class="fill-current text-gray-400 dark:text-gray-500 shrink-0 mr-3" width="16" height="16" viewBox="0 0 16 16">
              <path d="M7 7a1 1 0 1 1 0 2H1a1 1 0 1 1 0-2h6Zm8-5a1 1 0 0 1 0 2H1a1 1 0 1 1 0-2h14ZM5 12a1 1 0 0 1 0 2H1a1 1 0 1 1 0-2h4Z" />
            </svg>
            <div><%= t("dashboard.marketplace.card.includes_courses", count: entry.courses.size) %></div>
          </li>
          <li class="flex items-center">
            <svg class="fill-current text-gray-400 dark:text-gray-500 shrink-0 mr-3" width="16" height="16" viewBox="0 0 16 16">
              <path d="M4.17 14H3a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3h1.17A3.001 3.001 0 0 1 7 0h6a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3.001 3.001 0 0 1-2.83-2ZM4 4H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h1V4Zm10 9V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1Z" />
            </svg>
            <div><%= t("dashboard.marketplace.card.lifetime_access") %></div>
          </li>
        </ul>
      </div>
      <div>
        <%= link_to t("dashboard.marketplace.cta.view_details"), dashboard_marketplace_product_path(product, locale: I18n.locale), class: "btn-sm w-full bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
      </div>
    </div>
  </div>
</div>
