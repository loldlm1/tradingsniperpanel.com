<% content_for :title, "#{app_short_name} - #{t('dashboard.marketplace.index.title')}" %>

<!-- Page header -->
<div class="mb-5">
  <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.marketplace.index.heading") %></h1>
</div>

<!-- Search form -->
<div class="max-w-xl mb-5">
  <%= form_with url: dashboard_marketplace_path(locale: I18n.locale), method: :get, class: "relative" do %>
    <label for="marketplace-search" class="sr-only"><%= t("dashboard.marketplace.index.search_label") %></label>
    <%= search_field_tag :q,
                         @marketplace.query,
                         id: "marketplace-search",
                         class: "form-input w-full pl-9 py-3 bg-white dark:bg-gray-800",
                         placeholder: t("dashboard.marketplace.index.search_placeholder") %>
    <% if @marketplace.selected_tab != :all %>
      <%= hidden_field_tag :tab, @marketplace.selected_tab %>
    <% end %>
    <% @marketplace.selected_tags.each do |tag| %>
      <%= hidden_field_tag "tags[]", tag %>
    <% end %>
    <button class="absolute inset-0 right-auto group" type="submit" aria-label="<%= t("dashboard.marketplace.index.search_label") %>">
      <svg class="shrink-0 fill-current text-gray-400 dark:text-gray-500 group-hover:text-gray-500 dark:group-hover:text-gray-400 ml-3 mr-2" width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 14c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7zM7 2C4.243 2 2 4.243 2 7s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5z" />
        <path d="M15.707 14.293L13.314 11.9a8.019 8.019 0 0 1-1.414 1.414l2.393 2.393a.997.997 0 001.414 0 .999.999 0 000-1.414z" />
      </svg>
    </button>
  <% end %>
</div>

<!-- Filters -->
<div class="mb-4 border-b border-gray-200 dark:border-gray-700/60">
  <ul class="text-sm font-medium flex flex-nowrap -mx-4 sm:-mx-6 lg:-mx-8 overflow-x-scroll no-scrollbar">
    <% base_tab_class = "whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500/40 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900" %>
    <% @marketplace.tabs.each do |tab| %>
      <% active = @marketplace.selected_tab == tab[:key] %>
      <% link_class = active ? "text-teal-500 #{base_tab_class}" : "text-gray-500 dark:text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 #{base_tab_class}" %>
      <li class="pb-3 mr-6 last:mr-0 first:pl-4 sm:first:pl-6 lg:first:pl-8 last:pr-4 sm:last:pr-6 lg:last:pr-8">
        <%= link_to t(tab[:label_key]), dashboard_marketplace_path(locale: I18n.locale, **@marketplace.params_for_tab(tab[:key])), class: link_class %>
      </li>
    <% end %>
  </ul>
  <% if @marketplace.tags.any? %>
    <div class="mt-3 pb-4">
      <ul class="flex flex-wrap -m-1">
        <% @marketplace.tags.each do |tag| %>
          <% active = @marketplace.selected_tags.include?(tag) %>
          <% class_name = active ? "border-transparent shadow-xs bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-800" : "" %>
          <li class="m-1">
            <%= render "dashboard/shared/filter_chip",
                       label: tag,
                       href: dashboard_marketplace_path(locale: I18n.locale, **@marketplace.params_for_tag(tag)),
                       class_name: class_name %>
          </li>
        <% end %>
          <% if @marketplace.selected_tags.any? %>
          <li class="m-1">
            <%= render "dashboard/shared/filter_chip",
                       label: t("dashboard.marketplace.filters.clear"),
                       href: dashboard_marketplace_path(locale: I18n.locale, **@marketplace.clear_tags_params) %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<!-- Page content -->
<div>
  <% if @marketplace.empty_state? %>
    <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
      <div class="mx-auto w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-700/60 flex items-center justify-center text-gray-600 dark:text-gray-200">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3h-2V4H9v16h6v-3h2v3a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4Z" />
          <path d="M3 9h10v2H3V9Zm0 4h10v2H3v-2Z" />
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mt-4"><%= t("dashboard.marketplace.index.empty_title") %></h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.index.empty_copy") %></p>
      <div class="mt-4">
        <%= link_to t("dashboard.marketplace.index.empty_cta"), dashboard_support_path, class: "btn-sm bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
      </div>
    </div>
  <% else %>
    <% if @marketplace.show_courses? && @marketplace.course_cards.any? %>
      <!-- Cards 1 (Video Courses) -->
      <div class="mt-8">
        <h2 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold mb-5"><%= t(@marketplace.course_section_label_key) %></h2>
        <div class="grid grid-cols-12 gap-6">
          <% @marketplace.course_cards.each_with_index do |card, index| %>
            <!-- Card <%= index + 1 %> -->
            <%= render "marketplace/cards/course_card", card: card %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @marketplace.show_digital_goods? && @marketplace.digital_goods_cards.any? %>
      <!-- Cards 2 (Digital Goods) -->
      <div class="mt-8">
        <h2 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold mb-5"><%= t(@marketplace.digital_goods_section_label_key) %></h2>
        <div class="grid grid-cols-12 gap-6">
          <% @marketplace.digital_goods_cards.each_with_index do |card, index| %>
            <!-- Card <%= index + 1 %> -->
            <%= render "marketplace/cards/digital_good_card", card: card %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @marketplace.show_online_events? %>
      <!-- Cards 3 (Online Events) -->
    <% end %>

    <% if @marketplace.show_categories? && @marketplace.category_cards.any? %>
      <!-- Cards 5 (Popular Categories) -->
      <div class="mt-8">
        <h2 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold mb-5"><%= t("dashboard.marketplace.sections.categories") %></h2>
        <div class="grid grid-cols-12 gap-6">
          <% @marketplace.category_cards.each_with_index do |card, index| %>
            <!-- Card <%= index + 1 %> -->
            <%= render "marketplace/cards/category_card", card: card %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @marketplace.show_trending? && @marketplace.trending_cards.any? %>
      <!-- Cards 6 (Trending Now) -->
      <div class="mt-8">
        <h2 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold mb-5"><%= t("dashboard.marketplace.sections.trending") %></h2>
        <div class="grid grid-cols-12 gap-6">
          <% @marketplace.trending_cards.each_with_index do |card, index| %>
            <!-- Card <%= index + 1 %> -->
            <%= render "marketplace/cards/trending_card", card: card %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
