<% content_for :title, "#{app_short_name} - #{t('dashboard.marketplace.index.title')}" %>

<div class="sm:flex sm:justify-between sm:items-start mb-6">
  <div class="mb-4 sm:mb-0">
    <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.marketplace.index.title") %></h1>
    <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.marketplace.index.subtitle") %></p>
  </div>
</div>

<% if @available_tags.present? %>
  <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs uppercase text-gray-500 dark:text-gray-400 font-semibold"><%= t("dashboard.marketplace.filters.title") %></span>
      <% @available_tags.each do |tag| %>
        <% active = @selected_tags.include?(tag) %>
        <% next_tags = active ? (@selected_tags - [tag]) : (@selected_tags + [tag]) %>
        <% href = next_tags.any? ? dashboard_marketplace_path(locale: I18n.locale, tags: next_tags) : dashboard_marketplace_path(locale: I18n.locale) %>
        <% class_name = active ? "bg-gray-900 text-white border-gray-900 hover:border-gray-900 dark:bg-gray-100 dark:text-gray-900 dark:border-gray-100" : "" %>
        <%= render "dashboard/shared/filter_chip", label: tag, href: href, class_name: class_name %>
      <% end %>
      <% if @selected_tags.present? %>
        <%= render "dashboard/shared/filter_chip",
                   label: t("dashboard.marketplace.filters.clear"),
                   href: dashboard_marketplace_path(locale: I18n.locale),
                   class_name: "bg-gray-100 dark:bg-gray-700/60" %>
      <% end %>
    </div>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-3"><%= t("dashboard.marketplace.filters.note") %></p>
  </div>
<% end %>

<% if @entries.present? %>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <%= render partial: "marketplace/product_card", collection: @entries, as: :entry %>
  </div>
<% else %>
  <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
    <div class="mx-auto w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-700/60 flex items-center justify-center text-gray-600 dark:text-gray-200">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M7 4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3h-2V4H9v16h6v-3h2v3a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4Z" />
        <path d="M3 9h10v2H3V9Zm0 4h10v2H3v-2Z" />
      </svg>
    </div>
    <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mt-4"><%= t("dashboard.marketplace.index.empty_title") %></h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2"><%= t("dashboard.marketplace.index.empty_copy") %></p>
    <div class="mt-4">
      <%= link_to t("dashboard.marketplace.index.empty_cta"), dashboard_support_path, class: "btn-sm bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
    </div>
  </div>
<% end %>
