<% image = card.image %>
<% rating_value = card.rating.to_f %>
<% rating_display = format("%.1f", rating_value) %>
<% rating_count = number_with_delimiter(card.rating_count.to_i) %>
<% summary = card.summary.to_s %>

<div class="col-span-full sm:col-span-6 xl:col-span-3 bg-white dark:bg-gray-800 shadow-xs rounded-xl overflow-hidden transition-shadow duration-200 hover:shadow-md" data-pagination-item>
  <div class="flex flex-col h-full">
    <!-- Image -->
    <div class="relative">
      <%= image_tag image, class: "w-full", width: 286, height: 160, alt: card.title %>
      <% if card.popular %>
        <!-- Popular label -->
        <div class="absolute top-0 right-0 mt-4 mr-4">
          <div class="inline-flex items-center text-xs font-medium text-gray-100 dark:text-gray-300 bg-gray-900/60 dark:bg-gray-800/60 rounded-full text-center px-2 py-0.5">
            <svg class="w-3 h-3 shrink-0 fill-current text-yellow-500 mr-1" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M11.953 4.29a.5.5 0 0 0-.454-.292H6.14L6.984.62A.5.5 0 0 0 6.12.173l-6 7a.5.5 0 0 0 .379.825h5.359l-.844 3.38a.5.5 0 0 0 .864.445l6-7a.5.5 0 0 0 .075-.534z" />
            </svg>
            <span><%= t("dashboard.marketplace.digital_goods.popular") %></span>
          </div>
        </div>
      <% end %>
    </div>
    <!-- Card Content -->
    <div class="grow flex flex-col p-5">
      <!-- Card body -->
      <div class="grow">
        <!-- Header -->
        <header class="mb-2">
          <h3 class="text-lg text-gray-800 dark:text-gray-100 font-semibold mb-1">
            <%= link_to card.title, card.detail_url, class: "hover:text-brand-600 dark:hover:text-brand-300" %>
          </h3>
          <% if summary.present? %>
            <div class="text-sm"><%= truncate(summary, length: 120) %></div>
          <% end %>
        </header>
        <!-- Rating and Price -->
        <div class="flex flex-wrap items-center justify-between mb-5">
          <!-- Rating -->
          <div class="flex items-center space-x-2 mr-2">
            <svg class="fill-current text-yellow-500" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M10 5.934L8 0 6 5.934H0l4.89 3.954L2.968 16 8 12.223 13.032 16 11.11 9.888 16 5.934z" />
            </svg>
            <!-- Rate -->
            <div class="text-sm font-medium whitespace-nowrap">
              <span><%= rating_display %></span>
              <span class="text-gray-400 dark:text-gray-500"><%= t("dashboard.marketplace.digital_goods.rating_count", count: rating_count) %></span>
            </div>
          </div>
          <!-- Price -->
          <div class="flex items-center space-x-2">
            <div class="inline-flex text-sm font-medium bg-green-500/20 text-green-700 rounded-full text-center px-2 py-0.5"><%= card.price_display %></div>
          </div>
        </div>
      </div>
      <!-- Card footer -->
      <div>
        <%= link_to t(card.cta_label_key), card.detail_url, class: "btn-sm w-full bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
      </div>
    </div>
  </div>
</div>
