<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <% assets_template = marketing_assets_template %>
    <% default_body_class = case assets_template
       when "mosaic"
         "font-inter antialiased bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400"
       when "fintech"
         "font-aspekta antialiased bg-white text-slate-800 font-[350]"
       else
         "font-inter antialiased bg-gray-900 text-gray-100 tracking-tight"
       end %>

    <% if assets_template == "mosaic" %>
      <%= stylesheet_link_tag "mosaic/style" %>
    <% elsif assets_template == "fintech" %>
      <%= stylesheet_link_tag "fintech/css/vendors/aos" %>
      <%= stylesheet_link_tag "fintech/css/vendors/swiper-bundle.min" %>
      <%= stylesheet_link_tag "fintech/style" %>
    <% else %>
      <%= stylesheet_link_tag "neon/css/vendors/aos" %>
      <%= stylesheet_link_tag "neon/style" %>
    <% end %>
    <%= stylesheet_link_tag "marketing" %>
    <%= yield :head %>
  </head>

  <% if assets_template == "mosaic" %>
    <%= javascript_include_tag "theme" %>
  <% end %>

  <body class="<%= content_for?(:body_class) ? yield(:body_class) : default_body_class %>">
    <% show_alerts = flash.any? && !(controller_name == "pages" && action_name == "home") %>
    <% flash_partial = devise_controller? ? "devise/shared/flash" : "shared/alert" %>
    <% if content_for?(:full_bleed) %>
      <% if show_alerts && !devise_controller? %>
        <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
          <%= render flash_partial %>
        </div>
      <% end %>
      <%= yield %>
    <% else %>
      <div class="flex flex-col min-h-screen overflow-hidden">
        <%= render "shared/marketing_header" %>

        <main class="grow">
          <% if show_alerts %>
            <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
              <%= render flash_partial %>
            </div>
          <% end %>
          <%= yield %>
        </main>

        <%= render "shared/marketing_footer" %>
      </div>
    <% end %>

    <%= javascript_importmap_tags %>
    <% if assets_template == "mosaic" %>
      <%= javascript_include_tag "mosaic/js/vendors/alpinejs.min", defer: true %>
      <%= javascript_include_tag "mosaic/js/main" %>
    <% elsif assets_template == "fintech" %>
      <%= javascript_include_tag "fintech/js/vendors/alpinejs.min", defer: true %>
      <%= javascript_include_tag "fintech/js/vendors/aos" %>
      <%= javascript_include_tag "fintech/js/vendors/swiper-bundle.min" %>
      <%= javascript_include_tag "fintech/js/main" %>
    <% else %>
      <%= javascript_include_tag "neon/js/vendors/alpinejs.min", defer: true %>
      <%= javascript_include_tag "neon/js/vendors/aos" %>
      <%= javascript_include_tag "neon/js/main" %>
    <% end %>
    <%= yield :scripts if content_for?(:scripts) %>
  </body>
</html>
