<% content_for :title, t("dashboard.courses.lesson_page_title", course: @course.title_for(I18n.locale), lesson: @lesson.title_for(I18n.locale)) %>
<% content_for :page_container_class, "w-full max-w-none px-0 py-0" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "guides" %>
<% end %>

<div class="relative isolate">
  <div class="absolute inset-0 pointer-events-none -z-10 rounded-2xl overflow-hidden" aria-hidden="true">
    <div class="absolute top-0 left-1/2 -translate-x-1/2">
      <%= image_tag "docs/images/hero-illustration.svg", class: "max-w-none", width: 1972, height: 392, alt: "" %>
    </div>
  </div>

  <div class="w-full max-w-[96rem] mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-8 md:pt-12">
    <article>
      <div class="min-w-0">
        <header class="mb-6">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
              <div class="text-xs uppercase text-slate-500 dark:text-slate-400 font-semibold"><%= @course_module.title_for(I18n.locale) %></div>
              <h1 class="h2 text-slate-800 mb-2 dark:text-slate-200"><%= @lesson.title_for(I18n.locale) %></h1>
              <p class="text-sm text-slate-600 dark:text-slate-400"><%= @course.title_for(I18n.locale) %></p>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to t("dashboard.courses.back_to_course"), dashboard_course_path(@course, locale: I18n.locale), class: "btn-sm inline-flex items-center text-slate-100 bg-blue-600 hover:bg-blue-700 shadow-xs" %>
            </div>
          </div>
        </header>

        <% if @playback_url.present? %>
          <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5 mb-6">
            <div class="flex items-center justify-between mb-3">
              <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.courses.lesson_video_title") %></div>
              <div class="text-xs text-gray-500 dark:text-gray-400"><%= format_duration(@lesson.duration_seconds) %></div>
            </div>
            <video
              class="w-full aspect-video rounded-lg bg-slate-900"
              controls
              playsinline
              preload="metadata"
              data-course-progress
              data-course-progress-url="<%= dashboard_course_lesson_progress_path(@course, @lesson, locale: I18n.locale) %>"
              data-course-duration="<%= @lesson.duration_seconds %>"
            >
              <source src="<%= @playback_url %>" type="application/x-mpegURL" />
              <%= t("dashboard.courses.video_fallback") %>
            </video>
          </div>
        <% else %>
          <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5 mb-6">
            <p class="text-slate-600 dark:text-slate-400"><%= t("dashboard.courses.video_unavailable") %></p>
          </div>
        <% end %>

        <% if @markdown_html.present? %>
          <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5">
            <div class="ea-guide-content text-slate-600 dark:text-slate-400 space-y-6" data-scrollspy-container>
              <%= @markdown_html %>
            </div>
          </div>
        <% else %>
          <p class="text-slate-600 dark:text-slate-400"><%= t("dashboard.courses.lesson_body_missing") %></p>
        <% end %>
      </div>
    </article>
  </div>
</div>
