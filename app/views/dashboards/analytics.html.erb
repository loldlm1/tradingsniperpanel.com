<% content_for :title, "#{t('dashboard.nav.analytics', default: 'Analytics')} | #{app_short_name}" %>
<% analytics = @broker_analytics %>
<% totals = analytics.totals %>
<% summary = analytics.summary %>
<% filters = analytics.filters %>

<div class="sm:flex sm:justify-between sm:items-start mb-8">
  <div class="mb-4 sm:mb-0">
    <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.nav.analytics", default: "Analytics") %></h1>
    <p class="text-gray-600 dark:text-gray-300"><%= t("dashboard.analytics.pnl_page_copy") %></p>
  </div>

  <%= form_with url: dashboard_analytics_path, method: :get, local: true, scope: nil, html: { class: "flex flex-wrap items-center gap-2", data: { analytics_filters: true } } do %>
    <div class="relative">
      <input
        type="text"
        name="date_range"
        class="datepicker form-input pl-9 dark:bg-gray-800 text-gray-600 hover:text-gray-800 dark:text-gray-300 dark:hover:text-gray-100 font-medium w-[15.5rem]"
        placeholder="<%= t('dashboard.analytics.filters.date_range') %>"
        aria-label="<%= t('dashboard.analytics.filters.date_range') %>"
        data-class="flatpickr-right"
        data-analytics-datepicker="true"
        data-from-ts="<%= filters[:from_ts] %>"
        data-to-ts="<%= filters[:to_ts] %>"
      />
      <div class="absolute inset-0 right-auto flex items-center pointer-events-none">
        <svg class="fill-current text-gray-400 dark:text-gray-500 ml-3" width="16" height="16" viewBox="0 0 16 16">
          <path d="M5 4a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2H5Z" />
          <path d="M4 0a4 4 0 0 0-4 4v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V4a4 4 0 0 0-4-4H4ZM2 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4Z" />
        </svg>
      </div>
      <%= hidden_field_tag :from_ts, filters[:from_ts], data: { analytics_from: true } %>
      <%= hidden_field_tag :to_ts, filters[:to_ts], data: { analytics_to: true } %>
    </div>

    <%= select_tag :ea_id,
                   options_for_select([[t("dashboard.analytics.filters.all_eas"), ""]] +
                                      (@accessible_eas || []).map { |entry| [entry.expert_advisor.name, entry.expert_advisor.ea_id] },
                                      filters[:ea_id]),
                   class: "form-select w-48",
                   data: { analytics_filter: true },
                   aria: { label: t("dashboard.analytics.filters.all_eas") } %>

    <%= select_tag :broker,
                   options_for_select([[t("dashboard.analytics.filters.all_brokers"), ""]] +
                                      analytics.available_brokers.map { |broker| [broker, broker] },
                                      filters[:broker]),
                   class: "form-select w-40",
                   data: { analytics_filter: true },
                   aria: { label: t("dashboard.analytics.filters.all_brokers") } %>

    <%= select_tag :account_type,
                   options_for_select([[t("dashboard.analytics.filters.all_account_types"), ""]] +
                                      analytics.available_account_types.map { |key| [t("dashboard.broker_accounts.account_type.#{key}"), key] },
                                      filters[:account_type]),
                   class: "form-select w-40",
                   data: { analytics_filter: true },
                   aria: { label: t("dashboard.analytics.filters.all_account_types") } %>

    <%= select_tag :compare_by,
                   options_for_select(analytics.compare_by_options.map { |key| [t("dashboard.analytics.filters.compare_by_options.#{key}"), key] },
                                      filters[:compare_by]),
                   class: "form-select w-40",
                   data: { analytics_filter: true },
                   aria: { label: t("dashboard.analytics.filters.compare_by") } %>
  <% end %>
</div>

<div class="text-xs text-gray-500 dark:text-gray-400 mb-6"><%= t("dashboard.analytics.filters.note") %></div>

<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4 mb-6">
  <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <div class="text-sm font-semibold text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.tiles.total_accounts") %></div>
    <div class="mt-2 text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= totals[:total] %></div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("dashboard.analytics.tiles.total_hint") %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <div class="text-sm font-semibold text-gray-500 dark:text-gray-400"><%= t("dashboard.broker_accounts.account_type.real") %></div>
    <div class="mt-2 text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= totals[:real] %></div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("dashboard.analytics.tiles.real_hint") %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <div class="text-sm font-semibold text-gray-500 dark:text-gray-400"><%= t("dashboard.broker_accounts.account_type.demo") %></div>
    <div class="mt-2 text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= totals[:demo] %></div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("dashboard.analytics.tiles.demo_hint") %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <div class="text-sm font-semibold text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.tiles.total_pnl") %></div>
    <div class="mt-2 text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= number_to_currency(summary[:total_pnl].to_f, unit: "$", precision: 2) %></div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("dashboard.analytics.tiles.total_pnl_hint") %></p>
  </div>
</div>

<div class="grid grid-cols-12 gap-6">
  <div class="flex flex-col col-span-full bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700">
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
          <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.analytics.pnl_title") %></div>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.pnl_copy") %></p>
        </div>
        <div class="text-xs text-gray-500 dark:text-gray-400">
          <%= t("dashboard.analytics.summary.range",
                from: l(filters[:from_date], format: :short),
                to: l(filters[:to_date], format: :short)) %>
        </div>
      </div>
    </header>
    <div class="px-5 py-4">
      <div class="flex flex-wrap gap-6">
        <div>
          <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.summary.total_pnl") %></div>
          <div class="text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= number_to_currency(summary[:total_pnl].to_f, unit: "$", precision: 2) %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.summary.avg_daily_pnl") %></div>
          <div class="text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= number_to_currency(summary[:average_daily_pnl].to_f, unit: "$", precision: 2) %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.summary.days") %></div>
          <div class="text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= summary[:days] %></div>
        </div>
      </div>
    </div>
    <div class="grow" data-analytics-chart="true" data-chart="<%= h(analytics.chart_data.to_json) %>">
      <canvas id="analytics-card-01" width="800" height="320"></canvas>
    </div>
  </div>

  <div class="col-span-full bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between mb-4">
      <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.analytics.top_accounts") %></div>
      <span class="text-xs text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.pagination_note") %></span>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-gray-800 dark:text-gray-100">
        <thead class="bg-gray-50 dark:bg-gray-900/30 text-left">
          <tr>
            <th class="px-3 py-2 font-semibold"><%= t("dashboard.analytics.columns.ea") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("dashboard.analytics.columns.broker") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("dashboard.analytics.columns.account_type") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("dashboard.analytics.columns.pnl") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("dashboard.analytics.columns.days") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("dashboard.analytics.columns.last_result") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% analytics.setups.each do |row| %>
            <tr>
              <td class="px-3 py-2"><%= row.ea_name %></td>
              <td class="px-3 py-2"><%= row.broker_name %></td>
              <td class="px-3 py-2 text-xs uppercase text-gray-500 dark:text-gray-400"><%= t("dashboard.broker_accounts.account_type.#{row.account_type}") %></td>
              <td class="px-3 py-2 font-semibold <%= row.total_pnl.to_f >= 0 ? 'text-emerald-600 dark:text-emerald-300' : 'text-rose-600 dark:text-rose-300' %>"><%= number_to_currency(row.total_pnl.to_f, unit: "$", precision: 2) %></td>
              <td class="px-3 py-2"><%= row.days_count %></td>
              <td class="px-3 py-2 text-xs text-gray-500 dark:text-gray-400">
                <%= row.last_result_at.present? ? l(row.last_result_at, format: :short_with_year) : t("dashboard.analytics.no_results") %>
              </td>
            </tr>
          <% end %>
          <% if analytics.setups.empty? %>
            <tr>
              <td colspan="6" class="px-3 py-4 text-gray-500 dark:text-gray-400"><%= t("dashboard.analytics.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if analytics.pagination[:total_pages] > 1 %>
      <div class="flex items-center justify-between mt-4 text-xs text-gray-500 dark:text-gray-400">
        <span><%= t("dashboard.analytics.page", current: analytics.pagination[:current_page], total: analytics.pagination[:total_pages]) %></span>
        <div class="flex items-center gap-2">
          <% prev_page = analytics.pagination[:current_page] - 1 %>
          <% next_page = analytics.pagination[:current_page] + 1 %>
          <% if analytics.pagination[:current_page] > 1 %>
            <%= link_to t("dashboard.analytics.prev"), dashboard_analytics_path(page: prev_page, **filters.slice(:from_ts, :to_ts, :ea_id, :broker, :account_type, :compare_by)),
                        class: "px-3 py-1 rounded border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600" %>
          <% end %>
          <% if analytics.pagination[:current_page] < analytics.pagination[:total_pages] %>
            <%= link_to t("dashboard.analytics.next"), dashboard_analytics_path(page: next_page, **filters.slice(:from_ts, :to_ts, :ea_id, :broker, :account_type, :compare_by)),
                        class: "px-3 py-1 rounded border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
