<!-- Discord VIP activation -->
<section id="discord-vip-card" class="col-span-full overflow-hidden rounded-xl border border-sky-200/80 bg-gradient-to-r from-sky-50 via-white to-amber-50 shadow-xs dark:border-sky-500/20 dark:from-sky-950/30 dark:via-gray-800 dark:to-amber-950/20" aria-labelledby="discord-vip-card-title">
  <div class="flex flex-col gap-5 px-5 py-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-start gap-4">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sky-500 text-white shadow-sm" aria-hidden="true">
        <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
          <path d="M19.3 5.34A16.7 16.7 0 0 0 15.18 4l-.5 1.02a15.2 15.2 0 0 0-5.36 0L8.82 4A16.8 16.8 0 0 0 4.7 5.34C2.1 9.22 1.4 13 1.75 16.73a16.9 16.9 0 0 0 5.06 2.55l1.22-1.67a10.8 10.8 0 0 1-1.92-.92l.47-.36c3.7 1.72 7.72 1.72 11.38 0l.48.36c-.62.36-1.26.67-1.93.92l1.22 1.67a16.8 16.8 0 0 0 5.05-2.55c.42-4.32-.72-8.06-3.48-11.39ZM8.55 14.45c-1.11 0-2.03-1.03-2.03-2.29 0-1.26.9-2.29 2.03-2.29 1.14 0 2.05 1.04 2.03 2.29 0 1.26-.9 2.29-2.03 2.29Zm6.9 0c-1.11 0-2.03-1.03-2.03-2.29 0-1.26.9-2.29 2.03-2.29 1.14 0 2.05 1.04 2.03 2.29 0 1.26-.89 2.29-2.03 2.29Z" />
        </svg>
      </div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h2 id="discord-vip-card-title" class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.discord.card.title") %></h2>
          <span class="inline-flex rounded-full border border-gray-200 bg-white/80 px-2 py-0.5 text-xs font-semibold text-sky-700 dark:border-gray-500 dark:bg-sky-500/20 dark:text-gray-100">
            <%= t("dashboard.discord.states.#{discord.state}.label") %>
          </span>
        </div>
        <p class="mt-1 max-w-3xl text-sm font-medium text-gray-700 dark:text-gray-100"><%= t("dashboard.discord.states.#{discord.state}.title") %></p>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-gray-500 dark:text-gray-300"><%= t("dashboard.discord.states.#{discord.state}.body") %></p>
      </div>
    </div>

    <div class="flex shrink-0 flex-wrap gap-2 sm:justify-end">
      <% if discord.eligible %>
        <%= link_to t(discord.connectable ? "dashboard.discord.actions.connect" : "dashboard.discord.actions.manage"),
                    dashboard_discord_connection_path,
                    class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
      <% else %>
        <%= link_to t("dashboard.discord.actions.view_plans"), dashboard_plans_path, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        <% if discord.support_url.present? %>
          <%= link_to t("dashboard.discord.actions.join_public"), discord.support_url, target: "_blank", rel: "noopener noreferrer", class: "btn border-gray-200 bg-white/80 text-gray-800 shadow-sm hover:border-gray-300 dark:border-gray-500 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600" %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
