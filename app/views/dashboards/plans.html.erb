<% content_for :title, "#{t('dashboard.nav.plans')} | #{app_short_name}" %>

<% pricing = @pricing_catalog || {} %>
<% plan = @plan_context || {} %>
<% tier_key = Billing::PandoraPricing::TIER %>
<% intervals = plan[:intervals] || pricing[:intervals] || [] %>
<% interval_keys = intervals.map { |interval| interval[:key] } %>
<% prices = pricing[:prices] || {} %>
<% discount_percent = pricing[:discount_percent] %>
<% subscribed = @subscription.present? %>
<% manual_subscription = @subscription.is_a?(ManualSubscription) %>
<% scheduled_change = plan[:scheduled_change] || {} %>
<% scheduled_price_key = scheduled_change[:price_key] %>
<% requested_price_key = @requested_price_key.to_s.presence %>
<% requested_interval = if requested_price_key.in?(Billing::PandoraPricing::PLAN_KEYS)
                          intervals.find { |interval| prices.dig(interval[:key], tier_key, :plan_key) == requested_price_key }&.dig(:key)
                        end %>
<% plan_states = plan[:states] || {} %>
<% upgrade_confirm = t("dashboard.plans.upgrade_confirm") %>

<% current_tier = plan[:current_tier] %>
<% plan_name = current_tier ? t("dashboard.plans.tiers.#{current_tier}.name", default: current_tier.to_s.humanize) : nil %>
<% current_interval_label = plan[:current_interval_label].presence || Billing::IntervalLabeler.legacy_label(plan[:current_interval_key]) %>
<% summary_text = if plan_name.present? && current_interval_label.present?
                    t("dashboard.plans.summary", plan_name: plan_name, interval: current_interval_label)
                  else
                    t("dashboard.plans.no_plan_summary")
                  end %>
<% scheduled_label = if scheduled_change[:tier].present?
                       scheduled_plan_name = t("dashboard.plans.tiers.#{scheduled_change[:tier]}.name", default: scheduled_change[:tier].to_s.humanize)
                       scheduled_interval_label = scheduled_change[:interval_label].presence || Billing::IntervalLabeler.legacy_label(scheduled_change[:interval_key])
                       if scheduled_interval_label.present?
                         t("dashboard.plan_card.plan_label", tier: scheduled_plan_name, interval: scheduled_interval_label)
                       else
                         t("dashboard.plan_card.plan_label_tier_only", tier: scheduled_plan_name)
                       end
                     end %>
<% features = Array(t("dashboard.plans.tiers.#{tier_key}.features", default: [])) +
              Array(Licenses::OnlineSeatCopy.subscription_feature_for_tier(tier_key, locale: I18n.locale)) %>

<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl mb-8">
  <div class="p-6 space-y-6">
    <!-- Page header -->
    <section>
      <div class="mb-8">
        <h2 class="text-2xl text-gray-800 dark:text-gray-100 font-bold mb-4"><%= t("dashboard.plans.page_title") %></h2>
        <div class="text-sm"><%= summary_text %></div>
        <% if manual_subscription %>
          <div class="mt-3 text-sm text-amber-600 dark:text-amber-300"><%= t("dashboard.plans.manual_unavailable") %></div>
        <% end %>
        <% if scheduled_label.present? && scheduled_change[:effective_at].present? %>
          <div class="mt-2 flex flex-col gap-2 text-sm text-amber-600 dark:text-amber-300 sm:flex-row sm:items-center sm:justify-between">
            <div><%= t("dashboard.plans.scheduled_notice", plan: scheduled_label, date: l(scheduled_change[:effective_at].to_date)) %></div>
            <%= button_to dashboard_cancel_scheduled_downgrade_path, method: :post, class: "btn-sm bg-white border border-amber-200 hover:border-amber-300 text-amber-700 hover:text-amber-800 dark:bg-gray-800 dark:border-amber-500/40 dark:text-amber-200 dark:hover:border-amber-400", data: { loading_target: true } do %>
              <%= loading_label(t("dashboard.plans.cancel_scheduled"), loading_text: t("loading.default")) %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if intervals.empty? %>
        <div class="rounded-xl border border-gray-200 bg-gray-50 px-5 py-8 text-center dark:border-gray-700 dark:bg-gray-900/40">
          <h3 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.plans.unavailable.title") %></h3>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.plans.unavailable.body") %></p>
          <%= link_to t("dashboard.plans.contact.cta"), dashboard_support_path, class: "btn mt-5 bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        </div>
      <% else %>
        <% initial_interval = requested_interval.presence || interval_keys.first || "monthly" %>
        <div x-data="{ period: '<%= initial_interval %>' }">
          <!-- Interval switch -->
          <div class="mb-6 overflow-x-auto pb-1 text-center">
            <div class="inline-flex min-w-max items-center rounded-full border border-gray-200 bg-gray-100 p-1 gap-1 dark:border-gray-600 dark:bg-gray-700/60">
              <% intervals.each do |interval| %>
                <button type="button"
                        class="inline-flex min-h-10 items-center gap-1 whitespace-nowrap px-4 py-2 rounded-full text-sm font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/50"
                        :class="period === '<%= interval[:key] %>' ? 'bg-gray-900 text-gray-100 dark:bg-gray-100 dark:text-gray-800' : 'text-gray-500 hover:text-gray-800 dark:text-gray-300 dark:hover:text-gray-100'"
                        :aria-pressed="period === '<%= interval[:key] %>'"
                        @click="period = '<%= interval[:key] %>'">
                  <span><%= interval[:label] %></span>
                  <% if interval[:key] == "annual" && discount_percent.present? %>
                    <span class="text-xs font-semibold text-green-600 dark:text-green-400"><%= t("dashboard.plans.toggle.save_up_to", percent: discount_percent) %></span>
                  <% end %>
                </button>
              <% end %>
            </div>
          </div>

          <!-- Pandora subscription card -->
          <div class="mx-auto max-w-3xl">
            <div class="relative overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xs dark:border-gray-700/60 dark:bg-gray-800">
              <div class="absolute inset-x-0 top-0 h-1 bg-brand-500" aria-hidden="true"></div>
              <div class="px-5 pt-7 pb-6 border-b border-gray-200 dark:border-gray-700/60 sm:px-7">
                <header class="flex flex-wrap items-center gap-3 mb-2">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-500">
                    <svg class="h-5 w-5 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 17a.833.833 0 01-.833-.833 3.333 3.333 0 00-3.334-3.334.833.833 0 110-1.666 3.333 3.333 0 003.334-3.334.833.833 0 111.666 0 3.333 3.333 0 003.334 3.334.833.833 0 110 1.666 3.333 3.333 0 00-3.334 3.334c0 .46-.373.833-.833.833z" />
                    </svg>
                  </div>
                  <h3 class="text-xl text-gray-800 dark:text-gray-100 font-semibold"><%= t("dashboard.plans.tiers.#{tier_key}.name") %></h3>
                  <% if requested_price_key.in?(Billing::PandoraPricing::PLAN_KEYS) %>
                    <span class="ml-auto inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold text-brand-600 dark:text-brand-300 bg-brand-500/10"><%= t("dashboard.plans.requested_plan") %></span>
                  <% elsif scheduled_change[:tier].to_s == tier_key %>
                    <span class="ml-auto inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold text-amber-700 dark:text-amber-300 bg-amber-500/10"><%= t("dashboard.plans.scheduled_badge") %></span>
                  <% end %>
                </header>
                <div class="text-sm mb-4 max-w-2xl"><%= t("dashboard.plans.tiers.#{tier_key}.description") %></div>

                <div class="text-gray-800 dark:text-gray-100 font-bold mb-5" aria-live="polite">
                  <% intervals.each do |interval| %>
                    <% details = prices.dig(interval[:key], tier_key) %>
                    <div class="flex items-baseline gap-1" x-show="period === '<%= interval[:key] %>'" x-cloak>
                      <span class="text-2xl">$</span>
                      <span class="text-4xl"><%= details&.dig(:display) || t("dashboard.plans.placeholder") %></span>
                      <span class="text-gray-500 font-medium text-sm"><%= interval[:per_label] %></span>
                    </div>
                  <% end %>
                </div>

                <% cta_label = subscribed ? t("dashboard.plans.cta.upgrade") : t("dashboard.plans.cta.subscribe") %>
                <% intervals.each do |interval| %>
                  <% interval_key = interval[:key] %>
                  <% details = prices.dig(interval_key, tier_key) %>
                  <% plan_key = details&.dig(:plan_key) %>
                  <% available = details&.dig(:stripe_price_id).present? %>
                  <% interval_state = plan_states.dig(tier_key, interval_key) %>
                  <% scheduled_for_interval = scheduled_price_key == plan_key %>
                  <div x-show="period === '<%= interval_key %>'" x-cloak>
                    <% if available %>
                      <% if subscribed && interval_state == :current %>
                        <button type="button" class="btn w-full bg-gray-900 text-gray-100 dark:bg-gray-100 dark:text-gray-800 disabled:cursor-not-allowed" disabled>
                          <svg class="w-3 h-3 shrink-0 fill-current mr-2" viewBox="0 0 12 12" aria-hidden="true">
                            <path d="M10.28 1.28L3.989 7.575 1.695 5.28A1 1 0 00.28 6.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 1.28z" />
                          </svg>
                          <span><%= t("dashboard.plans.cta.current") %></span>
                        </button>
                      <% elsif subscribed && scheduled_for_interval %>
                        <button type="button" class="btn w-full border-gray-200 dark:border-gray-700/60 text-gray-800 dark:text-gray-300 disabled:cursor-not-allowed" disabled><%= t("dashboard.plans.cta.scheduled") %></button>
                      <% elsif manual_subscription %>
                        <button type="button" class="btn w-full border-gray-200 dark:border-gray-700/60 text-gray-500 dark:text-gray-400 disabled:cursor-not-allowed" disabled><%= t("dashboard.plans.cta.unavailable") %></button>
                      <% else %>
                        <% interval_label = subscribed && interval_state == :downgrade ? t("dashboard.plans.cta.downgrade") : cta_label %>
                        <% interval_data = { loading_target: true } %>
                        <% interval_data[:confirm_message] = upgrade_confirm if subscribed && interval_state == :upgrade %>
                        <% checkout_params = { price_key: plan_key } %>
                        <% checkout_params[:promotion_code_id] = @promotion_prefill.id if @promotion_prefill.present? %>
                        <%= button_to dashboard_checkout_path(checkout_params), method: :post, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white w-full", data: interval_data do %>
                          <%= loading_label(interval_label, loading_text: t("loading.default")) %>
                        <% end %>
                      <% end %>
                    <% else %>
                      <button type="button" class="btn w-full border-gray-200 dark:border-gray-700/60 text-gray-500 dark:text-gray-400 disabled:cursor-not-allowed" disabled><%= t("dashboard.plans.cta.unavailable") %></button>
                    <% end %>

                    <% if details&.dig(:effective_monthly_display).present? && interval[:uses_effective_monthly] %>
                      <div class="text-xs text-gray-500 mt-3"><%= t("dashboard.plans.effective_monthly", amount: details[:effective_monthly_display]) %></div>
                    <% end %>
                    <% if interval[:billed_label].present? %>
                      <div class="text-xs text-gray-500 mt-1"><%= interval[:billed_label] %></div>
                    <% end %>
                    <div class="text-xs text-gray-500 mt-3">
                      <%= t("checkout.subscription_notice_html", refunds_link: link_to(t("legal.links.refunds_and_cancellations"), refunds_and_cancellations_path, class: "underline")).html_safe %>
                    </div>
                  </div>
                <% end %>
              </div>

              <div class="px-5 pt-5 pb-6 sm:px-7">
                <div class="text-xs text-gray-800 dark:text-gray-100 font-semibold uppercase mb-4"><%= t("dashboard.plans.whats_included") %></div>
                <ul class="grid gap-2 sm:grid-cols-2">
                  <% features.each do |feature| %>
                    <li class="flex items-start py-1">
                      <svg class="w-3 h-3 mt-1 shrink-0 fill-current text-green-500 mr-2" viewBox="0 0 12 12" aria-hidden="true">
                        <path d="M10.28 1.28L3.989 7.575 1.695 5.28A1 1 0 00.28 6.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 1.28z" />
                      </svg>
                      <div class="text-sm"><%= feature %></div>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </section>

    <!-- Support -->
    <section>
      <div class="px-5 py-3 bg-linear-to-r from-brand-500/[0.12] dark:from-brand-500/[0.24] to-brand-500/[0.04] rounded-lg text-center xl:text-left xl:flex xl:flex-wrap xl:justify-between xl:items-center">
        <div class="mb-3 xl:mb-0">
          <div class="text-gray-800 dark:text-gray-100 font-semibold"><%= t("dashboard.plans.contact.title") %></div>
          <div class="text-sm text-gray-600 dark:text-gray-300"><%= t("dashboard.plans.contact.body") %></div>
        </div>
        <%= link_to t("dashboard.plans.contact.cta"), dashboard_support_path, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
      </div>
    </section>

    <!-- FAQs -->
    <section>
      <div class="my-8">
        <h2 class="text-2xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.plans.faq.title") %></h2>
      </div>
      <ul class="space-y-5">
        <% t("dashboard.plans.faq.items", default: []).each do |item| %>
          <li>
            <div class="font-semibold text-gray-800 dark:text-gray-100 mb-1"><%= item[:q] %></div>
            <div class="text-sm"><%= item[:a] %></div>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</div>
