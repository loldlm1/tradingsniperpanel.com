<% content_for :title, "#{app_short_name} Dashboard" %>
<% main = @main %>
<% intro = main.intro %>
<% pnl = main.pnl_summary %>
<% plan = main.plan_details %>
<% licenses_card = main.licenses_card %>
<% course_progress = main.course_progress_card %>
<% balance = main.balance_distribution %>
<% mini_cards = main.mini_cards %>
<% summary_rows = main.account_summary_rows %>
<% user_label = current_user&.name.presence || current_user&.email %>

<!-- Page header -->
<div class="sm:flex sm:justify-between sm:items-center mb-5">
  <div class="mb-4 sm:mb-0">
    <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.main.header.title") %></h1>
  </div>

  <div class="grid grid-flow-col sm:auto-cols-max justify-start sm:justify-end gap-2">
    <%= link_to dashboard_expert_advisors_path, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" do %>
      <svg class="fill-current shrink-0 xs:hidden" width="16" height="16" viewBox="0 0 16 16">
        <path d="M15 7H9V1c0-.6-.4-1-1-1S7 .4 7 1v6H1c-.6 0-1 .4-1 1s.4 1 1 1h6v6c0 .6.4 1 1 1s1-.4 1-1V9h6c.6 0 1-.4 1-1s-.4-1-1-1z" />
      </svg>
      <span class="max-xs:sr-only"><%= t("dashboard.main.header.manage_licenses") %></span>
    <% end %>
  </div>
</div>

<!-- Cards -->
<div class="grid grid-cols-12 gap-6">

  <!-- Page Intro -->
  <div class="flex flex-col col-span-full bg-white dark:bg-gray-800 shadow-xs rounded-xl">
    <div class="px-5 py-6">
      <div class="md:flex md:justify-between md:items-center">
        <div class="flex items-center mb-4 md:mb-0">
          <div class="mr-4">
            <%= image_tag "mosaic/images/avatar-04.jpg",
                          class: "inline-flex rounded-full",
                          width: 64,
                          height: 64,
                          alt: t("dashboard.header.user_avatar_alt") %>
          </div>
          <div>
            <div class="mb-2 text-gray-600 dark:text-gray-300">
              <%= t(
                    "dashboard.main.intro.greeting_html",
                    name: content_tag(:strong, user_label, class: "font-medium text-gray-800 dark:text-gray-100")
                  ).html_safe %>
            </div>
            <div class="text-3xl font-bold text-green-500"><%= intro[:total_pnl] %></div>
          </div>
        </div>
        <ul class="shrink-0 flex flex-wrap justify-end md:justify-start -space-x-3 -ml-px">
          <% intro[:brokers].to_a.compact.each do |broker| %>
            <li>
              <a class="block" href="#0">
                <div class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 dark:bg-gray-700/60 text-xs font-semibold text-gray-700 dark:text-gray-100">
                  <%= broker.to_s.first(2).upcase %>
                </div>
              </a>
            </li>
          <% end %>
          <li>
            <button class="flex justify-center items-center w-9 h-9 rounded-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-teal-500 shadow-xs transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500/40 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900">
              <span class="sr-only"><%= t("dashboard.main.intro.add_broker") %></span>
              <svg class="fill-current" width="16" height="16" viewBox="0 0 16 16">
                <path d="M15 7H9V1c0-.6-.4-1-1-1S7 .4 7 1v6H1c-.6 0-1 .4-1 1s.4 1 1 1h6v6c0 .6.4 1 1 1s1-.4 1-1V9h6c.6 0 1-.4 1-1s-.4-1-1-1z" />
              </svg>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Line chart (Portfolio Returns) -->
  <div class="flex flex-col col-span-full xl:col-span-8 bg-white dark:bg-gray-800 shadow-xs rounded-xl">
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-center">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.main.pnl_card.title") %></h2>
    </header>
    <div class="px-5 py-3">
      <div class="flex flex-wrap justify-between items-end gap-y-2 gap-x-4">
        <div class="flex items-center">
          <div class="text-3xl font-bold text-gray-800 dark:text-gray-100 mr-2"><%= pnl[:total] %></div>
          <div class="text-sm text-gray-500 dark:text-gray-400">
            <span class="font-medium text-gray-800 dark:text-gray-100"><%= pnl[:average] %></span>
            <%= t("dashboard.main.pnl_card.average_label") %>
          </div>
        </div>
        <div id="fintech-card-01-legend" class="grow mb-1">
          <ul class="flex flex-wrap gap-x-4 sm:justify-end"></ul>
        </div>
      </div>
    </div>
    <div class="grow">
      <% if pnl[:chart].present? %>
        <canvas
          id="fintech-card-01"
          width="800"
          height="300"
          data-dashboard-chart="true"
          data-chart="<%= json_escape(pnl[:chart].to_json) %>"
          data-chart-style="main-line"
          data-chart-format="currency"
        ></canvas>
      <% else %>
        <div class="h-full flex items-center justify-center text-sm text-gray-500 dark:text-gray-400">
          <%= t("dashboard.main.pnl_card.empty") %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Plan actual -->
  <div class="flex flex-col col-span-full xl:col-span-4 bg-white dark:bg-gray-800 shadow-xs rounded-xl">
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-center justify-between">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.main.plan_card.title") %></h2>
      <span class="inline-flex items-center rounded-full text-xs font-medium px-2 py-0.5 <%= plan[:status_class] %>">
        <%= plan[:status_label] %>
      </span>
    </header>
    <div class="flex flex-col h-full">
      <div class="px-5 py-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.main.plan_card.plan_label") %></div>
            <div class="text-2xl font-bold text-gray-800 dark:text-gray-100"><%= plan[:label].presence || t("dashboard.plans.placeholder") %></div>
          </div>
          <div class="text-right">
            <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.main.plan_card.price_label") %></div>
            <% price_label = if plan[:price_amount].present? && plan[:price_interval].present?
              t("dashboard.main.plan_card.price", amount: plan[:price_amount], interval: plan[:price_interval])
            elsif plan[:price_amount].present?
              plan[:price_amount]
            else
              t("dashboard.plans.placeholder")
            end %>
            <div class="text-lg font-semibold text-gray-800 dark:text-gray-100"><%= price_label %></div>
          </div>
        </div>
        <div class="mt-4">
          <div class="flex items-center justify-between text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide">
            <span><%= t("dashboard.main.plan_card.usage_label") %></span>
            <span class="normal-case text-gray-500 dark:text-gray-400">
              <%= t(
                    "dashboard.main.plan_card.usage_value",
                    active: plan[:usage][:active],
                    total: plan[:usage][:total],
                    percent: plan[:usage][:percent]
                  ) %>
            </span>
          </div>
          <div class="mt-2 w-full h-2 bg-gray-100 dark:bg-gray-700/60 rounded-full">
            <div class="h-2 rounded-full bg-teal-500" style="width: <%= plan[:usage][:percent] %>%;"></div>
          </div>
        </div>
        <div class="mt-4">
          <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.main.plan_card.benefits_title") %></div>
          <ul class="mt-2 space-y-1 text-sm text-gray-600 dark:text-gray-300">
            <% if plan[:benefits].present? %>
              <% plan[:benefits].each do |benefit| %>
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-1.5 w-1.5 rounded-full bg-teal-500 shrink-0"></span>
                  <%= benefit %>
                </li>
              <% end %>
            <% else %>
              <li class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.main.plan_card.benefits_empty") %></li>
            <% end %>
          </ul>
        </div>
        <div class="mt-4">
          <div class="text-xs uppercase text-gray-400 dark:text-gray-500 tracking-wide"><%= t("dashboard.main.plan_card.renewal_label") %></div>
          <% if plan[:renews_at].present? %>
            <div class="flex items-baseline gap-2">
              <div class="text-lg font-semibold text-amber-600"><%= t("dashboard.main.plan_card.renews_on", date: l(plan[:renews_at].to_date)) %></div>
            </div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t("dashboard.main.plan_card.auto_renew_note") %></div>
          <% else %>
            <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.main.plan_card.empty") %></div>
          <% end %>
          <% if plan[:scheduled_change].present? && plan[:scheduled_change][:effective_at].present? %>
            <div class="text-xs text-amber-600 dark:text-amber-300 mt-2">
              <%= t("dashboard.main.plan_card.scheduled_change", plan: plan[:scheduled_change][:label], date: l(plan[:scheduled_change][:effective_at].to_date)) %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="mt-auto px-5 pb-4 flex justify-center">
        <% cta = plan[:cta] %>
        <% if cta[:type] == :disabled %>
          <button class="btn bg-gray-900/60 text-gray-100 dark:bg-gray-100/60 dark:text-gray-800 w-full max-w-xs px-8 py-3 text-base cursor-not-allowed" type="button" disabled>
            <%= cta[:label] %>
          </button>
        <% else %>
          <% cta_path = cta[:type] == :marketplace ? dashboard_marketplace_path : dashboard_plans_path %>
          <%= link_to cta[:label],
                      cta_path,
                      class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white w-full max-w-xs px-8 py-3 text-base" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Line chart (Portfolio Returns) -->
  <div class="flex flex-col col-span-full sm:col-span-12 xl:col-span-4 bg-white dark:bg-gray-800 shadow-xs rounded-xl">
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-center">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.main.licenses_card.title") %></h2>
    </header>
    <div class="px-5 py-3">
      <div class="text-sm italic mb-2"><%= t("dashboard.main.licenses_card.subtitle") %></div>
      <div class="flex items-center">
        <div class="text-3xl font-bold text-gray-800 dark:text-gray-100 mr-2"><%= licenses_card[:active_count] %></div>
        <div class="text-sm">
          <span class="font-medium text-yellow-600"><%= t("dashboard.main.licenses_card.trials_label", count: licenses_card[:trial_count]) %></span>
        </div>
      </div>
      <div class="text-sm text-gray-500 dark:text-gray-400">
        <% if licenses_card[:renewal_at].present? %>
          <%= t("dashboard.main.licenses_card.renews_on", date: l(licenses_card[:renewal_at].to_date)) %>
        <% else %>
          <%= t("dashboard.main.licenses_card.empty") %>
        <% end %>
      </div>
    </div>
    <div class="grow">
      <canvas
        id="fintech-card-07"
        width="389"
        height="262"
        data-dashboard-chart="true"
        data-chart="<%= json_escape(licenses_card[:chart].to_json) %>"
        data-chart-style="card-line"
        data-chart-format="count"
      ></canvas>
    </div>
  </div>

  <!-- Line chart (Growth Portfolio) -->
  <div class="flex flex-col col-span-full sm:col-span-6 xl:col-span-4 bg-white dark:bg-gray-800 shadow-xs rounded-xl">
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-center">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.main.course_progress_card.title") %></h2>
    </header>
    <div class="px-5 py-3">
      <div class="text-sm italic mb-2"><%= t("dashboard.main.course_progress_card.subtitle") %></div>
      <% if course_progress[:progress_percent].present? %>
        <div class="text-3xl font-bold text-gray-800 dark:text-gray-100">
          <%= t("dashboard.main.course_progress_card.progress_label", percent: course_progress[:progress_percent]) %>
        </div>
        <div class="text-sm text-gray-500 dark:text-gray-400">
          <%= t("dashboard.main.course_progress_card.course_label", title: course_progress[:course_title]) %>
        </div>
      <% else %>
        <div class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.main.course_progress_card.empty") %></div>
      <% end %>
    </div>
    <div class="grow">
      <canvas
        id="fintech-card-08"
        width="389"
        height="262"
        data-dashboard-chart="true"
        data-chart="<%= json_escape(course_progress[:chart].to_json) %>"
        data-chart-style="card-line"
        data-chart-format="count"
      ></canvas>
    </div>
  </div>

  <!-- Pie chart (Portfolio Value) -->
  <div class="flex flex-col col-span-full sm:col-span-6 xl:col-span-4 bg-white dark:bg-gray-800 shadow-xs rounded-xl">
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-center">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.main.balance_card.title") %></h2>
    </header>
    <div class="px-5 py-3">
      <div class="text-sm italic mb-2"><%= t("dashboard.main.balance_card.subtitle") %></div>
      <div class="text-3xl font-bold text-gray-800 dark:text-gray-100"><%= balance[:total] %></div>
    </div>
    <div class="grow flex flex-col justify-center">
      <% if balance[:chart].present? %>
        <div>
          <canvas
            id="fintech-card-09"
            width="389"
            height="220"
            data-dashboard-chart="true"
            data-chart="<%= json_escape(balance[:chart].to_json) %>"
            data-chart-style="pie"
            data-chart-format="currency"
          ></canvas>
        </div>
        <div id="fintech-card-09-legend" class="px-5 py-4">
          <ul class="flex flex-wrap justify-center -m-1"></ul>
        </div>
      <% else %>
        <div class="px-5 py-6 text-sm text-gray-500 dark:text-gray-400">
          <%= t("dashboard.main.balance_card.empty") %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Line charts (Stock graphs) -->
  <% mini_chart_ids = %w[fintech-card-10 fintech-card-11 fintech-card-12 fintech-card-13] %>
  <% mini_cards.each_with_index do |card, idx| %>
    <% change_class = card[:change][:delta].negative? ? "text-rose-600" : "text-green-600" %>
    <% change_text = t("dashboard.main.mini_cards.#{card[:key]}.change", delta: card[:change][:delta_label], percent: card[:change][:percent]) %>
    <% title_suffix = t("dashboard.main.mini_cards.#{card[:key]}.suffix", default: "") %>
    <% title_size_class = card[:key] == :active_licenses ? "text-xs" : "text-sm" %>
    <%= render "dashboards/main/mini_card",
               title: t("dashboard.main.mini_cards.#{card[:key]}.title"),
               title_suffix: title_suffix,
               title_size_class: title_size_class,
               value: card[:total],
               change_text: change_text,
               change_class: change_class,
               chart_id: mini_chart_ids[idx],
               chart_payload: card[:chart] %>
  <% end %>

  <!-- Table (Market Trends) -->
  <div class="col-span-full bg-white dark:bg-gray-800 shadow-xs rounded-xl">
    <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.main.account_summary.title") %></h2>
    </header>
    <div class="p-3">
      <div class="overflow-x-auto">
        <table class="table-auto w-full dark:text-gray-300">
          <thead class="text-xs uppercase text-gray-400 dark:text-gray-500 bg-gray-50 dark:bg-gray-700/50 rounded-xs">
            <tr>
              <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left"><%= t("dashboard.main.account_summary.columns.area") %></div></th>
              <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left"><%= t("dashboard.main.account_summary.columns.total") %></div></th>
              <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left"><%= t("dashboard.main.account_summary.columns.trend") %></div></th>
              <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left"><%= t("dashboard.main.account_summary.columns.usd") %></div></th>
              <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left"><%= t("dashboard.main.account_summary.columns.status") %></div></th>
            </tr>
          </thead>
          <tbody class="text-sm font-medium divide-y divide-gray-100 dark:divide-gray-700/60">
            <% if summary_rows.present? %>
              <% summary_rows.each do |row| %>
                <%= render "dashboards/main/summary_row", row: row %>
              <% end %>
            <% else %>
              <tr>
                <td class="p-4 text-sm text-gray-500 dark:text-gray-400" colspan="5">
                  <%= t("dashboard.main.account_summary.empty") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
