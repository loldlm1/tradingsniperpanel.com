<% storage_key = ["dashboard-discount-modal", banner[:percent], banner[:code].to_s.parameterize(separator: "-")].join("-") %>

<div
  x-data="{
    modalOpen: false,
    storageKey: '<%= storage_key %>',
    init() {
      let alreadySeen = false
      try {
        alreadySeen = window.sessionStorage.getItem(this.storageKey) === '1'
      } catch (error) {
        alreadySeen = false
      }
      if (alreadySeen) return

      this.modalOpen = true
      try {
        window.sessionStorage.setItem(this.storageKey, '1')
      } catch (error) {
        // no-op: keep modal behavior even when storage is restricted
      }
    },
    close() {
      this.modalOpen = false
    }
  }"
>
  <!-- Modal backdrop -->
  <div
    class="fixed inset-0 bg-gray-900/30 z-50 transition-opacity"
    x-show="modalOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-out duration-100"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    aria-hidden="true"
    @click="close"
    x-cloak
  ></div>

  <!-- Modal dialog -->
  <div
    id="dashboard-discount-modal"
    class="fixed inset-0 z-50 overflow-hidden flex items-start top-20 mb-4 justify-center px-4 sm:px-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dashboard-discount-modal-title"
    x-show="modalOpen"
    x-transition:enter="transition ease-in-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in-out duration-200"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-4"
    x-cloak
  >
    <div
      class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700/60 overflow-auto max-w-lg w-full max-h-full rounded-lg shadow-lg"
      @click.outside="close"
      @keydown.escape.window="close"
    >
      <div class="px-5 py-3 border-b border-gray-200 dark:border-gray-700/60">
        <div class="flex justify-between items-center gap-3">
          <span class="inline-flex items-center rounded-full text-xs font-semibold px-2 py-0.5 bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-100">
            <%= t("dashboard.discount_modal.badge") %>
          </span>
          <button
            type="button"
            class="text-gray-400 dark:text-gray-500 hover:text-gray-500 dark:hover:text-gray-400"
            aria-label="<%= t("dashboard.discount_modal.close") %>"
            @click="close"
          >
            <svg class="fill-current" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M7.95 6.536l4.242-4.243a1 1 0 111.415 1.414L9.364 7.95l4.243 4.242a1 1 0 11-1.415 1.415L7.95 9.364l-4.243 4.243a1 1 0 01-1.414-1.415L6.536 7.95 2.293 3.707a1 1 0 011.414-1.414L7.95 6.536z" />
            </svg>
          </button>
        </div>
      </div>

      <div class="px-5 py-4">
        <h2 id="dashboard-discount-modal-title" class="text-xl font-semibold text-gray-800 dark:text-gray-100">
          <%= t("dashboard.discount_modal.title", percent: banner[:percent]) %>
        </h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          <%= t("dashboard.discount_modal.body") %>
        </p>

        <div class="mt-4 rounded-lg border border-gray-200 dark:border-gray-700/60 bg-gray-50 dark:bg-gray-900/40 px-4 py-3">
          <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"><%= t("dashboard.discount_modal.code_label") %></div>
          <div class="mt-1 text-xl font-bold text-gray-900 dark:text-gray-100"><%= banner[:code] %></div>
        </div>
      </div>

      <div class="px-5 py-4 border-t border-gray-200 dark:border-gray-700/60">
        <div class="flex flex-wrap justify-end gap-2">
          <button
            type="button"
            class="btn-sm border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300"
            @click="close"
          ><%= t("dashboard.discount_modal.dismiss") %></button>
          <%= link_to t("dashboard.discount_modal.cta"),
                      dashboard_plans_path,
                      class: "btn-sm bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white",
                      data: { loading_target: true } %>
        </div>
      </div>
    </div>
  </div>
</div>
