<tr>
  <td class="p-2 whitespace-nowrap md:w-1/2">
    <div class="flex items-center">
      <div class="shrink-0 mr-2 sm:mr-3 flex items-center justify-center w-9 h-9 rounded-full <%= row[:badge_class] %> text-white text-xs font-semibold">
        <%= row[:badge_label] %>
      </div>
      <div>
        <div class="text-gray-800 dark:text-gray-100 uppercase"><%= row[:name] %></div>
        <div class="text-xs text-gray-500"><%= row[:status_label] %></div>
      </div>
    </div>
  </td>
  <td class="p-2 whitespace-nowrap">
    <div class="font-normal text-left"><%= row[:total_accounts] %></div>
  </td>
  <td class="p-2 whitespace-nowrap">
    <div class="w-[96px]">
      <canvas
        id="<%= row[:chart_id] %>"
        width="96"
        height="32"
        data-dashboard-chart="true"
        data-chart="<%= json_escape(row[:chart].to_json) %>"
        data-chart-style="sparkline"
        data-chart-format="currency"
      ></canvas>
    </div>
  </td>
  <td class="p-2 whitespace-nowrap">
    <div class="text-left"><%= row[:pnl_total] %></div>
  </td>
  <td class="p-2 whitespace-nowrap">
    <div class="text-left <%= row[:status_class] %>"><%= row[:status_label] %></div>
  </td>
</tr>
