<% content_for :title, "#{app_short_name} - #{t('dashboard.discord.page_title')}" %>

<!-- Page header -->
<div class="mb-8">
  <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.discord.page_title") %></h1>
</div>

<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl mb-8">
  <!-- Panel -->
  <div class="grow">
    <!-- Panel body -->
    <div class="p-6 space-y-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:bg-brand-500/20 dark:text-brand-300" aria-hidden="true">
            <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
              <path d="M19.3 5.34A16.7 16.7 0 0 0 15.18 4l-.5 1.02a15.2 15.2 0 0 0-5.36 0L8.82 4A16.8 16.8 0 0 0 4.7 5.34C2.1 9.22 1.4 13 1.75 16.73a16.9 16.9 0 0 0 5.06 2.55l1.22-1.67a10.8 10.8 0 0 1-1.92-.92l.47-.36c3.7 1.72 7.72 1.72 11.38 0l.48.36c-.62.36-1.26.67-1.93.92l1.22 1.67a16.8 16.8 0 0 0 5.05-2.55c.42-4.32-.72-8.06-3.48-11.39ZM8.55 14.45c-1.11 0-2.03-1.03-2.03-2.29 0-1.26.9-2.29 2.03-2.29 1.14 0 2.05 1.04 2.03 2.29 0 1.26-.9 2.29-2.03 2.29Zm6.9 0c-1.11 0-2.03-1.03-2.03-2.29 0-1.26.9-2.29 2.03-2.29 1.14 0 2.05 1.04 2.03 2.29 0 1.26-.89 2.29-2.03 2.29Z" />
            </svg>
          </div>
          <div>
            <h2 class="text-2xl text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.discord.panel_title") %></h2>
            <p class="mt-1 max-w-2xl text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.discord.panel_description") %></p>
          </div>
        </div>
        <span class="inline-flex self-start rounded-full border border-gray-200 bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700 dark:border-gray-500 dark:bg-gray-700 dark:text-gray-100">
          <%= t("dashboard.discord.states.#{@discord.state}.label") %>
        </span>
      </div>

      <!-- Connection status -->
      <section class="rounded-xl border border-gray-200 bg-gray-50/70 p-5 dark:border-gray-700/60 dark:bg-gray-900/20">
        <h3 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.discord.states.#{@discord.state}.title") %></h3>
        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("dashboard.discord.states.#{@discord.state}.body") %></p>

        <% if @discord.identity_label.present? %>
          <dl class="mt-5 grid gap-4 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500"><%= t("dashboard.discord.details.account") %></dt>
              <dd class="mt-1 text-sm font-medium text-gray-800 dark:text-gray-100"><%= @discord.identity_label %></dd>
            </div>
            <% if @discord.last_synced_at.present? %>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500"><%= t("dashboard.discord.details.last_sync") %></dt>
                <dd class="mt-1 text-sm font-medium text-gray-800 dark:text-gray-100"><%= l(@discord.last_synced_at, format: :long) %></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </section>

      <!-- VIP benefits -->
      <section>
        <h3 class="text-xl leading-snug text-gray-800 dark:text-gray-100 font-bold"><%= t("dashboard.discord.benefits.title") %></h3>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <% %w[recorded_courses live_sessions new_presets priority_support].each do |benefit| %>
            <div class="flex items-start gap-3 rounded-lg border border-gray-200 p-4 dark:border-gray-700/60">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-300" aria-hidden="true">✓</span>
              <div>
                <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("dashboard.discord.benefits.#{benefit}.title") %></div>
                <div class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.discord.benefits.#{benefit}.body") %></div>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <% if @discord.state.in?([ :pending_join, :membership_screening ]) %>
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200" role="status">
          <%= t("dashboard.discord.membership_screening") %>
        </div>
      <% end %>
    </div>

    <!-- Panel footer -->
    <footer>
      <div class="flex flex-col gap-3 border-t border-gray-200 px-6 py-5 dark:border-gray-700/60 sm:flex-row sm:flex-wrap sm:items-center sm:justify-end">
        <% if @discord.view_plans %>
          <%= link_to t("dashboard.discord.actions.view_plans"), dashboard_plans_path, class: "btn dark:bg-gray-800 border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300" %>
        <% end %>
        <% if @discord.contact_support %>
          <%= link_to t("dashboard.discord.actions.contact_support"), dashboard_support_path, class: "btn dark:bg-gray-800 border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300" %>
        <% end %>
        <% if @discord.open_discord %>
          <%= link_to t("dashboard.discord.actions.open_discord"), @discord.support_url, target: "_blank", rel: "noopener noreferrer", class: "btn dark:bg-gray-800 border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300" %>
        <% end %>
        <% if @discord.retryable %>
          <%= button_to t("dashboard.discord.actions.retry"), retry_dashboard_discord_connection_path, method: :post, class: "btn dark:bg-gray-800 border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300" %>
        <% end %>
        <% if @discord.disconnectable %>
          <%= button_to t("dashboard.discord.actions.disconnect"), unlink_dashboard_discord_connection_path, method: :delete, class: "btn border-rose-200 bg-rose-50 text-rose-700 hover:border-rose-300 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300", data: { turbo_confirm: t("dashboard.discord.disconnect_confirm") } %>
        <% end %>
        <% if @discord.connectable %>
          <%= link_to t("dashboard.discord.actions.connect"), authorize_dashboard_discord_connection_path, class: "btn bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white" %>
        <% end %>
      </div>
    </footer>
  </div>
</div>
