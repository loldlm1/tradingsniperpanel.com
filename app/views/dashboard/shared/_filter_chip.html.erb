<% label = local_assigns.fetch(:label) %>
<% href = local_assigns.fetch(:href, "#") %>
<% class_name = local_assigns.fetch(:class_name, "") %>
<% base_class = "inline-flex items-center justify-center text-sm font-medium leading-5 rounded-full px-3 py-1 border border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 shadow-xs bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400 transition" %>

<%= link_to label, href, class: [base_class, class_name].reject(&:blank?).join(" ") %>
