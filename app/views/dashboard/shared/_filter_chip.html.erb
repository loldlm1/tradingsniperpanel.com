<% label = local_assigns.fetch(:label) %>
<% href = local_assigns.fetch(:href, "#") %>
<% class_name = local_assigns.fetch(:class_name, "") %>
<% base_class = "btn-xs text-xs border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300 px-2.5 py-1 rounded-full shadow-none" %>

<%= link_to label, href, class: [base_class, class_name].reject(&:blank?).join(" ") %>
