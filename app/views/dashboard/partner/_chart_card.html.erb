<div class="flex flex-col h-full bg-white dark:bg-gray-800 shadow-xs rounded-xl">
  <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-2xl">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.monthly_revenue") %></h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.monthly_revenue_copy") %></p>
    </div>
    <div class="inline-flex items-center rounded-full bg-brand-500/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-brand-600 dark:bg-brand-500/20 dark:text-brand-300">
      <%= t("partner_dashboard.placeholder_data") %>
    </div>
  </header>

  <div class="px-5 py-1 border-b border-gray-100 dark:border-gray-700/60">
    <div class="flex flex-wrap max-sm:*:w-1/2">
      <% highlight_metrics.each_with_index do |metric, index| %>
        <div class="flex items-center py-2">
          <div class="<%= index == highlight_metrics.size - 1 ? '' : 'mr-5' %>">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-2.5 w-2.5 rounded-full <%= tone_class(metric[:tone]) %>"></span>
              <div class="text-sm text-gray-500 dark:text-gray-400"><%= metric[:label] %></div>
            </div>
            <div class="mt-2 text-3xl font-bold text-gray-800 dark:text-gray-100"><%= metric[:value] %></div>
          </div>
          <% if index < highlight_metrics.size - 1 %>
            <div class="hidden md:block w-px h-8 bg-gray-200 dark:bg-gray-700/60 <%= index == highlight_metrics.size - 1 ? '' : 'mr-5' %>" aria-hidden="true"></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="px-5 py-5">
    <div class="flex flex-col gap-4 md:flex-row">
      <% chart_summary.each do |summary| %>
        <div class="min-w-0 flex-1 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
          <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= summary[:label] %></div>
          <div class="mt-2 text-xl font-semibold text-gray-800 dark:text-gray-100"><%= summary[:value] %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
