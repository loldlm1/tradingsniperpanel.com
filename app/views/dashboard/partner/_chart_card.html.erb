<div class="relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white/95 shadow-sm shadow-slate-200/70 dark:border-slate-700/70 dark:bg-slate-800/95 dark:shadow-none">
  <div class="absolute inset-x-0 top-0 h-28 bg-linear-to-r from-sky-100 via-white to-emerald-50 dark:from-sky-500/10 dark:via-slate-800 dark:to-emerald-500/10"></div>
  <div class="absolute -right-8 top-6 h-28 w-28 rounded-full bg-sky-200/50 blur-2xl dark:bg-sky-400/10"></div>
  <div class="absolute left-10 top-16 h-20 w-20 rounded-full bg-emerald-100/70 blur-2xl dark:bg-emerald-400/10"></div>

  <div class="relative border-b border-slate-200/80 px-5 py-5 dark:border-slate-700/70 sm:px-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-2xl">
        <div class="text-sm font-semibold text-slate-950 dark:text-white"><%= t("partner_dashboard.monthly_revenue") %></div>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= t("partner_dashboard.monthly_revenue_copy") %></p>
      </div>
      <div class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/85 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 shadow-sm dark:border-slate-700/70 dark:bg-slate-900/70 dark:text-slate-300">
        <%= t("partner_dashboard.placeholder_data") %>
      </div>
    </div>

    <div class="mt-5 grid gap-3 md:grid-cols-3">
      <% chart_summary.each do |summary| %>
        <div class="rounded-2xl border border-white/80 bg-white/80 px-4 py-3 shadow-sm shadow-slate-100/80 backdrop-blur dark:border-slate-700/70 dark:bg-slate-900/50 dark:shadow-none">
          <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400"><%= summary[:label] %></div>
          <div class="mt-2 text-xl font-semibold tracking-tight text-slate-950 dark:text-white"><%= summary[:value] %></div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="relative h-[320px] px-4 pb-5 pt-4 sm:h-[360px] sm:px-6 sm:pb-6">
    <canvas id="partner-paid-earnings-chart" data-partner-chart="<%= chart_data.to_json %>" class="h-full w-full"></canvas>
  </div>
</div>
