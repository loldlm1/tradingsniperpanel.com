<% action_tone = case partner_dashboard.payout_status_key
                 when :eligible then "emerald"
                 when :notification_failed then "rose"
                 when :request_pending then "amber"
                 else "slate"
                 end %>
<% progress_percent = payout_progress_percent(requestable_cents: metrics[:requestable_cents], payout_target_cents: partner_dashboard.payout_target_cents) %>

<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl">
  <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.payout_action") %></p>
      <h2 class="mt-2 text-lg font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.payout_ready_title") %></h2>
    </div>
    <div class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-300 <%= tone_surface_class(action_tone) %>">
      <%= number_to_currency(metrics[:requestable_cents].to_i / 100.0) %>
    </div>
  </div>

  <div class="p-5">
    <p class="text-sm leading-6 text-gray-500 dark:text-gray-400"><%= partner_dashboard.payout_status_message %></p>

    <div class="mt-5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
      <div class="flex items-center justify-between gap-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500">
        <span><%= t("partner_dashboard.threshold_progress") %></span>
        <span><%= number_to_currency(metrics[:requestable_cents].to_i / 100.0) %> / <%= number_to_currency(partner_dashboard.payout_target_cents / 100.0) %></span>
      </div>
      <div class="mt-3 h-2 rounded-full bg-gray-200 dark:bg-gray-700/60">
        <div class="h-2 rounded-full bg-brand-500" style="width: <%= progress_percent %>%"></div>
      </div>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.metrics.requestable") %></div>
        <div class="mt-2 text-xl font-semibold text-gray-800 dark:text-gray-100"><%= number_to_currency(metrics[:requestable_cents].to_i / 100.0) %></div>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.payout_target_label") %></div>
        <div class="mt-2 text-xl font-semibold text-gray-800 dark:text-gray-100"><%= number_to_currency(partner_dashboard.payout_target_cents / 100.0) %></div>
      </div>
    </div>

    <% if current_request.present? %>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <%= render "dashboard/shared/badge",
                   label: payout_request_status_label(current_request),
                   padding_class: "px-2.5 py-1",
                   class_name: payout_request_status_badge_class(current_request) %>
        <%= render "dashboard/shared/badge",
                   label: payout_request_notification_label(current_request),
                   padding_class: "px-2.5 py-1",
                   class_name: payout_request_notification_badge_class(current_request) %>
      </div>
    <% end %>

    <div class="mt-5">
      <% button_classes = if partner_dashboard.payout_button_disabled?
                            "btn w-full cursor-not-allowed bg-gray-100 dark:bg-gray-700/60 border border-gray-200 dark:border-gray-700/60 text-gray-400 dark:text-gray-500"
                          else
                            "btn w-full bg-gray-900 text-gray-100 hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-800 dark:hover:bg-white"
                          end %>
      <%= button_to request_payout_dashboard_partner_path,
                    method: :post,
                    disabled: partner_dashboard.payout_button_disabled?,
                    class: button_classes,
                    data: { loading_target: true } do %>
        <span class="inline-flex items-center justify-center"><%= loading_label(partner_dashboard.payout_button_label, loading_text: t("loading.default")) %></span>
      <% end %>
    </div>
  </div>
</div>
