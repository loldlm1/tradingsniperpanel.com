<% share_url = referral_share_url(profile) %>

<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl">
  <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.referral_hub") %></p>
      <h2 class="mt-2 text-lg font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.referral_code") %></h2>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.referral_hub_copy") %></p>
    </div>
    <span class="inline-flex items-center rounded-full bg-brand-500/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-brand-600 dark:bg-brand-500/20 dark:text-brand-300">
      <%= t("partner_dashboard.program_active") %>
    </span>
  </div>

  <div class="p-5 space-y-5">
    <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 p-4 shadow-xs">
      <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.referral_code") %></div>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="font-mono text-2xl font-semibold tracking-[0.18em] text-gray-800 dark:text-gray-100">
          <%= partner_dashboard.referral_code %>
        </div>
        <button
          type="button"
          class="btn-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300"
          data-copy-button="true"
          data-copy-text="<%= partner_dashboard.referral_code %>"
          data-default-text="<%= t('partner_dashboard.copy_code') %>"
          data-copied-text="<%= t('partner_dashboard.copied') %>"
          data-copy-failed-text="<%= t('partner_dashboard.copy_failed') %>">
          <%= t("partner_dashboard.copy_code") %>
        </button>
      </div>
    </div>

    <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 p-4 shadow-xs">
      <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.share_link") %></div>
      <p class="mt-2 break-all text-sm leading-6 text-gray-600 dark:text-gray-300"><%= share_url %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button
          type="button"
          class="btn-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 text-gray-800 dark:text-gray-300"
          data-copy-button="true"
          data-copy-text="<%= share_url %>"
          data-default-text="<%= t('partner_dashboard.copy_link') %>"
          data-copied-text="<%= t('partner_dashboard.copied') %>"
          data-copy-failed-text="<%= t('partner_dashboard.copy_failed') %>">
          <%= t("partner_dashboard.copy_link") %>
        </button>
      </div>
    </div>
  </div>
</div>
