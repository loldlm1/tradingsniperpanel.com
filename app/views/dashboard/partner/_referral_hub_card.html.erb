<% share_url = referral_share_url(profile) %>

<div class="rounded-[1.75rem] border border-slate-200/80 bg-white/95 p-5 shadow-sm shadow-slate-200/70 dark:border-slate-700/70 dark:bg-slate-800/95 dark:shadow-none">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400"><%= t("partner_dashboard.referral_hub") %></p>
      <h2 class="mt-2 text-lg font-semibold tracking-tight text-slate-950 dark:text-white"><%= t("partner_dashboard.referral_code") %></h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= t("partner_dashboard.referral_hub_copy") %></p>
    </div>
    <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-200">
      <%= t("partner_dashboard.program_active") %>
    </span>
  </div>

  <div class="mt-5 rounded-2xl border border-slate-200/80 bg-slate-50/80 p-4 dark:border-slate-700/70 dark:bg-slate-900/50">
    <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400"><%= t("partner_dashboard.referral_code") %></div>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="font-mono text-2xl font-semibold tracking-[0.18em] text-slate-950 dark:text-white">
        <%= partner_dashboard.referral_code %>
      </div>
      <button
        type="button"
        class="btn-sm border border-slate-200 bg-white text-slate-700 hover:border-slate-300 dark:border-slate-700/60 dark:bg-slate-800 dark:text-slate-200"
        data-copy-button="true"
        data-copy-text="<%= partner_dashboard.referral_code %>"
        data-default-text="<%= t('partner_dashboard.copy_code') %>"
        data-copied-text="<%= t('partner_dashboard.copied') %>"
        data-copy-failed-text="<%= t('partner_dashboard.copy_failed') %>">
        <%= t("partner_dashboard.copy_code") %>
      </button>
    </div>
  </div>

  <div class="mt-4 rounded-2xl border border-slate-200/80 bg-slate-50/80 p-4 dark:border-slate-700/70 dark:bg-slate-900/50">
    <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400"><%= t("partner_dashboard.share_link") %></div>
    <p class="mt-2 break-all text-sm leading-6 text-slate-700 dark:text-slate-200"><%= share_url %></p>
    <button
      type="button"
      class="btn-sm mt-3 border border-slate-200 bg-white text-slate-700 hover:border-slate-300 dark:border-slate-700/60 dark:bg-slate-800 dark:text-slate-200"
      data-copy-button="true"
      data-copy-text="<%= share_url %>"
      data-default-text="<%= t('partner_dashboard.copy_link') %>"
      data-copied-text="<%= t('partner_dashboard.copied') %>"
      data-copy-failed-text="<%= t('partner_dashboard.copy_failed') %>">
      <%= t("partner_dashboard.copy_link") %>
    </button>
  </div>
</div>
