<% content_for :title, "#{t('partner_dashboard.title', default: 'Partner Dashboard')} | #{app_short_name}" %>

<!-- Page header -->
<div class="mb-8 flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
  <div class="max-w-3xl">
    <p class="mb-3 inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-sky-700 dark:border-sky-500/30 dark:bg-sky-500/10 dark:text-sky-200">
      <%= t("partner_dashboard.title", default: "Partner Dashboard") %>
    </p>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 md:text-3xl">
      <%= t("partner_dashboard.subtitle", default: "Track your partner code, direct referrals, and payout progress.") %>
    </h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600 dark:text-gray-300">
      <%= t("partner_dashboard.subtitle_copy", default: "Only direct referrals are tracked here. Referral discounts are applied first at checkout, and payout requests unlock once your requestable balance reaches $200.") %>
    </p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 xl:w-[420px]">
    <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">
        <%= t("partner_dashboard.referral_code", default: "Referral code") %>
      </div>
      <div class="mt-2 flex items-center justify-between gap-3">
        <div class="font-mono text-xl font-semibold tracking-[0.18em] text-gray-900 dark:text-gray-100">
          <%= @partner_dashboard.referral_code %>
        </div>
        <button
          type="button"
          class="btn-sm border border-gray-200 bg-white text-gray-700 hover:border-gray-300 dark:border-gray-700/60 dark:bg-gray-900 dark:text-gray-200"
          data-copy-button="true"
          data-copy-text="<%= @partner_dashboard.referral_code %>"
          data-default-text="<%= t('partner_dashboard.copy_code', default: 'Copy') %>"
          data-copied-text="<%= t('partner_dashboard.copied', default: 'Copied') %>"
          data-copy-failed-text="<%= t('partner_dashboard.copy_failed', default: 'Copy failed') %>">
          <%= t("partner_dashboard.copy_code", default: "Copy") %>
        </button>
      </div>
    </div>

    <%= button_to request_payout_dashboard_partner_path,
                  method: :post,
                  disabled: @partner_dashboard.payout_button_disabled?,
                  class: "rounded-2xl border px-4 py-4 text-left transition #{ @partner_dashboard.payout_button_disabled? ? 'cursor-not-allowed border-gray-200 bg-gray-100 text-gray-400 dark:border-gray-700 dark:bg-gray-800/60 dark:text-gray-500' : 'border-emerald-200 bg-emerald-500 text-white shadow-sm hover:bg-emerald-600 dark:border-emerald-400/30 dark:bg-emerald-500 dark:hover:bg-emerald-400' }",
                  data: { loading_target: true } do %>
      <div class="text-xs font-semibold uppercase tracking-[0.16em] <%= @partner_dashboard.payout_button_disabled? ? '' : 'text-emerald-50/80' %>">
        <%= t("partner_dashboard.payout_action", default: "Payout request") %>
      </div>
      <div class="mt-2 text-lg font-semibold">
        <%= loading_label(@partner_dashboard.payout_button_label, loading_text: t("loading.default")) %>
      </div>
      <div class="mt-2 text-sm leading-6 <%= @partner_dashboard.payout_button_disabled? ? '' : 'text-emerald-50/90' %>">
        <%= @partner_dashboard.payout_status_message %>
      </div>
    <% end %>
  </div>
</div>

<!-- Summary cards -->
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <%= render partial: "dashboard/partner/stat_card", locals: { label: t("partner_dashboard.metrics.requestable", default: "Requestable"), amount_cents: @metrics[:requestable_cents], tone: "amber" } %>
  <%= render partial: "dashboard/partner/stat_card", locals: { label: t("partner_dashboard.metrics.requested", default: "Requested"), amount_cents: @metrics[:requested_cents], tone: "blue" } %>
  <%= render partial: "dashboard/partner/stat_card", locals: { label: t("partner_dashboard.metrics.paid", default: "Paid"), amount_cents: @metrics[:paid_cents], tone: "emerald" } %>
  <%= render partial: "dashboard/partner/stat_card", locals: { label: t("partner_dashboard.metrics.lifetime", default: "Lifetime"), amount_cents: @metrics[:lifetime_cents], tone: "gray" } %>
</div>

<!-- Partner overview -->
<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800 xl:col-span-2">
    <div class="flex flex-wrap items-start justify-between gap-3 border-b border-gray-200 px-5 py-4 dark:border-gray-700">
      <div>
        <div class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= t("partner_dashboard.monthly_revenue", default: "Paid earnings trend") %></div>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.monthly_revenue_copy", default: "Last 6 months of paid commissions.") %></p>
      </div>
      <div class="text-xs uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500">
        <%= t("partner_dashboard.direct_only", default: "Direct referrals only") %>
      </div>
    </div>
    <div class="relative h-72 px-4 py-4 sm:px-6">
      <canvas id="partner-paid-earnings-chart" data-partner-chart="<%= @chart_data.to_json %>" class="h-full w-full"></canvas>
    </div>
  </div>

  <div class="space-y-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= t("partner_dashboard.program_snapshot", default: "Program snapshot") %></div>
      <div class="mt-4 space-y-3 text-sm">
        <div class="flex items-center justify-between gap-4">
          <span class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.discount_percent", default: "Customer discount") %></span>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= @partner_dashboard.discount_percent %>%</span>
        </div>
        <div class="flex items-center justify-between gap-4">
          <span class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.commission_percent", default: "Commission share") %></span>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= @partner_dashboard.commission_percent %>%</span>
        </div>
        <div class="flex items-center justify-between gap-4">
          <span class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.direct_referrals", default: "Direct referrals") %></span>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= @metrics[:direct_referrals_count] %></span>
        </div>
        <div class="flex items-center justify-between gap-4">
          <span class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.subscribers", default: "Subscribers") %></span>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= @metrics[:subscribers_count] %></span>
        </div>
        <div class="flex items-center justify-between gap-4">
          <span class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.current_month", default: "Current month") %></span>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= number_to_currency(@metrics[:current_month_cents].to_i / 100.0) %></span>
        </div>
      </div>
      <div class="mt-5 rounded-xl border border-dashed border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-900/50">
        <div class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.share_link", default: "Share link") %></div>
        <% share_url = referral_share_url(@profile) %>
        <p class="mt-2 break-all text-sm leading-6 text-gray-700 dark:text-gray-200"><%= share_url %></p>
        <button
          type="button"
          class="btn-sm mt-3 border border-gray-200 bg-white text-gray-700 hover:border-gray-300 dark:border-gray-700/60 dark:bg-gray-800 dark:text-gray-200"
          data-copy-button="true"
          data-copy-text="<%= share_url %>"
          data-default-text="<%= t('partner_dashboard.copy_link', default: 'Copy link') %>"
          data-copied-text="<%= t('partner_dashboard.copied', default: 'Copied') %>"
          data-copy-failed-text="<%= t('partner_dashboard.copy_failed', default: 'Copy failed') %>">
          <%= t("partner_dashboard.copy_link", default: "Copy link") %>
        </button>
      </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="flex items-center justify-between gap-3">
        <div class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= t("partner_dashboard.request_status", default: "Request status") %></div>
        <% if @current_request.present? %>
          <%= render "dashboard/shared/badge",
                     label: t("partner_dashboard.notification_states.#{@current_request.notification_status}", default: @current_request.notification_status.humanize),
                     padding_class: "px-2 py-1",
                     class_name: partner_request_badge_class(@current_request) %>
        <% end %>
      </div>

      <div class="mt-4">
        <div class="mb-2 flex items-center justify-between text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">
          <span><%= t("partner_dashboard.threshold_progress", default: "Threshold progress") %></span>
          <span><%= number_to_currency(@metrics[:requestable_cents].to_i / 100.0) %> / <%= number_to_currency(@partner_dashboard.payout_target_cents / 100.0) %></span>
        </div>
        <div class="h-2 rounded-full bg-gray-200 dark:bg-gray-700">
          <div class="h-2 rounded-full bg-emerald-500" style="width: <%= [(@metrics[:requestable_cents].to_f / @partner_dashboard.payout_target_cents) * 100, 100].min.round(1) %>%"></div>
        </div>
      </div>

      <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= @partner_dashboard.payout_status_message %></p>

      <% if @current_request.present? %>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.request_id", default: "Request ID") %></dt>
            <dd class="font-semibold text-gray-900 dark:text-gray-100">#<%= @current_request.id %></dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.requested_at", default: "Requested at") %></dt>
            <dd class="font-semibold text-gray-900 dark:text-gray-100"><%= l((@current_request.requested_at || @current_request.created_at), format: :short) %></dd>
          </div>
          <% if @current_request.notification_failed_at.present? %>
            <div class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200">
              <%= t("partner_dashboard.notification_failed_copy", default: "The admin notification failed. Reload and use the button again to retry.") %>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>
  </div>
</div>

<!-- Direct referrals -->
<div class="mt-6 rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
  <div class="flex flex-col gap-3 border-b border-gray-200 px-5 py-4 dark:border-gray-700 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <div class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= t("partner_dashboard.invited_users", default: "Direct referrals") %></div>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.invited_users_copy", default: "Paginated direct referrals, searchable by email.") %></p>
    </div>
    <%= form_with url: dashboard_partner_path, method: :get, local: true, class: "w-full lg:w-auto" do |f| %>
      <div class="flex flex-col gap-2 sm:flex-row">
        <%= f.text_field :q, value: params[:q], placeholder: t("partner_dashboard.search_placeholder", default: "Search email"), class: "form-input w-full sm:w-72" %>
        <%= f.submit t("partner_dashboard.search", default: "Search"), class: "btn bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white" %>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full text-sm text-gray-800 dark:text-gray-100">
      <%= render "dashboard/shared/table_head", class_name: "text-left" do %>
        <tr>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.email", default: "Email") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.user", default: "User") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.referred_at", default: "Referred") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.subscription", default: "Subscription") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.locale", default: "Locale") %></th>
        </tr>
      <% end %>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @direct_referrals.each do |direct_referral| %>
          <% referral_record = @direct_referral_records[direct_referral.id] %>
          <tr>
            <td class="px-5 py-3 whitespace-nowrap font-medium text-gray-900 dark:text-gray-100"><%= direct_referral.email %></td>
            <td class="px-5 py-3 whitespace-nowrap"><%= direct_referral.name.presence || t("partner_dashboard.unknown", default: "Unknown") %></td>
            <td class="px-5 py-3 whitespace-nowrap"><%= referral_record ? l(referral_record.created_at.to_date) : "—" %></td>
            <td class="px-5 py-3 whitespace-nowrap">
              <% if active_subscription_for?(direct_referral, @active_subscription_user_ids) %>
                <%= render "dashboard/shared/badge",
                           label: t("partner_dashboard.subscribed", default: "Subscribed"),
                           padding_class: "px-2 py-1",
                           class_name: "bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-100" %>
              <% else %>
                <%= render "dashboard/shared/badge",
                           label: t("partner_dashboard.not_subscribed", default: "Not subscribed"),
                           padding_class: "px-2 py-1",
                           class_name: "bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-100" %>
              <% end %>
            </td>
            <td class="px-5 py-3 whitespace-nowrap uppercase text-gray-500 dark:text-gray-400"><%= direct_referral.preferred_locale_code %></td>
          </tr>
        <% end %>
        <% if @direct_referrals.empty? %>
          <tr>
            <td colspan="5" class="px-5 py-6 text-center text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.no_invites", default: "No direct referrals yet.") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="border-t border-gray-200 px-5 py-4 dark:border-gray-700">
      <%= pagy_mosaic_nav(@pagy) %>
    </div>
  <% end %>
</div>

<!-- Revenue table -->
<div class="mt-6 rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
  <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-700">
    <div class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= t("partner_dashboard.revenue", default: "Commission log") %></div>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.revenue_copy", default: "Recent direct-referral commissions and payout status.") %></p>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm text-gray-800 dark:text-gray-100">
      <%= render "dashboard/shared/table_head", class_name: "text-left" do %>
        <tr>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.date", default: "Date") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.user", default: "User") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.plan", default: "Plan") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.amount", default: "Amount") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.status", default: "Status") %></th>
          <th class="px-5 py-3 font-semibold"><%= t("partner_dashboard.kind", default: "Kind") %></th>
        </tr>
      <% end %>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @commissions.each do |commission| %>
          <% badge_class = case commission.status
                          when "paid" then "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-100"
                          when "requested" then "bg-blue-100 text-blue-700 dark:bg-blue-500/20 dark:text-blue-100"
                          else "bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-100"
                          end %>
          <tr>
            <td class="px-5 py-3 whitespace-nowrap"><%= l(commission.occurred_at.to_date) %></td>
            <td class="px-5 py-3 whitespace-nowrap"><%= commission.referred_user.email %></td>
            <td class="px-5 py-3 whitespace-nowrap"><%= commission.pay_subscription&.processor_plan || t("partner_dashboard.unknown", default: "Unknown") %></td>
            <td class="px-5 py-3 whitespace-nowrap font-semibold"><%= number_to_currency(commission.amount_cents / 100.0) %></td>
            <td class="px-5 py-3 whitespace-nowrap">
              <%= render "dashboard/shared/badge",
                         label: t("partner_dashboard.commission_states.#{commission.status}", default: commission.status.humanize),
                         padding_class: "px-2 py-1",
                         class_name: badge_class %>
            </td>
            <td class="px-5 py-3 whitespace-nowrap"><%= t("partner_dashboard.commission_kinds.#{commission.commission_kind}", default: commission.commission_kind.humanize) %></td>
          </tr>
        <% end %>
        <% if @commissions.empty? %>
          <tr>
            <td colspan="6" class="px-5 py-6 text-center text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.no_commissions", default: "No commissions yet.") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
