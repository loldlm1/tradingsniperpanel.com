<% content_for :title, "#{t('partner_dashboard.title', default: 'Partner Dashboard')} | #{app_short_name}" %>

<div class="space-y-6">
  <%= render "dashboard/partner/hero" %>

  <div class="grid grid-cols-12 gap-6">
    <div class="order-2 col-span-full space-y-6 md:order-1 xl:col-span-8">
      <%= render "dashboard/partner/chart_card",
                 chart_data: @chart_data,
                 chart_summary: @chart_summary %>

      <div class="grid gap-4 md:grid-cols-2">
        <% @highlight_metrics.each do |metric| %>
          <%= render partial: "dashboard/partner/stat_card",
                     locals: {
                       label: metric[:label],
                       amount_cents: 0,
                       value: metric[:value],
                       tone: metric[:tone]
                     } %>
        <% end %>
      </div>
    </div>

    <div class="order-1 col-span-full space-y-6 md:order-2 xl:col-span-4">
      <%= render "dashboard/partner/referral_hub_card",
                 partner_dashboard: @partner_dashboard,
                 profile: @profile %>
      <%= render "dashboard/partner/payout_action_card",
                 partner_dashboard: @partner_dashboard,
                 metrics: @metrics,
                 current_request: @current_request %>
      <%= render "dashboard/partner/program_snapshot_card",
                 partner_dashboard: @partner_dashboard,
                 metrics: @metrics %>
      <%= render "dashboard/partner/request_health_card",
                 current_request: @current_request,
                 recent_payout_requests: @recent_payout_requests %>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-full xl:col-span-8">
      <%= render "dashboard/partner/referrals_section",
                 pagy: @pagy,
                 direct_referrals: @direct_referrals,
                 direct_referral_records: @direct_referral_records,
                 active_subscription_user_ids: @active_subscription_user_ids %>
    </div>
    <div class="col-span-full xl:col-span-4">
      <%= render "dashboard/partner/payout_history_section",
                 recent_payout_requests: @recent_payout_requests %>
    </div>
  </div>
</div>
