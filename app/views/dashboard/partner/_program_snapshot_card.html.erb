<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl">
  <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.network") %></p>
      <h2 class="mt-2 text-lg font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.program_snapshot") %></h2>
    </div>
    <span class="inline-flex items-center rounded-full bg-brand-500/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-brand-600 dark:bg-brand-500/20 dark:text-brand-300">
      <%= t("partner_dashboard.network_badge") %>
    </span>
  </div>

  <div class="p-5 space-y-5">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.discount_percent") %></div>
        <div class="mt-2 text-xl font-semibold text-gray-800 dark:text-gray-100"><%= partner_dashboard.discount_percent %>%</div>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.commission_percent") %></div>
        <div class="mt-2 text-xl font-semibold text-gray-800 dark:text-gray-100"><%= partner_dashboard.commission_percent %>%</div>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.direct_referrals") %></div>
        <div class="mt-2 text-xl font-semibold text-gray-800 dark:text-gray-100"><%= metrics[:direct_referrals_count] %></div>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-4 shadow-xs">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.subscribers") %></div>
        <div class="mt-2 text-xl font-semibold text-gray-800 dark:text-gray-100"><%= metrics[:subscribers_count] %></div>
      </div>
    </div>

    <div class="rounded-lg border border-transparent bg-linear-to-r from-brand-500/[0.12] to-brand-500/[0.04] px-4 py-4 dark:from-brand-500/[0.24] dark:bg-gray-900/30">
      <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-300"><%= t("partner_dashboard.current_month") %></div>
      <div class="mt-2 text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= number_to_currency(metrics[:current_month_cents].to_i / 100.0) %></div>
    </div>
  </div>
</div>
