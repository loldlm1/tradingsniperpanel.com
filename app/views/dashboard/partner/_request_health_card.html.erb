<% latest_request = current_request || recent_payout_requests.first %>

<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl">
  <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60 flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.request_health_label") %></p>
      <h2 class="mt-2 text-lg font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.request_health_title") %></h2>
    </div>
    <% if latest_request.present? %>
      <%= render "dashboard/shared/badge",
                 label: payout_request_status_label(latest_request),
                 padding_class: "px-2.5 py-1",
                 class_name: payout_request_status_badge_class(latest_request) %>
    <% end %>
  </div>

  <div class="p-5">
    <% if latest_request.present? %>
      <p class="text-sm leading-6 text-gray-500 dark:text-gray-400">
        <%= current_request.present? ? t("partner_dashboard.request_health_pending_copy") : t("partner_dashboard.request_health_latest_copy") %>
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        <%= render "dashboard/shared/badge",
                   label: payout_request_notification_label(latest_request),
                   padding_class: "px-2.5 py-1",
                   class_name: payout_request_notification_badge_class(latest_request) %>
        <% if latest_request.notification_failed_at.present? %>
          <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200">
            <%= t("partner_dashboard.action_required") %>
          </span>
        <% end %>
      </div>

      <dl class="mt-5 space-y-3 text-sm">
        <div class="flex items-center justify-between gap-4">
          <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.request_id") %></dt>
          <dd class="font-semibold text-gray-800 dark:text-gray-100">#<%= latest_request.id %></dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.requested_at") %></dt>
          <dd class="font-semibold text-gray-800 dark:text-gray-100"><%= l((latest_request.requested_at || latest_request.created_at), format: :short) %></dd>
        </div>
        <% if latest_request.paid_at.present? %>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.paid_at") %></dt>
            <dd class="font-semibold text-gray-800 dark:text-gray-100"><%= l(latest_request.paid_at, format: :short) %></dd>
          </div>
        <% end %>
        <% if latest_request.payment_reference.present? %>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.payment_reference") %></dt>
            <dd class="truncate font-semibold text-gray-800 dark:text-gray-100"><%= latest_request.payment_reference %></dd>
          </div>
        <% end %>
      </dl>

      <% if latest_request.notification_failed_at.present? %>
        <div class="mt-5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm leading-6 text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200">
          <%= t("partner_dashboard.notification_failed_copy") %>
        </div>
      <% elsif latest_request.note.present? %>
        <div class="mt-5 rounded-lg border border-gray-200 dark:border-gray-700/60 bg-gray-50 dark:bg-gray-900/30 px-4 py-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
          <strong class="font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.note") %>:</strong>
          <%= latest_request.note %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm leading-6 text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.request_health_empty_copy") %></p>

      <div class="mt-5 rounded-lg border border-dashed border-gray-200 dark:border-gray-700/60 bg-gray-50 dark:bg-gray-900/30 px-4 py-4">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.how_payouts_work") %></div>
        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("partner_dashboard.request_health_empty_tip") %></p>
      </div>
    <% end %>
  </div>
</div>
