<div class="rounded-[2rem] border border-slate-200/80 bg-white/95 shadow-sm shadow-slate-200/70 dark:border-slate-700/70 dark:bg-slate-800/95 dark:shadow-none">
  <div class="border-b border-slate-200/80 px-5 py-5 dark:border-slate-700/70 sm:px-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="text-sm font-semibold text-slate-950 dark:text-white"><%= t("partner_dashboard.invited_users") %></div>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= t("partner_dashboard.invited_users_copy") %></p>
        <p class="mt-2 text-xs font-medium uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
          <% if params[:q].present? %>
            <%= t("partner_dashboard.filtered_results_count", count: pagy.count, query: params[:q]) %>
          <% else %>
            <%= t("partner_dashboard.referrals_total_count", count: pagy.count) %>
          <% end %>
        </p>
      </div>

      <%= form_with url: dashboard_partner_path, method: :get, local: true, class: "w-full lg:w-auto" do |f| %>
        <div class="flex flex-col gap-2 sm:flex-row">
          <%= f.text_field :q, value: params[:q], placeholder: t("partner_dashboard.search_placeholder"), class: "form-input w-full sm:w-72" %>
          <%= f.submit t("partner_dashboard.search"), class: "btn bg-slate-900 text-white hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white whitespace-nowrap" %>
          <% if params[:q].present? %>
            <%= link_to t("partner_dashboard.clear_search"), dashboard_partner_path, class: "btn border border-slate-200 bg-white text-slate-700 hover:border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 whitespace-nowrap" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="md:hidden">
    <% if direct_referrals.any? %>
      <div class="divide-y divide-slate-200/80 dark:divide-slate-700/70">
        <% direct_referrals.each do |direct_referral| %>
          <% referral_record = direct_referral_records[direct_referral.id] %>
          <div class="px-5 py-4 sm:px-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="truncate font-semibold text-slate-950 dark:text-white"><%= direct_referral.email %></div>
                <div class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= direct_referral.name.presence || t("partner_dashboard.unknown") %></div>
              </div>
              <div class="shrink-0">
                <% if active_subscription_for?(direct_referral, active_subscription_user_ids) %>
                  <%= render "dashboard/shared/badge",
                             label: t("partner_dashboard.subscribed"),
                             padding_class: "px-2 py-1",
                             class_name: "bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-100" %>
                <% else %>
                  <%= render "dashboard/shared/badge",
                             label: t("partner_dashboard.not_subscribed"),
                             padding_class: "px-2 py-1",
                             class_name: "bg-slate-100 text-slate-700 dark:bg-slate-700/60 dark:text-slate-100" %>
                <% end %>
              </div>
            </div>

            <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
              <div>
                <dt class="text-slate-500 dark:text-slate-400"><%= t("partner_dashboard.referred_at") %></dt>
                <dd class="mt-1 font-medium text-slate-950 dark:text-white"><%= referral_record ? l(referral_record.created_at.to_date) : "—" %></dd>
              </div>
              <div>
                <dt class="text-slate-500 dark:text-slate-400"><%= t("partner_dashboard.locale") %></dt>
                <dd class="mt-1 font-medium uppercase text-slate-950 dark:text-white"><%= direct_referral.preferred_locale_code %></dd>
              </div>
            </dl>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-10 text-center text-sm text-slate-500 dark:text-slate-400 sm:px-6"><%= t("partner_dashboard.no_invites") %></div>
    <% end %>
  </div>

  <div class="hidden overflow-x-auto md:block">
    <table class="min-w-full text-sm text-slate-800 dark:text-slate-100">
      <%= render "dashboard/shared/table_head", class_name: "text-left" do %>
        <tr>
          <th class="px-5 py-3 font-semibold sm:px-6"><%= t("partner_dashboard.email") %></th>
          <th class="px-5 py-3 font-semibold sm:px-6"><%= t("partner_dashboard.referred_at") %></th>
          <th class="px-5 py-3 font-semibold sm:px-6"><%= t("partner_dashboard.subscription") %></th>
          <th class="px-5 py-3 font-semibold sm:px-6"><%= t("partner_dashboard.locale") %></th>
        </tr>
      <% end %>
      <tbody class="divide-y divide-slate-200/80 dark:divide-slate-700/70">
        <% direct_referrals.each do |direct_referral| %>
          <% referral_record = direct_referral_records[direct_referral.id] %>
          <tr>
            <td class="px-5 py-4 sm:px-6">
              <div class="font-medium text-slate-950 dark:text-white"><%= direct_referral.email %></div>
              <div class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= direct_referral.name.presence || t("partner_dashboard.unknown") %></div>
            </td>
            <td class="px-5 py-4 whitespace-nowrap text-slate-600 dark:text-slate-300 sm:px-6"><%= referral_record ? l(referral_record.created_at.to_date) : "—" %></td>
            <td class="px-5 py-4 whitespace-nowrap sm:px-6">
              <% if active_subscription_for?(direct_referral, active_subscription_user_ids) %>
                <%= render "dashboard/shared/badge",
                           label: t("partner_dashboard.subscribed"),
                           padding_class: "px-2 py-1",
                           class_name: "bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-100" %>
              <% else %>
                <%= render "dashboard/shared/badge",
                           label: t("partner_dashboard.not_subscribed"),
                           padding_class: "px-2 py-1",
                           class_name: "bg-slate-100 text-slate-700 dark:bg-slate-700/60 dark:text-slate-100" %>
              <% end %>
            </td>
            <td class="px-5 py-4 whitespace-nowrap uppercase text-slate-500 dark:text-slate-400 sm:px-6"><%= direct_referral.preferred_locale_code %></td>
          </tr>
        <% end %>
        <% if direct_referrals.empty? %>
          <tr>
            <td colspan="4" class="px-5 py-10 text-center text-slate-500 dark:text-slate-400 sm:px-6"><%= t("partner_dashboard.no_invites") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if pagy.pages > 1 %>
    <div class="border-t border-slate-200/80 px-5 py-4 dark:border-slate-700/70 sm:px-6">
      <%= pagy_mosaic_nav(pagy) %>
    </div>
  <% end %>
</div>
