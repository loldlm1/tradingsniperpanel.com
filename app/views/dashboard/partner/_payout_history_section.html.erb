<div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl">
  <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60">
    <h2 class="font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.payout_history") %></h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.payout_history_copy") %></p>
  </div>

  <% if recent_payout_requests.any? %>
    <div class="divide-y divide-gray-100 dark:divide-gray-700/60">
      <% recent_payout_requests.each do |request| %>
        <article class="p-5">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"><%= t("partner_dashboard.request_label", id: request.id) %></div>
              <div class="mt-2 text-2xl font-semibold text-gray-800 dark:text-gray-100"><%= number_to_currency(request.total_cents.to_i / 100.0) %></div>
              <div class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.requested_at") %>: <%= l((request.requested_at || request.created_at), format: :short) %></div>
            </div>

            <div class="flex flex-wrap gap-2">
              <%= render "dashboard/shared/badge",
                         label: payout_request_status_label(request),
                         padding_class: "px-2.5 py-1",
                         class_name: payout_request_status_badge_class(request) %>
              <%= render "dashboard/shared/badge",
                         label: payout_request_notification_label(request),
                         padding_class: "px-2.5 py-1",
                         class_name: payout_request_notification_badge_class(request) %>
            </div>
          </div>

          <dl class="mt-4 grid gap-3 text-sm md:grid-cols-2">
            <div>
              <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.request_status") %></dt>
              <dd class="mt-1 font-medium text-gray-800 dark:text-gray-100"><%= payout_request_status_label(request) %></dd>
            </div>
            <div>
              <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.notification_status") %></dt>
              <dd class="mt-1 font-medium text-gray-800 dark:text-gray-100"><%= payout_request_notification_label(request) %></dd>
            </div>
            <% if request.paid_at.present? %>
              <div>
                <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.paid_at") %></dt>
                <dd class="mt-1 font-medium text-gray-800 dark:text-gray-100"><%= l(request.paid_at, format: :short) %></dd>
              </div>
            <% end %>
            <% if request.payment_reference.present? %>
              <div>
                <dt class="text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.payment_reference") %></dt>
                <dd class="mt-1 break-all font-medium text-gray-800 dark:text-gray-100"><%= request.payment_reference %></dd>
              </div>
            <% end %>
          </dl>

          <% if request.notification_failed_at.present? %>
            <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm leading-6 text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200">
              <%= request.notification_failure_message.presence || t("partner_dashboard.notification_failed_copy") %>
            </div>
          <% elsif request.note.present? %>
            <div class="mt-4 rounded-lg border border-gray-200 dark:border-gray-700/60 bg-gray-50 dark:bg-gray-900/30 px-4 py-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
              <strong class="font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.note") %>:</strong>
              <%= request.note %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="px-5 py-10 text-center">
      <div class="mx-auto max-w-sm rounded-lg border border-dashed border-gray-200 dark:border-gray-700/60 bg-gray-50 dark:bg-gray-900/30 px-5 py-6">
        <div class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t("partner_dashboard.no_payout_history_title") %></div>
        <p class="mt-2 text-sm leading-6 text-gray-500 dark:text-gray-400"><%= t("partner_dashboard.no_payout_history_copy") %></p>
      </div>
    </div>
  <% end %>
</div>
